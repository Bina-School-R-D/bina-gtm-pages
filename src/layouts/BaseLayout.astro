---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Set true for internal / sales-enablement pages that must stay out of Google. */
  noindex?: boolean;
  /** Optional CTA shown on the right of the nav. Defaults to the main-site apply link. */
  ctaHref?: string;
  ctaLabel?: string;
  /** Drop the gap above the footer, for pages whose last section is already dark. */
  flushFooter?: boolean;
}

const {
  title,
  description,
  noindex = false,
  ctaHref = 'https://thebinaschool.com',
  ctaLabel = 'Visit bina',
  flushFooter = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/png" href="/images/favicon.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <nav class="sticky top-0 z-50 flex h-20 items-center justify-between bg-coal-black px-5 sm:px-10">
      <a href="https://thebinaschool.com" aria-label="bina — home">
        <img src="/images/navbar-logo.svg" alt="bina" class="h-9 w-auto" />
      </a>
      <a
        href={ctaHref}
        class="inline-flex min-h-[clamp(2.75rem,3.24vw,4.25rem)] cursor-pointer items-center justify-center whitespace-nowrap rounded-[clamp(0.625rem,0.83vw,1rem)] border-2 border-coal-black bg-bina-yellow px-[clamp(1.25rem,1.6vw,2rem)] font-display text-[clamp(1rem,1.22vw,1.5rem)] font-bold text-coal-black no-underline transition-colors duration-300 ease-out hover:bg-bina-pink active:bg-bina-red"
        >{ctaLabel}</a
      >
    </nav>

    <main>
      <slot />
    </main>

    <footer
      class:list={['bg-coal-black px-5 py-12 text-white sm:px-10', flushFooter ? 'mt-0' : 'mt-20']}
    >
      <div class="mx-auto flex max-w-4xl flex-col items-center gap-4 text-center">
        <p class="text-sm text-white/80">
          <a href="https://thebinaschool.com/privacy" class="font-bold text-bina-grass underline underline-offset-4">Privacy</a>
          ·
          <a href="https://thebinaschool.com/legal" class="font-bold text-bina-grass underline underline-offset-4">Terms &amp; Conditions</a>
        </p>
        <slot name="footer-note" />
      </div>
    </footer>

    <script>
      /* Partner attribution, mirroring the snippet installed on thebinaschool.com: keep any
         ?ref= for a year and append it to every form.thebinaschool.com link. localStorage is
         per-origin, so this only carries a ref that arrived on go.bina.school itself. */
      (function () {
        var KEY = 'bina_ref';
        var KEY_TS = 'bina_ref_ts';
        var MAX_DAYS = 365;
        try {
          var fromUrl = new URLSearchParams(window.location.search).get('ref');
          if (fromUrl) {
            localStorage.setItem(KEY, fromUrl);
            localStorage.setItem(KEY_TS, String(Date.now()));
          }
          var stored = localStorage.getItem(KEY);
          var ts = localStorage.getItem(KEY_TS);
          if (stored && ts && (Date.now() - parseInt(ts, 10)) / 86400000 > MAX_DAYS) {
            localStorage.removeItem(KEY);
            localStorage.removeItem(KEY_TS);
            stored = null;
          }
          if (!stored) return;
          document.addEventListener(
            'click',
            function (e) {
              var link = e.target instanceof Element ? e.target.closest('a') : null;
              if (!link) return;
              var href = link.getAttribute('href') || '';
              if (href.indexOf('form.thebinaschool.com') === -1 || href.indexOf('ref=') !== -1)
                return;
              link.setAttribute(
                'href',
                href + (href.indexOf('?') === -1 ? '?' : '&') + 'ref=' + encodeURIComponent(stored)
              );
            },
            true
          );
        } catch (err) {
          /* private mode / storage disabled — attribution is best-effort, never blocking */
        }
      })();
    </script>
  </body>
</html>
