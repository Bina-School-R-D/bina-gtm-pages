---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Set true for internal / sales-enablement pages that must stay out of Google. */
  noindex?: boolean;
  /** Optional CTA shown on the right of the nav. Defaults to the main-site apply link. */
  ctaHref?: string;
  ctaLabel?: string;
  /** Drop the gap above the footer, for pages whose last section is already dark. */
  flushFooter?: boolean;
}

const {
  title,
  description,
  noindex = false,
  ctaHref = 'https://thebinaschool.com',
  ctaLabel = 'Visit bina',
  flushFooter = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/png" href="/images/favicon.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="generator" content={Astro.generator} />

    <!-- Tracking parity with thebinaschool.com: same GTM container (CookieYes CMP + GA4
         live inside it), a dedicated PostHog project for go.bina.school (session replay
         enabled), same first-touch attribution file. Both
         tags use the main site's deferred loader — they load after full page load + idle,
         or on first interaction, whichever comes first — so the consent banner never
         lands on the LCP critical path. Host-gated to bina domains so previews and local
         dev stay out of the metrics. Keep in sync with the main site's snippet. -->
    <script is:inline>
      (function (w, d, s, l, i) {
        if (/HeadlessChrome|ReactSnap/i.test(navigator.userAgent || '')) return;
        if (!/(^|\.)(thebinaschool\.com|bina\.school)$/.test((w.location || {}).hostname || '')) return;
        var loaded = false;
        function loadGtm() {
          if (loaded) return;
          loaded = true;
          w[l] = w[l] || [];
          w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
          var f = d.getElementsByTagName(s)[0],
            j = d.createElement(s),
            dl = l != 'dataLayer' ? '&l=' + l : '';
          j.async = true;
          j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
          f.parentNode.insertBefore(j, f);
          ['pointerdown', 'touchstart', 'keydown', 'scroll'].forEach(function (t) {
            w.removeEventListener(t, loadGtm);
          });
        }
        ['pointerdown', 'touchstart', 'keydown', 'scroll'].forEach(function (t) {
          w.addEventListener(t, loadGtm, { once: true, passive: true });
        });
        // Fixed post-load delay, not requestIdleCallback (rIC on a settled page can wait
        // for the next real interaction, which may never come on a one-screen visit).
        if (d.readyState === 'complete') w.setTimeout(loadGtm, 5000);
        else w.addEventListener('load', function () { w.setTimeout(loadGtm, 5000); }, { once: true });
      })(window, document, 'script', 'dataLayer', 'GTM-M2HWS5K');
    </script>

    <script is:inline>
      /* PostHog — dedicated project for go.bina.school (us.posthog.com project 578193),
         separate from the main site's project so this domain's traffic and session
         replays can be watched on their own. Replay, console-log and performance
         capture are enabled server-side in the project, so array.js starts recording
         on its own once loaded. Loaded EAGERLY, unlike GTM — a deliberate break from
         the main site's deferred loader (Akis, 2026-08-26) so every visit gets a
         replay, including sub-5s bounces the deferred loader would miss. The script
         itself is async, so it stays off the parser's critical path. */
      (function () {
        if (/HeadlessChrome|ReactSnap/i.test(navigator.userAgent || '')) return;
        if (!/(^|\.)(thebinaschool\.com|bina\.school)$/.test(window.location.hostname || '')) return;
        !(function (t, e) {
            var o, n, p, r;
            e.__SV ||
              ((window.posthog = e),
              (e._i = []),
              (e.init = function (i, s, a) {
                function g(t, e) {
                  var o = e.split('.');
                  2 == o.length && ((t = t[o[0]]), (e = o[1]));
                  t[e] = function () {
                    t.push([e].concat(Array.prototype.slice.call(arguments, 0)));
                  };
                }
                ((p = t.createElement('script')).type = 'text/javascript'),
                  (p.crossOrigin = 'anonymous'),
                  (p.async = !0),
                  (p.src = 'https://us-assets.i.posthog.com/static/array.js'),
                  (r = t.getElementsByTagName('script')[0]).parentNode.insertBefore(p, r);
                var u = e;
                for (
                  void 0 !== a ? (u = e[a] = []) : (a = 'posthog'),
                    u.people = u.people || [],
                    u.toString = function (t) {
                      var e = 'posthog';
                      return 'posthog' !== a && (e += '.' + a), t || (e += ' (stub)'), e;
                    },
                    u.people.toString = function () {
                      return u.toString(1) + '.people (stub)';
                    },
                    o =
                      'init capture register register_once register_for_session unregister unregister_for_session getFeatureFlag getFeatureFlagPayload isFeatureEnabled reloadFeatureFlags updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures on onFeatureFlags onSessionId getSurveys getActiveMatchingSurveys renderSurvey canRenderSurvey identify setPersonProperties group resetGroups setPersonPropertiesForFlags resetPersonPropertiesForFlags setGroupPropertiesForFlags resetGroupPropertiesForFlags reset get_distinct_id getGroups get_session_id get_session_replay_url alias set_config startSessionRecording stopSessionRecording sessionRecordingStarted captureException loadToolbar get_property getSessionProperty createPersonProfile opt_in_capturing opt_out_capturing has_opted_in_capturing has_opted_out_capturing clear_opt_in_out_capturing debug'.split(
                        ' '
                      ),
                    n = 0;
                  n < o.length;
                  n++
                )
                  g(u, o[n]);
                e._i.push([i, s, a]);
              }),
              (e.__SV = 1));
          })(document, window.posthog || []);
          window.posthog.init('phc_D4SErijz7JBzQTuzsJGdYQcKUB3LZxZoqBsBJSn8TQH4', {
            api_host: 'https://us.i.posthog.com',
            defaults: '2026-01-30',
          });
      })();
    </script>

    <!-- First-touch attribution — a port of thebinaschool.com/attribution.js. Carries
         utm_*, gclid and the partner ?ref= onto every form.thebinaschool.com CTA. -->
    <script is:inline defer src="/attribution.js"></script>
  </head>
  <body>
    <nav class="sticky top-0 z-50 flex h-20 items-center justify-between bg-coal-black px-5 sm:px-10">
      <a href="https://thebinaschool.com" aria-label="bina — home">
        <img src="/images/navbar-logo.svg" alt="bina" class="h-9 w-auto" />
      </a>
      <a
        href={ctaHref}
        class="inline-flex min-h-[clamp(2.75rem,3.24vw,4.25rem)] cursor-pointer items-center justify-center whitespace-nowrap rounded-[clamp(0.625rem,0.83vw,1rem)] border-2 border-coal-black bg-bina-yellow px-[clamp(1.25rem,1.6vw,2rem)] font-display text-[clamp(1rem,1.22vw,1.5rem)] font-bold text-coal-black no-underline transition-colors duration-300 ease-out hover:bg-bina-pink active:bg-bina-red"
        >{ctaLabel}</a
      >
    </nav>

    <main>
      <slot />
    </main>

    <footer
      class:list={['bg-coal-black px-5 py-12 text-white sm:px-10', flushFooter ? 'mt-0' : 'mt-20']}
    >
      <div class="mx-auto flex max-w-4xl flex-col items-center gap-4 text-center">
        <p class="text-sm text-white/80">
          <a href="https://thebinaschool.com/privacy" class="font-bold text-bina-grass underline underline-offset-4">Privacy</a>
          ·
          <a href="https://thebinaschool.com/legal" class="font-bold text-bina-grass underline underline-offset-4">Terms &amp; Conditions</a>
        </p>
        <slot name="footer-note" />
      </div>
    </footer>

  </body>
</html>
