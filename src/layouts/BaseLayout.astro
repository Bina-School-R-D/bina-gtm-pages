---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Set true for internal / sales-enablement pages that must stay out of Google. */
  noindex?: boolean;
  /** Optional CTA shown on the right of the nav. Defaults to the main-site apply link. */
  ctaHref?: string;
  ctaLabel?: string;
  /** Drop the gap above the footer, for pages whose last section is already dark. */
  flushFooter?: boolean;
}

const {
  title,
  description,
  noindex = false,
  ctaHref = 'https://thebinaschool.com',
  ctaLabel = 'Visit bina',
  flushFooter = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/png" href="/images/favicon.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="generator" content={Astro.generator} />

    <!-- Tracking parity with thebinaschool.com: same GTM container (CookieYes CMP + GA4
         live inside it), a dedicated PostHog project for go.bina.school (session replay
         enabled after analytics consent), same first-touch attribution file. GTM
         uses the main site's deferred loader — they load after full page load + idle,
         or on first interaction, whichever comes first — so the consent banner never
         lands on the LCP critical path. Host-gated to bina domains so previews and local
         dev stay out of the metrics. Keep in sync with the main site's snippet. -->
    <script is:inline>
      (function (w, d, s, l, i) {
        if (/HeadlessChrome|ReactSnap/i.test(navigator.userAgent || '')) return;
        if (!/(^|\.)(thebinaschool\.com|bina\.school)$/.test((w.location || {}).hostname || '')) return;
        var loaded = false;
        function loadGtm() {
          if (loaded) return;
          loaded = true;
          w[l] = w[l] || [];
          w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
          var f = d.getElementsByTagName(s)[0],
            j = d.createElement(s),
            dl = l != 'dataLayer' ? '&l=' + l : '';
          j.async = true;
          j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
          f.parentNode.insertBefore(j, f);
          ['pointerdown', 'touchstart', 'keydown', 'scroll'].forEach(function (t) {
            w.removeEventListener(t, loadGtm);
          });
        }
        ['pointerdown', 'touchstart', 'keydown', 'scroll'].forEach(function (t) {
          w.addEventListener(t, loadGtm, { once: true, passive: true });
        });
        // Fixed post-load delay, not requestIdleCallback (rIC on a settled page can wait
        // for the next real interaction, which may never come on a one-screen visit).
        if (d.readyState === 'complete') w.setTimeout(loadGtm, 5000);
        else w.addEventListener('load', function () { w.setTimeout(loadGtm, 5000); }, { once: true });
      })(window, document, 'script', 'dataLayer', 'GTM-M2HWS5K');
    </script>

    <script is:inline>
      /* Dedicated go PostHog project and existing replay settings. CookieYes in
         shared GTM owns consent; only its resolved analytics boolean grants access. */
      (function () {
        if (/HeadlessChrome|ReactSnap/i.test(navigator.userAgent || '')) return;
        if (!/(^|\.)(thebinaschool\.com|bina\.school)$/.test(window.location.hostname || '')) return;
        var loading = false, sdkReady = false, initialized = false, capturing = false;
        function analyticsAllowed() {
          try {
            var consent = window.getCkyConsent();
            return !!(consent && consent.categories && consent.categories.analytics === true);
          } catch (error) {
            return false;
          }
        }
        function syncConsent() {
          if (!analyticsAllowed()) {
            if (capturing) {
              capturing = false;
              window.posthog.opt_out_capturing();
              window.posthog.stopSessionRecording();
            }
            return;
          }
          if (!sdkReady) {
            if (loading) return;
            loading = true;
            var script = document.createElement('script');
            script.type = 'text/javascript';
            script.crossOrigin = 'anonymous';
            script.async = true;
            script.src = 'https://us-assets.i.posthog.com/static/array.js';
            // Load the real SDK without the snippet's queued init or a second loader.
            // Its unloaded instance has no project until this fresh consent check.
            script.onload = function () {
              loading = false;
              sdkReady = !!(window.posthog && typeof window.posthog.init === 'function');
              if (sdkReady) syncConsent();
            };
            script.onerror = function () { loading = false; script.remove(); };
            var first = document.getElementsByTagName('script')[0];
            first.parentNode.insertBefore(script, first);
            return;
          }
          if (capturing) return;
          if (!initialized) {
            initialized = true;
            window.posthog.init('phc_D4SErijz7JBzQTuzsJGdYQcKUB3LZxZoqBsBJSn8TQH4', {
              api_host: 'https://us.i.posthog.com',
              defaults: '2026-01-30',
            });
          }
          window.posthog.opt_in_capturing();
          window.posthog.startSessionRecording();
          capturing = true;
        }
        document.addEventListener('cookieyes_banner_load', syncConsent);
        document.addEventListener('cookieyes_consent_update', syncConsent);
        syncConsent();
      })();
    </script>

    <!-- First-touch attribution — a port of thebinaschool.com/attribution.js. Carries
         utm_*, gclid and the partner ?ref= onto form CTAs and the HTTPS main-site homepage. -->
    <script is:inline defer src="/attribution.js"></script>
  </head>
  <body>
    <nav class="sticky top-0 z-50 flex h-20 items-center justify-between bg-coal-black px-5 sm:px-10">
      <a href="https://thebinaschool.com" aria-label="bina — home">
        <img src="/images/navbar-logo.svg" alt="bina" class="h-9 w-auto" />
      </a>
      <a
        href={ctaHref}
        class="inline-flex min-h-[clamp(2.75rem,3.24vw,4.25rem)] cursor-pointer items-center justify-center whitespace-nowrap rounded-[clamp(0.625rem,0.83vw,1rem)] border-2 border-coal-black bg-bina-yellow px-[clamp(1.25rem,1.6vw,2rem)] font-display text-[clamp(1rem,1.22vw,1.5rem)] font-bold text-coal-black no-underline transition-colors duration-300 ease-out hover:bg-bina-pink active:bg-bina-red"
        >{ctaLabel}</a
      >
    </nav>

    <main>
      <slot />
    </main>

    <footer
      class:list={['bg-coal-black px-5 py-12 text-white sm:px-10', flushFooter ? 'mt-0' : 'mt-20']}
    >
      <div class="mx-auto flex max-w-4xl flex-col items-center gap-4 text-center">
        <p class="text-sm text-white/80">
          <a href="https://thebinaschool.com/privacy" class="font-bold text-bina-grass underline underline-offset-4">Privacy</a>
          ·
          <a href="https://thebinaschool.com/legal" class="font-bold text-bina-grass underline underline-offset-4">Terms &amp; Conditions</a>
        </p>
        <slot name="footer-note" />
      </div>
    </footer>

  </body>
</html>
