---
import '../styles/global.css';
import BrandText from '../components/BrandText.astro';
import { CTA, CTA_LABEL } from '../lib/esa-states.js';

interface Props {
  title: string;
  description: string;
  /** Set true for internal / sales-enablement pages that must stay out of Google. */
  noindex?: boolean;
  /** Optional CTA shown on the right of the nav. Defaults to "Start your bina journey" → form.thebinaschool.com/new, the main site's header button. */
  ctaHref?: string;
  ctaLabel?: string;
  /** Drop the gap above the footer, for pages whose last section is already dark. */
  flushFooter?: boolean;
  /** Drop the nav and footer entirely — for full-bleed tool pages like /calendar. */
  bare?: boolean;
  /** With `bare`: keep the site footer (and the Follow-us rail) — /calendar, Zeyu 2026-11-10. */
  footer?: boolean;
}

const {
  title,
  description,
  noindex = false,
  ctaHref = CTA,
  ctaLabel = CTA_LABEL,
  flushFooter = false,
  bare = false,
  footer = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);

// Footer links: the grouped ("column") footer built for thebinaschool.com on the stage branch
// edit/zeyu/go-pages-design (Akis asked for grouped columns; not on the main site's production
// yet). Same groups, labels and order; restyled to bina Foundation (Zeyu, 2026-11-06).
// Main-site links are absolute; the go.bina pages stay relative so they follow the pages when
// they move to the main domain.
const M = 'https://thebinaschool.com';
type FooterLink = { label: string; href: string; external?: boolean };
const footerGroups: { title: string; links: FooterLink[] }[] = [
  {
    title: 'School',
    links: [
      { label: 'Education', href: `${M}/education` },
      { label: 'Primary School', href: `${M}/primary-school` },
      { label: 'Middle School', href: `${M}/middle-school` },
      { label: 'Teachers', href: `${M}/teachers` },
    ],
  },
  {
    title: 'Join bina',
    links: [
      { label: 'Admissions', href: `${M}/admissions` },
      { label: 'Tuition', href: `${M}/tuition` },
      { label: 'Open House', href: `${M}/open-house` },
      { label: 'Education Savings Account', href: '/esa' },
    ],
  },
  {
    title: 'Results & reviews',
    links: [
      { label: 'Student results', href: '/student-results' },
      { label: 'Family survey', href: '/family-survey' },
      { label: 'Reviews', href: '/reviews' },
    ],
  },
  {
    title: 'Guides',
    links: [
      { label: 'What type of school is best?', href: `${M}/what-type-of-school-is-best` },
      { label: 'Homeschooling guides — USA', href: `${M}/homeschooling-guides` },
      { label: 'Homeschooling guides — Europe', href: `${M}/homeschooling-guides-europe` },
      { label: 'Blog', href: `${M}/blog` },
    ],
  },
  {
    title: 'About bina',
    links: [
      { label: 'About us', href: `${M}/about` },
      { label: 'Open Positions', href: `${M}/careers` },
      { label: 'Join the bina school partner program', href: 'https://form.thebinaschool.com/new-partner', external: true },
    ],
  },
];
const footerLegalLinks: FooterLink[] = [
  { label: 'Imprint', href: `${M}/imprint` },
  { label: 'Privacy', href: `${M}/privacy` },
  { label: 'Legal', href: `${M}/legal` },
  { label: 'Partner T&Cs', href: `${M}/partner-program-terms` },
];
const socials = [
  { label: 'LinkedIn', icon: 'linkedin', href: 'https://www.linkedin.com/company/thebinaschool' },
  { label: 'YouTube', icon: 'youtube', href: 'https://www.youtube.com/@thebinaschool3759' },
  { label: 'TikTok', icon: 'tiktok', href: 'https://www.tiktok.com/@bina.school' },
  { label: 'Instagram', icon: 'instagram', href: 'https://www.instagram.com/thebinaschool' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/png" href="/images/favicon.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="generator" content={Astro.generator} />

    <!-- Tracking parity with thebinaschool.com: same GTM container (CookieYes CMP + GA4
         live inside it), a dedicated PostHog project for go.bina.school (session replay
         enabled after analytics consent), same first-touch attribution file. GTM
         uses the main site's deferred loader — they load after full page load + idle,
         or on first interaction, whichever comes first — so the consent banner never
         lands on the LCP critical path. Host-gated to bina domains so previews and local
         dev stay out of the metrics. Keep in sync with the main site's snippet.
         GTM loads first-party through Stape Custom Loader (sgtm.thebinaschool.com);
         the last argument is Stape's encoded form of GTM-M2HWS5K, not a GTM ID. -->
    <script is:inline>
      (function (w, d, s, l, i) {
        if (/HeadlessChrome|ReactSnap/i.test(navigator.userAgent || '')) return;
        if (!/(^|\.)(thebinaschool\.com|bina\.school)$/.test((w.location || {}).hostname || '')) return;
        var loaded = false;
        function loadGtm() {
          if (loaded) return;
          loaded = true;
          w[l] = w[l] || [];
          w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
          var f = d.getElementsByTagName(s)[0],
            j = d.createElement(s),
            dl = l != 'dataLayer' ? '&l=' + l : '';
          j.async = true;
          j.src = 'https://sgtm.thebinaschool.com/8bkryjbnrubr.js?' + i;
          f.parentNode.insertBefore(j, f);
          ['pointerdown', 'touchstart', 'keydown', 'scroll'].forEach(function (t) {
            w.removeEventListener(t, loadGtm);
          });
        }
        ['pointerdown', 'touchstart', 'keydown', 'scroll'].forEach(function (t) {
          w.addEventListener(t, loadGtm, { once: true, passive: true });
        });
        // Fixed post-load delay, not requestIdleCallback (rIC on a settled page can wait
        // for the next real interaction, which may never come on a one-screen visit).
        if (d.readyState === 'complete') w.setTimeout(loadGtm, 5000);
        else w.addEventListener('load', function () { w.setTimeout(loadGtm, 5000); }, { once: true });
      })(window, document, 'script', 'dataLayer', '9yb=GwZINTovRzRAKiIhWylMD09QW0NIBgREBgoQEAcMCwoRChodAkwJFh8%3D');
    </script>

    <script is:inline>
      /* Dedicated go PostHog project and existing replay settings. CookieYes in
         shared GTM owns consent; only its resolved analytics boolean grants access. */
      (function () {
        if (/HeadlessChrome|ReactSnap/i.test(navigator.userAgent || '')) return;
        if (!/(^|\.)(thebinaschool\.com|bina\.school)$/.test(window.location.hostname || '')) return;
        var loading = false, sdkReady = false, initialized = false, capturing = false;
        function analyticsAllowed() {
          try {
            var consent = window.getCkyConsent();
            return !!(consent && consent.categories && consent.categories.analytics === true);
          } catch (error) {
            return false;
          }
        }
        function syncConsent() {
          if (!analyticsAllowed()) {
            if (capturing) {
              capturing = false;
              window.posthog.opt_out_capturing();
              window.posthog.stopSessionRecording();
            }
            return;
          }
          if (!sdkReady) {
            if (loading) return;
            loading = true;
            var script = document.createElement('script');
            script.type = 'text/javascript';
            script.crossOrigin = 'anonymous';
            script.async = true;
            script.src = 'https://us-assets.i.posthog.com/static/array.js';
            // Load the real SDK without the snippet's queued init or a second loader.
            // Its unloaded instance has no project until this fresh consent check.
            script.onload = function () {
              loading = false;
              sdkReady = !!(window.posthog && typeof window.posthog.init === 'function');
              if (sdkReady) syncConsent();
            };
            script.onerror = function () { loading = false; script.remove(); };
            var first = document.getElementsByTagName('script')[0];
            first.parentNode.insertBefore(script, first);
            return;
          }
          if (capturing) return;
          if (!initialized) {
            initialized = true;
            window.posthog.init('phc_D4SErijz7JBzQTuzsJGdYQcKUB3LZxZoqBsBJSn8TQH4', {
              api_host: 'https://us.i.posthog.com',
              defaults: '2026-01-30',
            });
          }
          window.posthog.opt_in_capturing();
          window.posthog.startSessionRecording();
          capturing = true;
        }
        document.addEventListener('cookieyes_banner_load', syncConsent);
        document.addEventListener('cookieyes_consent_update', syncConsent);
        syncConsent();
      })();
    </script>

    <!-- First-touch attribution — a port of thebinaschool.com/attribution.js. Carries
         utm_*, gclid, fbclid and the partner ?ref= onto form CTAs, start.bina.school links
         and the HTTPS main-site homepage. -->
    <script is:inline defer src="/attribution.js"></script>
  </head>
  <body>
    {!bare && (
    <nav class="theme-black sticky top-0 z-50 flex h-20 items-center justify-between px-5 sm:px-10">
      <a href="https://thebinaschool.com" aria-label="bina — home">
        <img src="/images/navbar-logo-2026.svg" alt="bina" width="147" height="62" class="h-9 w-auto" />
      </a>
      <a href={ctaHref} class="btn-bina btn-sm">{ctaLabel}</a>
    </nav>
    )}

    <main>
      <slot />
    </main>

    {(!bare || footer) && (
    <!-- Footer (Zeyu, 2026-11-06): the main site's grouped footer — tagline column, one column per
         group (2 on phones, 3 from 640px, tagline + 5 from 1024px), the legal links in one row above
         the peeking logo (no divider line), and the Follow-us rail. Black / mint / lagoon: mint
         tagline, group titles and legal links (the old purple), lagoon group links (the old
         turquoise). -->
    <footer
      class:list={['theme-black relative z-10 overflow-hidden pt-12 md:pt-16', flushFooter ? 'mt-0' : 'mt-20']}
    >
      <div class="px-5 sm:px-10 min-[1120px]:pr-24">
        <div class="mb-10 grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-3 sm:gap-x-8 md:mb-12 lg:grid-cols-[1.4fr_repeat(5,minmax(0,1fr))]">
          <p class="col-span-2 font-display text-title-md font-medium text-mint sm:col-span-3 lg:col-span-1 xl:text-title-lg xl:font-medium">
            A global, mobile, whole schooling experience for 4–15 year olds that fits your family everywhere
          </p>
          {footerGroups.map((g) => (
            <nav aria-label={g.title}>
              <h2 class="mb-4 font-display text-label uppercase text-mint"><BrandText text={g.title} /></h2>
              <ul class="flex flex-col gap-3">
                {g.links.map((l) => (
                  <li>
                    <a
                      href={l.href}
                      {...(l.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                      class="footer-link font-display text-body-lg font-semibold text-lagoon xl:text-body-xl"
                    >{l.label}</a>
                  </li>
                ))}
              </ul>
            </nav>
          ))}
        </div>
        <ul class="mb-8 flex flex-wrap gap-x-6 gap-y-2 md:mb-10">
          {footerLegalLinks.map((l) => (
            <li>
              <a href={l.href} class="footer-link font-display text-body-lg font-semibold text-mint xl:text-body-xl">{l.label}</a>
            </li>
          ))}
        </ul>
        {Astro.slots.has('footer-note') && <div class="mb-8 md:mb-10"><slot name="footer-note" /></div>}
      </div>
      <img src="/images/peeking-logo.svg" decoding="async" alt="bina" width="440" height="125" class="block h-auto w-full" />
    </footer>

    <!-- Right-edge "Follow us" rail, tablet and up — same as the main site, on lagoon. -->
    <aside
      aria-label="Follow us on social media"
      class="fixed bottom-[10%] right-0 z-[900] hidden flex-col items-center gap-[1.1rem] rounded-l-lg bg-lagoon px-[0.7rem] py-5 min-[1120px]:flex"
    >
      {socials.map((s) => (
        <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label} class="block transition-transform duration-200 ease-out hover:scale-110">
          <img src={`/images/social/${s.icon}.svg`} alt="" aria-hidden="true" width="26" height="26" class="h-[1.6rem] w-[1.6rem] object-contain" />
        </a>
      ))}
      <span class="mt-1 rotate-180 font-display text-body-md leading-none text-black [writing-mode:vertical-rl]">Follow us</span>
    </aside>
    )}

  </body>
</html>
