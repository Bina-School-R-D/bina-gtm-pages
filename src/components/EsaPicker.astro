---
/*
 * The state picker. Every option carries its own static URL, so choosing a state is a
 * navigation, not a client-side swap behind ?state= — each state is a real page Google
 * can crawl and rank on its own. See CLAUDE.md, "Indexable variants are static pages".
 */
import { stateNames, stateSlug } from '../lib/esa-states.js';

interface Props {
  /** State name to pre-select, on a /esa/<state> page. */
  selected?: string;
}

const { selected } = Astro.props;
---

<section class="border-t-2 border-coal-black">
  <div class="mx-auto max-w-4xl px-5 py-14">
    <p class="mb-2 font-display text-sm font-bold uppercase tracking-widest text-bina-pink">Your state</p>
    <h2 class="mb-3 text-3xl sm:text-4xl">See your state's exact steps</h2>
    <p class="mb-8 max-w-2xl text-coal-900">
      Every state runs its own program — different money, different deadlines, different rules.
      Pick yours and we'll show you the whole path, tailored to bina.
    </p>

    <div class="card-bina p-6 sm:p-8">
      <p class="mb-4 text-sm text-coal-900">
        Every state is listed — including the ones with no program yet, so you get a straight
        answer either way. New programs launch most years, so it's worth checking back.
      </p>
      <label for="state" class="mb-3 block font-display text-lg font-bold">Which state do you live in?</label>
      <div class="relative">
        <select
          id="state"
          aria-label="Select your state"
          class="w-full cursor-pointer appearance-none rounded-2xl border-2 border-coal-black bg-white px-4 py-4 font-display text-lg font-bold focus-visible:outline-4 focus-visible:outline-bina-pink"
        >
          <option value="">Select your state…</option>
          {
            stateNames.map((name) => (
              <option value={`/esa/${stateSlug(name)}`} selected={name === selected}>
                {name}
              </option>
            ))
          }
        </select>
        <span class="pointer-events-none absolute right-5 top-1/2 h-3 w-3 -translate-y-[70%] rotate-45 border-b-2 border-r-2 border-coal-black"></span>
      </div>
      <slot />
    </div>
  </div>
</section>

<script is:inline>
  // Choosing a state goes to that state's page. The option value is already the URL.
  (function () {
    var sel = document.getElementById('state');
    if (!sel) return;
    sel.addEventListener('change', function () {
      if (!this.value) return;
      var target = new URL(this.value, location.origin);
      target.search = location.search;
      target.searchParams.delete('state');
      target.hash = location.hash;
      location.assign(target.pathname + target.search + target.hash);
    });
  })();
</script>
