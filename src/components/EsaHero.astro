---
/*
 * Hero + the one high-level journey, shared by /esa and every /esa/<state> page so both
 * open the same way. The per-state panel fills in the detail.
 */
const journey = [
  { who: 'bina', t: 'Talk to bina' },
  { who: 'state', t: "Apply for your state's program" },
  { who: 'state', t: 'Get approved & funded' },
  { who: 'bina', t: 'Enroll at bina' },
  { who: 'both', t: 'Pay with your funds' },
];

const dot = {
  bina: 'bg-bina-yellow',
  state: 'bg-bina-blue',
  both: 'bg-bina-grass',
};
---

<header class="bg-bina-purple">
  <div class="mx-auto max-w-5xl px-5 py-16 sm:py-20">
    <p class="pill-bina mb-6 text-sm tracking-wide">ESA funding for families</p>
    <slot name="heading" />
    <p class="mb-12 max-w-2xl text-lg text-coal-1000 sm:text-xl">
      Many U.S. states give families public education dollars — an
      <strong>Education Savings Account (ESA)</strong> — to spend on approved learning like bina.
      It takes a few steps, and we do them <strong>with you</strong>. Here's the whole path:
    </p>

    <!-- journey rail: horizontal on desktop, vertical on mobile, sits on the hero -->
    <ol class="relative grid gap-6 border-t-2 border-coal-black/20 pt-10 md:grid-cols-5 md:gap-3">
      <span
        class="absolute left-[19px] top-[3.75rem] h-[calc(100%-4.5rem)] w-0.5 bg-coal-black/25 md:left-0 md:top-[calc(2.5rem+19px)] md:h-0.5 md:w-full"
        aria-hidden="true"></span>
      {
        journey.map((step, i) => (
          <li class="relative flex items-start gap-4 md:block">
            <span class="relative z-10 grid h-10 w-10 flex-none place-items-center rounded-full border-2 border-coal-black bg-white font-display text-base font-black md:mb-3">
              {i + 1}
            </span>
            <span class="md:block">
              <h2 class="mb-1.5 font-display text-base font-bold leading-snug">{step.t}</h2>
              <span class="inline-flex items-center gap-1.5 font-display text-xs font-bold text-coal-900">
                <span class={`h-2.5 w-2.5 rounded-full border border-coal-black ${dot[step.who]}`} />
                {step.who === 'bina' ? 'with bina' : step.who === 'state' ? "on your state's site" : 'together'}
              </span>
            </span>
          </li>
        ))
      }
    </ol>
  </div>
</header>
