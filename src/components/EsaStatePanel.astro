---
/*
 * One state's ESA panel — the exact block /esa used to build with innerHTML into #result,
 * now server-rendered so every state is real HTML on its own URL. Copy is unchanged from
 * the old renderer; only the place it runs moved (browser → build).
 */
import {
  BADGE,
  CHIP,
  EMAIL,
  WEBSITE,
  facts,
  noteFor,
  notifyHref,
  numberedSteps,
  programFor,
} from '../lib/esa-states.js';

interface Props {
  /** Full state name, e.g. "Arizona". */
  state: string;
}

const { state } = Astro.props;

const d = programFor(state);
const soon = d?.status === 'coming-soon';
const badge = d ? BADGE[d.status] : null;
const tiles = d ? facts(d) : [];
const groups = d ? numberedSteps(d) : [];
const note = noteFor(state);

const linkCls = 'inline-flex font-bold underline decoration-bina-pink decoration-2 underline-offset-4';
---

{
  d ? (
    <div class="overflow-hidden rounded-[1.875rem] border-2 border-coal-black">
      <div class="flex flex-wrap items-center justify-between gap-3 bg-bina-yellow px-6 py-5">
        <div>
          <p class="font-display text-2xl font-black">{d.s}</p>
          <p class="text-sm font-bold text-coal-900">{d.prog}</p>
        </div>
        <span
          class={`rounded-full border-2 border-coal-black px-4 py-1.5 font-display text-xs font-bold ${badge.cls}`}
        >
          {badge.label}
        </span>
      </div>

      {soon && d.soonIntro && (
        <div class="border-t-2 border-coal-black bg-bina-orange/25 px-6 py-4 text-sm font-bold">
          {d.soonIntro}
        </div>
      )}

      {d.special && (
        <div class="border-t-2 border-coal-black bg-bina-orange/25 px-6 py-3 text-sm font-bold">
          ⚠ {d.special}
        </div>
      )}

      <div class="grid gap-px border-t-2 border-coal-black bg-coal-black sm:grid-cols-3">
        {tiles.map((f) => (
          <div class="bg-white p-4 sm:px-6">
            <p class="mb-1 font-display text-[11px] font-bold uppercase tracking-widest text-coal-900/60">
              {f.k}
            </p>
            <p class="text-[15px] font-bold">{f.v}</p>
          </div>
        ))}
      </div>

      {d.boost && (
        <div class="border-t-2 border-coal-black bg-bina-grass/25 px-6 py-3 text-sm font-bold">
          ✓ {d.boost}
        </div>
      )}

      <ul class="m-0 list-none p-0">
        {groups.map((g) => (
          <>
            <li class="border-t-2 border-coal-black bg-coal-black px-5 py-2 font-display text-xs font-bold uppercase tracking-widest text-bina-yellow sm:px-6">
              {g.label}
            </li>
            {g.steps.map((step) => (
              <li class="flex gap-4 border-t-2 border-coal-black bg-white px-5 py-4 sm:px-6">
                <span class="grid h-10 w-10 flex-none place-items-center rounded-xl border-2 border-coal-black bg-bina-yellow font-display text-lg font-black">
                  {step.n}
                </span>
                <span class="min-w-0">
                  <span class="mb-0.5 flex flex-wrap items-center gap-2">
                    <strong class="font-display text-base">{step.t}</strong>
                    <span
                      class={`inline-flex rounded-full border-2 border-coal-black px-2.5 py-0.5 font-display text-[11px] font-bold ${CHIP[step.w].cls}`}
                    >
                      {CHIP[step.w].label}
                    </span>
                  </span>
                  <span class="block text-sm text-coal-900">{step.x}</span>
                  {step.cta === 'book' && (
                    <a class={`mt-2 ${linkCls}`} href={WEBSITE}>
                      Book a call with bina →
                    </a>
                  )}
                  {step.cta === 'notify' && (
                    <a class={`mt-2 ${linkCls}`} href={notifyHref(d.s)}>
                      Email us about {d.s} →
                    </a>
                  )}
                  {step.link && (
                    <a class={`mt-2 ${linkCls}`} href={step.link.url} target="_blank" rel="noopener">
                      {step.link.label}
                    </a>
                  )}
                </span>
              </li>
            ))}
          </>
        ))}
      </ul>

      <div class="border-t-2 border-coal-black bg-white px-6 py-3 text-sm text-coal-900">
        {
          soon
            ? `We update this page the moment ${d.s}’s rules or bina’s status change — so what you read here is where things actually stand today.`
            : 'Funding renews each school year — we send you fresh paperwork every season, so renewing takes minutes.'
        }
      </div>

      <div class="flex flex-wrap items-center gap-3 border-t-2 border-coal-black bg-white px-6 py-5">
        <a class="btn-bina !px-5 !py-2.5 text-sm" href={WEBSITE} target="_blank" rel="noopener">
          Visit bina to start
        </a>
        <a class="btn-bina-ghost !px-5 !py-2.5 text-sm" href={d.officialUrl} target="_blank" rel="noopener">
          {d.s} program site ↗
        </a>
        <a class={linkCls} href={d.binaUrl}>bina’s {d.s} guide</a>
        {soon && (
          <a class={linkCls} href={notifyHref(d.s)}>
            Email us about {d.s} →
          </a>
        )}
      </div>

      <div class="border-t-2 border-coal-black bg-white px-6 py-3 text-xs text-coal-900/70">
        Numbers and deadlines change every year — the official {d.prog} site is the final word.
      </div>
    </div>
  ) : (
    <div class="overflow-hidden rounded-[1.875rem] border-2 border-coal-black">
      <div class="bg-bina-purple/20 px-6 py-5">
        <p class="font-display text-xl font-black">
          {state} doesn't have a program you can use for bina yet.
        </p>
        {note && <p class="mt-2 text-sm font-bold text-coal-900">{note}</p>}
        <p class="mt-2 text-sm text-coal-900">
          New programs launch every year — and plenty of bina families enroll privately in the
          meantime. Talk to us and we’ll flag you the moment {state} opens one.
        </p>
      </div>
      <div class="flex flex-wrap gap-3 border-t-2 border-coal-black bg-white px-6 py-5">
        <a class="btn-bina !px-5 !py-2.5 text-sm" href={WEBSITE} target="_blank" rel="noopener">
          Visit bina to start
        </a>
        <a
          class="btn-bina-ghost !px-5 !py-2.5 text-sm"
          href={`mailto:${EMAIL}?subject=Funding%20options%20in%20${encodeURIComponent(state)}`}
        >
          Email us about funding
        </a>
      </div>
    </div>
  )
}
