---
/*
 * One state's process: the support table (when the state has one) and the numbered steps.
 * Formerly the numbered steps that used to live in /esa's dropdown panel,
 * server-rendered for the state whose page this is. Replaces EsaStatePanel: with the page
 * merged (hero → how it works → money → process → FAQ) the fact tiles moved up into the
 * money section, so this block is the steps and nothing else.
 */
import BrandText from './BrandText.astro';
import { CHIP } from '../lib/esa-states.js';

interface Props {
  /** The resolved page model from statePage(). */
  page: ReturnType<typeof import('../lib/esa-states.js').statePage>;
}

const { page } = Astro.props;
const { copy, groups, stepTotal, stepsBina, stepsState, stepsBoth } = page;
// Labels are sentence case on the page; the lib keeps its lowercase strings.
const sentence = (t) => t.charAt(0).toUpperCase() + t.slice(1);
---

<!-- Dark section, mint step cards with black text (Zeyu, 2026-11-04). -->
<section id="process" class="theme-base scroll-mt-20">
  <div class="mx-auto max-w-5xl px-5 py-14">
    <p class="eyebrow-bina mb-2">The process</p>
    <h2 class="mb-3 text-title-xl sm:text-title-3xl">From application to first day</h2>
    <p class="mb-8 max-w-2xl">
      You do {stepsState} on {copy.state}'s own website, {stepsBina} happen with us, and {stepsBoth} we
      do together — so you never have to work out which is which on your own.
    </p>

    {
      copy.support && (
        <div class="mb-12">
          <h3 class="mb-2 font-display text-title-lg font-bold">{copy.support.title}</h3>
          <p class="mb-6 max-w-2xl text-body-lg">{copy.support.lead}</p>
          <div class="hidden sm:block">
            <table class="w-full text-left text-body-lg">
              <thead>
                <tr class="border-b border-mint">
                  <th class="w-1/2 py-2 pr-6 font-display text-label uppercase text-hl">What you do</th>
                  <th class="w-1/2 py-2 font-display text-label uppercase text-hl">What <span class="normal-case">bina</span> does</th>
                </tr>
              </thead>
              <tbody>
                {copy.support.rows.map(([you, bina]) => (
                  <tr class="border-b border-mint align-top">
                    <td class="py-3 pr-6">{you}</td>
                    <td class="py-3">{bina}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <!-- Phones: one pair per row, stacked. -->
          <ul class="grid sm:hidden">
            {copy.support.rows.map(([you, bina]) => (
              <li class="border-b border-mint py-4 text-body-lg">
                <p class="font-display text-label uppercase text-hl">What you do</p>
                <p class="mb-3">{you}</p>
                <p class="font-display text-label uppercase text-hl">What <span class="normal-case">bina</span> does</p>
                <p>{bina}</p>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    <div class="grid gap-8">
      {
        groups.map((g) => (
          <div>
            <p class="eyebrow-bina mb-3"><BrandText text={g.label} /></p>
            <ol class="m-0 grid list-none gap-4 p-0">
              {g.steps.map((step) => (
                <li class="flex items-center gap-5 rounded-lg bg-mint px-5 py-5 text-black sm:gap-7 sm:px-7">
                  <span class="w-8 flex-none text-center font-display text-title-3xl sm:text-display-sm" aria-hidden="true">
                    {step.n}
                  </span>
                  <span class="min-w-0 flex-1">
                    <span class="mb-2 flex flex-wrap items-start justify-between gap-x-4 gap-y-2">
                      <strong class="font-display text-title-md">
                        <span class="sr-only">Step {step.n}: </span>{step.t}
                      </strong>
                      <span class="inline-flex flex-none items-center rounded-full border-2 border-black px-3 py-1 font-display text-label uppercase">
                        <BrandText text={step.who === 'state' ? `On ${copy.state}'s site` : sentence(CHIP[step.who].label)} />
                      </span>
                    </span>
                    <span class="block text-body-lg">{step.d}</span>
                    {step.url && (
                      <a href={step.url} rel="noopener" class="mt-2 inline-flex text-body-lg font-bold underline underline-offset-4">
                        {step.urlLabel}
                      </a>
                    )}
                  </span>
                </li>
              ))}
            </ol>
          </div>
        ))
      }
    </div>

    <p class="mt-6 text-body-lg text-hl">
      *Funding renews each school year — we send you fresh paperwork every season, so renewing takes minutes.
    </p>

  </div>
</section>
