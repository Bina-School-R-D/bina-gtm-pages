---
/*
 * Renders text with every "bina" kept lowercase, even inside an uppercase label
 * (brand rule: the company name is always lowercase). Display only.
 */
interface Props {
  text: string;
}
const parts = String(Astro.props.text).split(/(bina)/g);
---
{parts.map((p) => (p === 'bina' ? <span class="normal-case">bina</span> : p))}
