---
/*
 * The page's own sub-navbar (Akis, 2026-11-19; 2026-11-20: the ONLY sticky bar — the main
 * navbar is gone from market pages). One look, always (Akis, 2026-11-20: "no change on scroll"):
 * the main navbar's dark style — bina logo + market name, section links, yellow CTA — sticky at the
 * top (`is-stuck` is set in the markup; the light "rest" look is no longer used). Jumps
 * to the page's groups (Accreditation · Community · Success · Education · Tuition · FAQs). Its own light
 * colour (mint), so it reads as part of the page, not of the black main navbar.
 * Items come from the rendered sections (lib/local.js navItems), so a group dropped on
 * production never leaves a dead link.
 * Under 1024px (Akis, 2026-11-23): full bina logo + market name on the left, then the CTA; the
 * section links stay visible as a second, sideways-scrolling row under them, and the row slides
 * so the highlighted link is always in view as you scroll the page (Akis, 2026-11-23: replaces
 * the burger + drop-down, which hid the links).
 */
import { CTA, CTA_LABEL } from '../../lib/esa-states.js';
interface Props {
  items: { id: string; label: string }[];
  /** Not a link: the market's name tag at the start of the bar, e.g. [bina logo] Toronto. */
  label?: { text: string; icon?: string; iconAlt?: string };
}
const { items, label } = Astro.props;
---
{items.length > 0 && (
  <nav class="local-subnav is-stuck" aria-label="On this page" data-local-subnav>
    <div class="local-subnav-inner">
      {label && (
        <a class="local-subnav-label no-underline" href="#" aria-label={label.text}>
          <span class="local-subnav-rest">
            {label.icon && <img src={label.icon} alt="" width="26" height="24" class="local-subnav-map" />}
            <span>{label.text.split(/(bina)/).filter(Boolean).map((t) => (t === 'bina' ? <span class="normal-case">bina</span> : t))}</span>
          </span>
          <span class="local-subnav-stuck">
            <img src="/images/local/nav/navbar-logo.svg" alt="" width="68" height="29" class="local-subnav-logo" />
            <span class="local-subnav-name">{label.text.replace(/^bina\s+/, '')}</span>
          </span>
        </a>
      )}
      <ul class="local-subnav-row">
        {items.map((it) => (
          <li><a class="local-subnav-link no-underline" href={`#${it.id}`} data-target={it.id}>{it.label}</a></li>
        ))}
      </ul>
      <a href={CTA} target="_blank" rel="noopener noreferrer" class="local-subnav-cta no-underline" aria-label={CTA_LABEL}>
        <span><span class="max-sm:hidden">Start your <span class="normal-case">bina</span> journey</span><span class="sm:hidden">Start</span></span>
        <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 10H16M16 10L11 5M16 10L11 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </a>
      <button type="button" class="local-subnav-burger" aria-label="Open page sections" aria-expanded="false" aria-controls="local-subnav-menu">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" aria-hidden="true">
          <path d="M4 7H20" stroke="#7B61FF" stroke-width="2.5" stroke-linecap="round" />
          <path d="M4 12H20" stroke="#7B61FF" stroke-width="2.5" stroke-linecap="round" />
          <path d="M4 17H20" stroke="#7B61FF" stroke-width="2.5" stroke-linecap="round" />
        </svg>
      </button>
    </div>
    <ul id="local-subnav-menu" class="local-subnav-menu" hidden>
      {items.map((it) => (
        <li><a class="local-subnav-menu-link no-underline" href={`#${it.id}`} data-target={it.id}>{it.label}</a></li>
      ))}
    </ul>
  </nav>
)}

<script>
  const nav = document.querySelector<HTMLElement>('[data-local-subnav]');
  if (nav) {
    const row = nav.querySelector<HTMLElement>('.local-subnav-row')!;
    const links = [...nav.querySelectorAll<HTMLAnchorElement>('[data-target]')];
    const ids = [...new Set(links.map((a) => a.dataset.target!))];
    const targets = ids.map((id) => document.getElementById(id)).filter(Boolean) as HTMLElement[];
    let current = '';
    const update = () => {
      const line = nav.getBoundingClientRect().bottom + 24;
      let id = '';
      for (const t of targets) if (t.getBoundingClientRect().top <= line) id = t.id;
      if (id === current) return;
      current = id;
      for (const a of links) {
        const on = a.dataset.target === id;
        a.classList.toggle('is-active', on);
        if (on) {
          a.setAttribute('aria-current', 'true');
          // Slide the row so the active link sits in the middle (phones: the links row scrolls sideways).
          if (row.contains(a)) {
            const r = row.getBoundingClientRect(), l = a.getBoundingClientRect();
            row.scrollBy({ left: l.left - r.left - (r.width - l.width) / 2, behavior: 'smooth' });
          }
        } else a.removeAttribute('aria-current');
      }
    };
    let queued = false;
    addEventListener('scroll', () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => { queued = false; update(); });
    }, { passive: true });
    update();

    // Phones/tablets: the burger opens the section list under the bar; a tap on a link,
    // outside the bar, or Escape closes it.
    const burger = nav.querySelector<HTMLButtonElement>('.local-subnav-burger')!;
    const menu = nav.querySelector<HTMLElement>('.local-subnav-menu')!;
    const setMenu = (open: boolean) => {
      menu.hidden = !open;
      burger.setAttribute('aria-expanded', String(open));
      burger.setAttribute('aria-label', open ? 'Close page sections' : 'Open page sections');
    };
    burger.addEventListener('click', () => setMenu(menu.hidden));
    menu.addEventListener('click', (e) => { if ((e.target as Element).closest('a')) setMenu(false); });
    document.addEventListener('click', (e) => { if (!nav.contains(e.target as Node)) setMenu(false); });
    document.addEventListener('keydown', (e) => e.key === 'Escape' && setMenu(false));
    matchMedia('(min-width: 1024px)').addEventListener('change', (e) => e.matches && setMenu(false));
  }
</script>

<style is:global>
  /* --local-nav-h = the bar's height. Tighter than MainSiteNavbar's .site-nav (76–132px) so the
     back bar above it doesn't leave a gap over the logo (Akis, 2026-11-23). */
  :root { --local-subnav-h: 4rem; --local-nav-h: 3.75rem; --local-backbar-h: 0px; }
  /* Phones/tablets: logo + CTA row (3.5rem) plus the section links row (3.25rem). */
  @media (max-width: 1023px) { :root { --local-nav-h: 6.75rem; } }
  @media (min-width: 1024px) { :root { --local-nav-h: clamp(4.25rem, 4.2vw, 6.5rem); } }

  /* Only this bar sticks: the main navbar scrolls away on market pages. */
  body:has([data-local-subnav]) .site-nav { position: relative; }

  /* Sits right under the page's sticky back bar (if any), so both stay on screen together. */
  .local-subnav {
    position: sticky;
    top: var(--local-backbar-h);
    z-index: 999;
    height: var(--local-subnav-h);
    background: var(--color-mint);
    color: #000;
    border-bottom: 1px solid rgb(0 0 0 / 0.12);
    box-shadow: 0 6px 16px rgb(0 0 0 / 0.08);
  }
  /* Same side padding as the main navbar, so the logos line up. */
  .local-subnav-inner {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    height: 100%;
    padding: 0 clamp(1.05rem, 1.39vw, 2.25rem);
  }
  .local-subnav-label { flex: none; display: flex; align-items: center; gap: 0.5rem; padding-right: 1rem; border-right: 1px solid rgb(0 0 0 / 0.2); font-family: 'Rund Display', sans-serif; font-size: 18px; font-weight: 700; white-space: nowrap; color: #000; }
  .local-subnav-label:hover { text-decoration: none; }
  .local-subnav-rest, .local-subnav-stuck { display: flex; align-items: center; gap: 0.5rem; }
  .local-subnav-map { width: 34px; height: auto; }
  .local-subnav-logo { width: 58px; height: auto; transform: translateY(-3px); }
  .local-subnav-stuck, .local-subnav-cta { display: none !important; }

  /* Stuck to the top it becomes the main navbar: same height, padding, logo, link type and CTA
     as MainSiteNavbar's .site-nav (copied from thebinaschool.com). */
  .local-subnav { transition: background-color 0.2s, color 0.2s; }
  .local-subnav.is-stuck { height: var(--local-nav-h); background: #000; color: #06e1bd; border-bottom-color: #000; box-shadow: 0 6px 16px rgb(0 0 0 / 0.25); }
  .local-subnav.is-stuck .local-subnav-rest { display: none; }
  .local-subnav.is-stuck .local-subnav-stuck { display: flex !important; }
  .local-subnav.is-stuck .local-subnav-cta { display: inline-flex !important; }
  .local-subnav.is-stuck .local-subnav-inner { gap: clamp(1rem, 2.5vw, 3.5rem); padding: clamp(0.35rem, 0.46vw, 0.75rem) clamp(1.05rem, 1.39vw, 2.25rem); }
  .local-subnav.is-stuck .local-subnav-label { color: #fff; border-right: 0; padding-right: 0; font-size: clamp(0.92rem, 1.22vw, 1.97rem); }
  .local-subnav.is-stuck .local-subnav-logo { aspect-ratio: 68/29; object-fit: contain; width: clamp(3.28rem, 4.34vw, 7.03rem); height: clamp(1.4rem, 1.85vw, 3rem); transform: translateY(-5px); }
  .local-subnav.is-stuck .local-subnav-row { gap: clamp(0.25rem, 1vw, 1.5rem); }
  .local-subnav.is-stuck .local-subnav-link { color: #06e1bd; font-weight: 400; font-size: clamp(0.83rem, 1.1vw, 1.78rem); padding: 0.45em 0.9em; }
  .local-subnav.is-stuck .local-subnav-link:hover { background: rgb(255 255 255 / 0.1); }
  .local-subnav.is-stuck .local-subnav-link.is-active { background: #06e1bd; color: #000; }
  .local-subnav.is-stuck .local-subnav-cta {
    height: auto;
    min-height: clamp(2.45rem, 3.24vw, 5.25rem);
    padding: clamp(0.5rem, 0.7vw, 0.75rem) clamp(1rem, 1.39vw, 1.5rem);
    border-radius: clamp(0.625rem, 0.83vw, 1rem);
    gap: clamp(0.375rem, 0.46vw, 0.5rem);
    font-weight: 400;
    font-size: clamp(0.92rem, 1.22vw, 1.97rem);
  }
  .local-subnav.is-stuck .local-subnav-cta svg { width: clamp(0.75rem, 1.04vw, 1.69rem); height: clamp(0.75rem, 1.04vw, 1.69rem); }
  .local-subnav-row {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    height: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .local-subnav-row::-webkit-scrollbar { display: none; }
  .local-subnav-row li { flex: none; scroll-snap-align: start; }
  .local-subnav-link {
    display: block;
    padding: 0.45rem 1rem;
    border-radius: 999px;
    font-family: 'Rund Display', sans-serif;
    font-size: 15px;
    font-weight: 600;
    white-space: nowrap;
    color: #000;
    transition: background 0.15s, color 0.15s;
  }
  .local-subnav-link:hover { background: rgb(0 0 0 / 0.07); text-decoration: none; }
  .local-subnav-link.is-active { background: #000; color: var(--color-lagoon); }
  /* The main navbar's yellow CTA (MainSiteNavbar .nav-cta), at the bar's height. */
  .local-subnav-cta {
    flex: none; display: inline-flex; align-items: center; gap: 0.4rem;
    height: 2.75rem; padding: 0 1.1rem;
    border: 2px solid #000; border-radius: 0.75rem;
    background: #f7d928; color: #000;
    font-family: 'Rund Display', sans-serif; font-size: 16px; font-weight: 500; white-space: nowrap;
    transition: background-color 0.3s ease-out;
  }
  .local-subnav-cta:hover { background: #fe49c1; color: #000; text-decoration: none; }
  .local-subnav-cta:active { background: #ff605b; }
  .local-subnav-cta svg { width: 1rem; height: 1rem; flex: none; }
  /* Burger + drop-down section list (under 1024px). Burger = MainSiteNavbar's .nav-burger. */
  .local-subnav-burger { display: none; flex: none; cursor: pointer; background: transparent; border: none; justify-content: center; align-items: center; width: 2.75rem; height: 2.75rem; margin-right: -0.4rem; }
  .local-subnav-burger path { transform-box: view-box; transform-origin: 50%; transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.2s; }
  .local-subnav-burger[aria-expanded='true'] path:nth-child(1) { transform: rotate(45deg) translateY(5px); }
  .local-subnav-burger[aria-expanded='true'] path:nth-child(2) { opacity: 0; }
  .local-subnav-burger[aria-expanded='true'] path:nth-child(3) { transform: rotate(-45deg) translateY(-5px); }
  .local-subnav-menu {
    position: absolute; top: 100%; left: 0; right: 0;
    max-height: calc(100dvh - var(--local-nav-h) - var(--local-backbar-h)); overflow-y: auto;
    margin: 0; padding: 0.5rem clamp(1.05rem, 1.39vw, 2.25rem) 1rem; list-style: none;
    background: #000; border-top: 1px solid rgb(255 255 255 / 0.12);
    box-shadow: 0 16px 24px rgb(0 0 0 / 0.35);
  }
  .local-subnav-menu[hidden] { display: none; }
  .local-subnav-menu li + li { border-top: 1px solid rgb(255 255 255 / 0.12); }
  .local-subnav-menu-link {
    display: flex; align-items: center; min-height: 3.25rem; padding: 0 0.6rem; margin: 0.15rem -0.6rem;
    border-radius: 0.75rem; color: #06e1bd; font-family: 'Rund Display', sans-serif; font-size: 18px; font-weight: 400;
  }
  .local-subnav-menu-link:hover { background: rgb(255 255 255 / 0.08); text-decoration: none; }
  .local-subnav-menu-link.is-active { background: #06e1bd; color: #000; }

  @media (max-width: 1023px) {
    /* Two rows: logo + CTA, then the links, full width and scrolling sideways. */
    .local-subnav.is-stuck .local-subnav-inner { flex-wrap: wrap; align-content: stretch; row-gap: 0; padding-top: 0; padding-bottom: 0; }
    .local-subnav.is-stuck .local-subnav-label { height: 3.5rem; }
    .local-subnav-cta { margin-left: auto; }
    .local-subnav.is-stuck .local-subnav-row {
      /* Pills sit a little high in their row so the space above them (from the CTA) matches the space below. */
      order: 3; flex: 1 0 100%; height: 3.25rem; gap: 0.25rem; align-items: flex-start;
      margin: 0 calc(-1 * clamp(1.05rem, 1.39vw, 2.25rem)); padding: 0.25rem clamp(1.05rem, 1.39vw, 2.25rem) 0;
      scroll-padding: 0 clamp(1.05rem, 1.39vw, 2.25rem);
    }
    .local-subnav.is-stuck .local-subnav-link { font-size: 16px; padding: 0.4rem 0.9rem; }
    .local-subnav-burger, .local-subnav-menu { display: none !important; }
  }
  @media (min-width: 1024px) {
    .local-subnav-menu { display: none !important; }
  }
  @media (max-width: 639px) {
    .local-subnav.is-stuck .local-subnav-inner { column-gap: 0.6rem; }
    .local-subnav.is-stuck .local-subnav-label { min-width: 0; flex: 0 1 auto; font-size: 18px; gap: 0.6rem; }
    .local-subnav-name { overflow: hidden; text-overflow: ellipsis; padding-left: 0.6rem; border-left: 1px solid rgb(255 255 255 / 0.3); }
    .local-subnav.is-stuck .local-subnav-cta { padding: 0.5rem 0.85rem; }
  }

  /* Jumps land below the sticky bar. */
  .local-page [data-local-anchor] { scroll-margin-top: calc(var(--local-nav-h) + var(--local-backbar-h)); }
</style>
