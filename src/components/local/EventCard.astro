---
/*
 * One compact event card for the community section (photo left, text right) + the photo credit
 * under it. Upcoming: title · area · short date · "N families already registered" · RSVP, and a
 * "Sponsored by bina" strip along the bottom when bina pays.
 * Past: title · area · month + year (never the exact day).
 */
import Pending from './Pending.astro';

interface Props {
  event: any;
  upcoming?: boolean;
}
const { event: e, upcoming } = Astro.props;
const hasPhoto = typeof e.photo === 'object' && e.photo;
// "Saturday Dec 19, 2026" (Akis, 2026-11-23: weekday + full date).
const fullDate = (d: string) => {
  const t = new Date(d + 'T00:00:00Z');
  const wd = t.toLocaleDateString('en-US', { weekday: 'long', timeZone: 'UTC' });
  return `${wd} ${t.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}`;
};
---
<li>
  <div class="card-bina-mint overflow-hidden">
  {/* Upcoming: more air (Akis, 2026-11-23: too dense): photo on top on phones, beside the text from sm. */}
  <div class:list={['flex', upcoming ? 'flex-col sm:flex-row' : 'items-center']}>
    <div class:list={['grid flex-none place-items-center bg-black/10 text-center text-body-md', upcoming ? 'aspect-[16/9] w-full sm:aspect-auto sm:w-64 sm:self-stretch' : 'aspect-[4/3] w-36 self-stretch sm:w-40', !hasPhoto && 'p-2']}>
      {hasPhoto ? <img src={e.photo.src} alt={e.photo.alt} loading="lazy" class="size-full object-cover" /> : e.photo && <Pending text={e.photo} />}
    </div>
    <div class={upcoming ? 'p-6 sm:p-7' : 'p-4'}>
      <p class:list={['font-display', upcoming ? 'text-title-md' : 'text-title-sm']}><Pending text={e.title} /></p>
      {upcoming ? (
        <>
          <p class="mt-3 text-body-xl font-semibold">{fullDate(e.date)}{e.time && <> · {e.time}</>}</p>
          <p class="mt-1 text-body-lg"><Pending text={e.area} /></p>
          {e.text && <p class="mt-4 max-w-prose text-body-lg leading-relaxed"><Pending text={e.text} /></p>}
          <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-3">
          {/* Opens the booking page in a new tab, with the "opens in a new tab" icon (Akis, 2026-11-23). */}
          {e.rsvp && (
            <a href={e.rsvp} class="btn-bina btn-sm inline-flex items-center gap-2" target="_blank" rel="noopener noreferrer">
              <span>Register</span>
              <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" /></svg>
              <span class="sr-only">(opens in a new tab)</span>
            </a>
          )}
          {e.registered > 0 && <p class="text-body-lg font-semibold text-hl">{e.registered} families already registered</p>}
          </div>
        </>
      ) : (
        <p class="mt-1 text-body-lg"><Pending text={e.area} /> · {e.month && <><Pending text={String(e.month)} />{' '}</>}{e.year}</p>
      )}
    </div>
  </div>
  {/* Sponsored event (Akis, 2026-11-23): a deep ocean strip across the bottom of the card with
      the sponsorship sentence from the data. */}
  {e.sponsored && (
    <p class="bg-deep-ocean px-6 py-4 text-body-lg text-mint sm:px-7"><Pending text={e.sponsored} /></p>
  )}
  </div>
  {/* Credit for a public (e.g. Wikimedia Commons) photo, under the card (Akis, 2026-11-23): author
      linked to the source page (licence shown there). Deliberately low contrast: mint at 50% over
      the band, a light tint of the background (Akis, 2026-11-23, an AA exception for credits only). */}
  {e.photo?.credit && (
    <p class="event-credit mt-2 px-1 text-body-md">
      Photo: <a href={e.photo.credit.source} rel="noopener">{e.photo.credit.author}</a>
    </p>
  )}
</li>

<style>
  .event-credit,
  .event-credit a { color: color-mix(in srgb, var(--color-mint) 50%, transparent); }
</style>
