---
/*
 * A row of 5 star shapes, filled to `value` (0–5, halves and fractions allowed). Fill is the current
 * text color; the unfilled part is the same color at low opacity. Used on the reviews wall so the
 * ratings read at a glance (Akis, 2026-11-23: "too subtle").
 */
interface Props {
  value: number;
  /** Number of stars (default 5). */
  count?: number;
  /** Stars almost touching: no gap, the star's own padding trimmed. */
  tight?: boolean;
  class?: string;
  label?: string;
}
const { value, count = 5, tight = false, class: cls = 'h-6 w-6', label } = Astro.props;
const uid = Math.random().toString(36).slice(2, 8);
const STAR = 'M12 2.6l2.85 6.05 6.6.78-4.88 4.53 1.3 6.53L12 17.2l-5.87 3.29 1.3-6.53L2.55 9.43l6.6-.78z';
---
<span class:list={['inline-flex items-center', tight ? 'gap-px' : 'gap-0.5']} role="img" aria-label={label ?? `${value} out of ${count} stars`}>
  {Array.from({ length: count }, (_, i) => i).map((i) => {
    const f = Math.max(0, Math.min(1, value - i));
    return (
      <svg viewBox={tight ? '2.3 2.3 19.4 19.4' : '0 0 24 24'} class={cls} aria-hidden="true">
        {f > 0 && f < 1 && (
          <defs>
            <linearGradient id={`st-${uid}-${i}`}>
              <stop offset={f} stop-color="currentColor" />
              <stop offset={f} stop-color="currentColor" stop-opacity="0.25" />
            </linearGradient>
          </defs>
        )}
        <path d={STAR} stroke-linejoin="round" fill={f >= 1 ? 'currentColor' : f <= 0 ? 'currentColor' : `url(#st-${uid}-${i})`} fill-opacity={f <= 0 ? 0.25 : 1} />
      </svg>
    );
  })}
</span>
