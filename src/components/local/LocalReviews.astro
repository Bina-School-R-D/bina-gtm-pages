---
/*
 * Reviews on a /local page (Akis, 2026-11-20): the /reviews page in short. Its hero (lagoon, the
 * landscape + deer + parent art, the 4 score badges) and 6 of its wall cards, same width, less
 * height. Picks come from the market's section data (`items`):
 *   { feature: 'T-016' }                      a LinkedIn / Instagram card from reviews.json `beyond`
 *   { review: 'tp-01' }                       a review from reviews.json
 *   { inline: { source, title, body, … } }    a review not in reviews.json (world-schools.com)
 * Names show as initials, like the main site's /reviews (staging, 2026-11-20). Bodies are verbatim.
 */
import data from '../../data/reviews.json';
import Pending from './Pending.astro';

interface Props {
  section: any;
  theme?: string;
}
const { section } = Astro.props;

const NICHE = 'https://www.niche.com/k12/bina-claymont-de/reviews/';
const sourceUrl: Record<string, string> = {
  niche: NICHE,
  trustpilot: 'https://www.trustpilot.com/review/thebinaschool.com',
  'world-schools': 'https://world-schools.com/schools/bina-school/',
  site: 'https://thebinaschool.com',
};
const sourceVerb: Record<string, string> = {
  niche: 'Verified on Niche',
  trustpilot: 'Verified on Trustpilot',
  'world-schools': 'Verified on world-schools.com',
  site: 'Published on thebinaschool.com',
};
const sourceLogo: Record<string, string> = {
  niche: '/images/logos/niche-black.svg',
  trustpilot: '/images/logos/trustpilot-black.svg',
  'world-schools': '/images/logos/world-schools-black.svg',
  site: '/images/logos/bina-black.svg',
  survey: '/images/logos/bina-black.svg',
};
const BAR = ['niche', 'trustpilot', 'world-schools', 'survey'];
const bar = BAR.map((k) => data.sources.find((s: any) => s.key === k)).filter(Boolean) as any[];

const initials = (name?: string | null) =>
  name ? name.split(/\s+/).filter(Boolean).map((w) => w[0].toUpperCase() + '.').join(' ') : null;
const monthYear = (iso?: string | null) =>
  iso ? new Date(iso + 'T00:00:00Z').toLocaleDateString('en-GB', { month: 'short', year: 'numeric', timeZone: 'UTC' }) : null;

type Card =
  | { kind: 'feature'; logo: string; who: string; platform: string; cta: string; url: string; title: string; detail: string }
  | { kind: 'review'; id: string; logo: string; who: string; meta: string; verb: string; url: string; title?: string; paras: string[]; rating?: number };

const cards: Card[] = (section.items ?? [])
  .map((it: any, i: number): Card | null => {
    if (it.feature) {
      const f: any = data.beyond.find((b: any) => b.notionId === it.feature);
      if (!f) return null;
      return { kind: 'feature', logo: f.logo, who: it.who ?? f.who, platform: f.platform, cta: f.cta, url: f.url, title: it.title ?? f.title, detail: f.detail };
    }
    const r: any = it.review ? data.reviews.find((x: any) => x.id === it.review) : it.inline;
    if (!r) return null;
    const who = initials(r.author) ?? 'A bina parent';
    const when = monthYear(r.date);
    return {
      kind: 'review',
      id: r.id ?? `inline-${i}`,
      logo: sourceLogo[r.source],
      who,
      meta: [r.author ? 'bina parent' : null, r.country, when].filter(Boolean).join(' · '),
      verb: sourceVerb[r.source],
      url: r.url ?? sourceUrl[r.source],
      title: r.title,
      paras: String(r.body).split('\n\n').filter(Boolean),
      rating: r.rating ?? 5,
    };
  })
  .filter(Boolean);

const ext = 'M14 4h6v6M20 4 10.5 13.5';
const ext2 = 'M18 14.5V19a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h4.5';
---

<header class="theme-lagoon local-reviews-hero relative overflow-hidden" data-local-section="reviews-hero">
  <img src="/images/local/reviews/reviews-landscape.webp" alt="" width="2880" height="600" loading="lazy" decoding="async" class="pointer-events-none absolute inset-x-0 bottom-0 block h-auto w-full select-none max-sm:left-[-40vw] max-sm:w-[180vw] max-sm:max-w-none" />
  <img src="/images/local/reviews/reviews-mom-kid.webp" alt="" width="450" height="588" loading="lazy" decoding="async" class="pointer-events-none absolute bottom-0 right-[6vw] block h-auto w-[15.6vw] select-none max-sm:right-[4vw] max-sm:w-[28vw]" />
  <img src="/images/local/reviews/reviews-deer.webp" alt="" width="594" height="486" loading="lazy" decoding="async" class="pointer-events-none absolute bottom-0 left-[6vw] block h-auto w-[20.6vw] select-none max-sm:left-[4vw] max-sm:w-[37vw]" />
  <div class="relative mx-auto max-w-5xl px-5 pb-[calc(20.8vw+0.5rem)] pt-14 max-sm:pb-[calc(37.5vw+0.5rem)] sm:pt-16">
    <h2 class="mb-5 text-title-3xl sm:text-display-sm"><Pending text={section.heading} /></h2>
    <p class="mb-8 text-body-xl"><Pending text={section.intro} /></p>
    <ul class="flex flex-wrap items-center gap-2" aria-label="Where bina is reviewed">
      {bar.map((src) => (
        <li>
          <a href={src.url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 rounded-full border-2 border-black bg-black px-2.5 py-1 font-display text-label uppercase text-lagoon no-underline transition-colors duration-200 hover:bg-grape">
            <span aria-hidden="true" class="local-badge-logo h-[1.125rem] w-[1.125rem] shrink-0 bg-current" style={`--logo:url(${sourceLogo[src.key]})`}></span>
            <span class="font-bold">{src.barLabel}</span>
            {src.barStat && <span class="font-bold">{src.barStat}</span>}
            <svg aria-hidden="true" viewBox="0 0 24 24" class="h-3 w-3 shrink-0" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d={ext} /><path d={ext2} /></svg>
            <span class="sr-only">(opens in a new tab)</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<section class="theme-base" data-local-section="reviews">
  <div class="mx-auto max-w-5xl px-5 py-14">
    <div class="grid grid-cols-1 gap-5 md:grid-cols-2 xl:grid-cols-3">
      {cards.map((c) =>
        c.kind === 'feature' ? (
          <div class="local-wall-cell card-bina-solid relative flex flex-col px-7 py-5">
            <div class="mb-2 flex shrink-0 items-center gap-2.5">
              <img src={c.logo} alt="" width="26" height="26" class="h-[1.625rem] w-[1.625rem] shrink-0" />
              <span class="min-w-0 flex-1">
                <span class="block truncate font-display text-body-md font-bold">{c.who}</span>
                <span class="block truncate text-body-md leading-tight">{c.platform}</span>
              </span>
            </div>
            <a href={c.url} target="_blank" rel="noopener noreferrer" class="mb-2 inline-flex shrink-0 items-center gap-1 self-start font-display text-body-md font-semibold">
              {c.cta}
              <svg aria-hidden="true" viewBox="0 0 24 24" class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d={ext} /><path d={ext2} /></svg>
              <span class="sr-only">(opens in a new tab)</span>
            </a>
            <p class="mb-1 line-clamp-1 shrink-0 font-display text-body-lg font-bold">{c.title}</p>
            <div class="local-review-body min-h-0 text-body-lg">{c.detail}</div>
            <a href={c.url} target="_blank" rel="noopener noreferrer" class="local-review-more no-underline">
              <span class="local-review-more-label">See more →</span>
              <span class="sr-only">(opens in a new tab)</span>
            </a>
          </div>
        ) : (
          <article class="local-review-card local-wall-cell card-bina-solid relative flex flex-col px-7 py-5">
            <div class="mb-2 flex shrink-0 items-center gap-2.5">
              <img src={c.logo} alt="" width="26" height="26" class="h-[1.625rem] w-[1.625rem] shrink-0" />
              <span class="min-w-0 flex-1">
                <span class="block truncate font-display text-body-md font-bold">{c.who}</span>
                <span class="block truncate text-body-md leading-tight">{c.meta}</span>
              </span>
            </div>
            <p class="mb-2 flex shrink-0 flex-wrap items-center gap-x-2 text-body-md">
              <a href={c.url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 font-display font-semibold">
                {c.verb}
                <svg aria-hidden="true" viewBox="0 0 24 24" class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d={ext} /><path d={ext2} /></svg>
                <span class="sr-only">(opens in a new tab)</span>
              </a>
              {c.rating && <span class="text-hl" aria-label={`${c.rating} out of 5`}><span aria-hidden="true">★★★★★</span></span>}
            </p>
            {c.title && <p class="mb-1 shrink-0 truncate font-display text-body-lg font-bold">{c.title}</p>}
            <div class="local-review-body min-h-0 text-body-lg">
              {c.paras.map((p) => <p class="mb-1.5 whitespace-pre-line last:mb-0">{p}</p>)}
            </div>
            <button type="button" class="local-review-more hidden" data-dialog={`ldlg-${c.id}`}>
              <span class="local-review-more-label">See more →</span>
            </button>
            <dialog id={`ldlg-${c.id}`} class="local-review-dialog card-bina-solid">
              <div class="p-6 sm:p-8">
                <div class="mb-4 flex items-start justify-between gap-4">
                  <span>
                    <span class="block font-display text-body-xl font-bold">{c.who}</span>
                    <span class="block text-body-md">{c.meta}</span>
                  </span>
                  <button type="button" class="local-dialog-close shrink-0 cursor-pointer rounded-full border-2 border-line px-3 py-1 font-display text-body-md font-bold transition-colors hover:bg-lagoon hover:text-black" aria-label="Close">Close</button>
                </div>
                {c.title && <p class="mb-1 font-display text-title-sm">{c.title}</p>}
                <p class="mb-3 text-body-md text-hl" aria-hidden="true">★★★★★</p>
                {c.paras.map((p) => <p class="mb-3 whitespace-pre-line last:mb-0">{p}</p>)}
                <p class="mt-5 text-body-md"><a href={c.url} target="_blank" rel="noopener noreferrer" class="font-display font-semibold">{c.verb} →</a></p>
              </div>
            </dialog>
          </article>
        )
      )}
    </div>
    <p class="mt-6 text-body-lg">More, word for word, on <a href="/reviews">our reviews page</a>.</p>
  </div>
</section>

<noscript>
  <style>
    .local-wall-cell { height: auto !important; }
    .local-review-body { max-height: none !important; overflow: visible !important; mask-image: none !important; -webkit-mask-image: none !important; }
  </style>
</noscript>

<style is:global>
  /* The /reviews wall card, shorter: 13rem instead of 15rem, two lines of review instead of three. */
  .local-wall-cell { height: 13rem; }
  .local-review-body { line-height: 1.6; max-height: 3.2em; overflow: hidden; }
  .local-review-body.is-faded {
    -webkit-mask-image: linear-gradient(to bottom, #000 0, #000 50%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 0, #000 50%, transparent 100%);
  }
  .local-badge-logo { -webkit-mask: var(--logo) center / contain no-repeat; mask: var(--logo) center / contain no-repeat; }
  .local-review-more {
    position: absolute; left: 1.75rem; right: 1.75rem; bottom: 0; padding: 0.4rem 0 0.9rem;
    cursor: pointer; border: 0; background: var(--card-bg, var(--t-bg)); text-align: left;
    font-family: var(--font-display); font-weight: 700; font-size: 1rem; color: var(--t-fg);
  }
  .local-review-more-label { font-weight: 600; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.2em; transition: text-decoration-thickness 0.15s ease-out; }
  .local-review-more:hover .local-review-more-label { text-decoration-thickness: 3px; }
  .local-review-dialog { width: min(38rem, calc(100vw - 2.5rem)); max-height: min(80vh, 44rem); overflow-y: auto; padding: 0; }
  .local-review-dialog::backdrop { background: rgb(0 0 0 / 0.55); }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.local-review-body').forEach((b) => {
    if (b.scrollHeight > b.clientHeight + 2) b.classList.add('is-faded');
  });
  document.querySelectorAll<HTMLElement>('.local-review-card').forEach((card) => {
    const body = card.querySelector<HTMLElement>('.local-review-body');
    const btn = card.querySelector<HTMLButtonElement>('.local-review-more');
    const dlg = card.querySelector<HTMLDialogElement>('.local-review-dialog');
    if (!body || !btn || !dlg) return;
    if (body.classList.contains('is-faded')) btn.classList.remove('hidden');
    btn.addEventListener('click', () => dlg.showModal());
    dlg.querySelector('.local-dialog-close')?.addEventListener('click', () => dlg.close());
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  });
</script>
