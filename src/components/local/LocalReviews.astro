---
/*
 * Reviews on a /local page (Akis, 2026-11-20; redesigned the same day to sit with the level cards):
 * one dark section, same width as the level cards (max-w-6xl): heading, 4 score tiles, then 6
 * cards in the level cards' colours. Picks come from the market's section data (`items`):
 *   { feature: 'T-016' }                      a LinkedIn / Instagram card from reviews.json `beyond`
 *   { review: 'tp-01' }                       a review from reviews.json
 *   { inline: { source, title, body, … } }    a review not in reviews.json (world-schools.com)
 * Names show as initials, like the main site's /reviews (staging, 2026-11-20). Bodies are verbatim.
 */
import data from '../../data/reviews.json';
import Pending from './Pending.astro';

interface Props {
  section: any;
  theme?: string;
}
const { section } = Astro.props;

const NICHE = 'https://www.niche.com/k12/bina-claymont-de/reviews/';
const sourceUrl: Record<string, string> = {
  niche: NICHE,
  trustpilot: 'https://www.trustpilot.com/review/thebinaschool.com',
  'world-schools': 'https://world-schools.com/schools/bina-school/',
  site: 'https://thebinaschool.com',
};
const sourceVerb: Record<string, string> = {
  niche: 'Verified on Niche',
  trustpilot: 'Verified on Trustpilot',
  'world-schools': 'Verified on world-schools.com',
  site: 'Published on thebinaschool.com',
};
const sourceLogo: Record<string, string> = {
  niche: '/images/logos/niche-black.svg',
  trustpilot: '/images/logos/trustpilot-black.svg',
  'world-schools': '/images/logos/world-schools-black.svg',
  site: '/images/logos/bina-black.svg',
  survey: '/images/logos/bina-black.svg',
};
const BAR = ['niche', 'trustpilot', 'world-schools', 'survey'];
const bar = BAR.map((k) => data.sources.find((s: any) => s.key === k)).filter(Boolean) as any[];

const initials = (name?: string | null) =>
  name ? name.split(/\s+/).filter(Boolean).map((w) => w[0].toUpperCase() + '.').join(' ') : null;
const monthYear = (iso?: string | null) =>
  iso ? new Date(iso + 'T00:00:00Z').toLocaleDateString('en-GB', { month: 'short', year: 'numeric', timeZone: 'UTC' }) : null;

type Card =
  | { kind: 'feature'; logo: string; who: string; platform: string; cta: string; url: string; title: string; detail: string }
  | { kind: 'review'; id: string; logo: string; who: string; meta: string; verb: string; url: string; title?: string; paras: string[]; rating?: number };

const cards: Card[] = (section.items ?? [])
  .map((it: any, i: number): Card | null => {
    if (it.feature) {
      const f: any = data.beyond.find((b: any) => b.notionId === it.feature);
      if (!f) return null;
      return { kind: 'feature', logo: f.logo, who: it.who ?? f.who, platform: f.platform, cta: f.cta, url: f.url, title: it.title ?? f.title, detail: f.detail };
    }
    const r: any = it.review ? data.reviews.find((x: any) => x.id === it.review) : it.inline;
    if (!r) return null;
    const who = initials(r.author) ?? 'A bina parent';
    const when = monthYear(r.date);
    return {
      kind: 'review',
      id: r.id ?? `inline-${i}`,
      logo: sourceLogo[r.source],
      who,
      meta: [r.author ? 'bina parent' : null, r.country, when].filter(Boolean).join(' · '),
      verb: sourceVerb[r.source],
      url: r.url ?? sourceUrl[r.source],
      title: r.title,
      paras: String(r.body).split('\n\n').filter(Boolean),
      rating: r.rating ?? 5,
    };
  })
  .filter(Boolean);

const ext = 'M14 4h6v6M20 4 10.5 13.5';
// Card colours cycle through the level cards' palette, so the wall reads as part of the page.
const CARD_BG = ['#06E1BD', '#E9C9FF', 'var(--color-mint)', 'var(--color-sky-blue)', 'var(--color-lemon)', '#E9C9FF'];
const ext2 = 'M18 14.5V19a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h4.5';
---

<section class="theme-base" data-local-section="reviews">
  <div class="mx-auto max-w-6xl px-5 py-16 sm:py-24">
    <h2 class="max-w-3xl text-balance text-title-3xl text-hl sm:text-display-sm"><Pending text={section.heading} /></h2>
    <p class="mt-4 max-w-3xl text-body-xl"><Pending text={section.intro} /></p>

    <ul class="mt-10 grid grid-cols-2 gap-3 lg:grid-cols-4" aria-label="Where bina is reviewed">
      {bar.map((src) => (
        <li>
          <a href={src.url} target="_blank" rel="noopener noreferrer" class="local-score group flex h-full flex-col justify-between gap-4 rounded-2xl p-5 no-underline">
            <span class="flex items-center justify-between gap-2">
              <span class="flex items-center gap-2 font-display text-body-md font-bold uppercase tracking-[0.06em]">
                <span aria-hidden="true" class="local-badge-logo h-5 w-5 shrink-0 bg-current" style={`--logo:url(${sourceLogo[src.key]})`}></span>
                {src.barLabel}
              </span>
              <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4 shrink-0 opacity-60 transition-opacity group-hover:opacity-100" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d={ext} /><path d={ext2} /></svg>
            </span>
            <span class="font-display text-title-xl font-bold leading-none sm:text-title-2xl">{src.barStat}</span>
            <span class="sr-only">(opens in a new tab)</span>
          </a>
        </li>
      ))}
    </ul>

    <div class="mt-6 grid grid-cols-1 gap-5 md:grid-cols-2 xl:grid-cols-3">
      {cards.map((c, i) => {
        const bg = CARD_BG[i % CARD_BG.length];
        return c.kind === 'feature' ? (
          <div class="local-wall-cell relative flex flex-col overflow-hidden rounded-[1.5rem] p-6 text-black" style={`background:${bg};--card-bg:${bg}`}>
            <span class="local-quote" aria-hidden="true">“</span>
            <p class="relative mb-2 line-clamp-2 shrink-0 font-display text-title-sm font-bold leading-snug">{c.title}</p>
            <div class="local-review-body relative min-h-0 text-body-lg">{c.detail}</div>
            <div class="mt-auto flex items-center gap-3 pt-4">
              <img src={c.logo} alt="" width="36" height="36" class="h-9 w-9 shrink-0 rounded-full bg-white p-1.5" />
              <span class="min-w-0 flex-1">
                <span class="block truncate font-display text-body-md font-bold">{c.who}</span>
                <a href={c.url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-body-md font-semibold">{c.cta}<svg aria-hidden="true" viewBox="0 0 24 24" class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d={ext} /><path d={ext2} /></svg><span class="sr-only">(opens in a new tab)</span></a>
              </span>
            </div>
          </div>
        ) : (
          <article class="local-review-card local-wall-cell relative flex flex-col overflow-hidden rounded-[1.5rem] p-6 text-black" style={`background:${bg};--card-bg:${bg}`}>
            <span class="local-quote" aria-hidden="true">“</span>
            <p class="relative mb-2 flex items-center gap-2 text-body-md">
              {c.rating && <span class="tracking-[0.08em]" aria-label={`${c.rating} out of 5`}><span aria-hidden="true">★★★★★</span></span>}
            </p>
            {c.title && <p class="relative mb-1 line-clamp-2 shrink-0 font-display text-title-sm font-bold leading-snug">{c.title}</p>}
            <div class="local-review-body relative min-h-0 text-body-lg">
              {c.paras.map((p) => <p class="mb-1.5 whitespace-pre-line last:mb-0">{p}</p>)}
            </div>
            <button type="button" class="local-review-more hidden" data-dialog={`ldlg-${c.id}`}>
              <span class="local-review-more-label">Read more</span>
            </button>
            <div class="mt-auto flex items-center gap-3 pt-4">
              <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-black font-display text-body-md font-bold" style={`color:${bg}`} aria-hidden="true">{c.who.startsWith('A ') ? '★' : c.who.replace(/[^A-Z]/g, '').slice(0, 2)}</span>
              <span class="min-w-0 flex-1">
                <span class="block truncate font-display text-body-md font-bold">{c.who}<span class="font-normal"> · {c.meta}</span></span>
                <a href={c.url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-body-md font-semibold">
                  <span aria-hidden="true" class="local-badge-logo h-3.5 w-3.5 shrink-0 bg-current" style={`--logo:url(${c.logo})`}></span>
                  {c.verb}
                  <span class="sr-only">(opens in a new tab)</span>
                </a>
              </span>
            </div>
            <dialog id={`ldlg-${c.id}`} class="local-review-dialog card-bina-solid">
              <div class="p-6 sm:p-8">
                <div class="mb-4 flex items-start justify-between gap-4">
                  <span>
                    <span class="block font-display text-body-xl font-bold">{c.who}</span>
                    <span class="block text-body-md">{c.meta}</span>
                  </span>
                  <button type="button" class="local-dialog-close shrink-0 cursor-pointer rounded-full border-2 border-line px-3 py-1 font-display text-body-md font-bold transition-colors hover:bg-lagoon hover:text-black" aria-label="Close">Close</button>
                </div>
                {c.title && <p class="mb-1 font-display text-title-sm">{c.title}</p>}
                <p class="mb-3 text-body-md text-hl" aria-hidden="true">★★★★★</p>
                {c.paras.map((p) => <p class="mb-3 whitespace-pre-line last:mb-0">{p}</p>)}
                <p class="mt-5 text-body-md"><a href={c.url} target="_blank" rel="noopener noreferrer" class="font-display font-semibold">{c.verb} →</a></p>
              </div>
            </dialog>
          </article>
        );
      })}
    </div>
    <a href="/reviews" class="mt-8 inline-block font-display text-title-sm font-semibold">Read every review, word for word →</a>
  </div>
</section>

<noscript>
  <style>
    .local-wall-cell { height: auto !important; }
    .local-review-body { max-height: none !important; overflow: visible !important; mask-image: none !important; -webkit-mask-image: none !important; }
  </style>
</noscript>

<style is:global>
  /* Score tiles: dark glass, mint text; lagoon on hover. */
  .local-score { background: rgb(255 255 255 / 0.06); color: var(--color-mint); border: 1px solid rgb(255 255 255 / 0.1); transition: background-color 0.2s, color 0.2s, transform 0.2s; }
  .local-score:hover { background: var(--color-lagoon); color: #000; transform: translateY(-2px); text-decoration: none; }
  /* Review cards: one height, a big quote mark, the review fades after four lines. */
  .local-wall-cell { height: 19rem; }
  .local-quote { position: absolute; top: -1.6rem; right: 1rem; font-family: var(--font-display); font-size: 9rem; font-weight: 700; line-height: 1; color: rgb(0 0 0 / 0.08); pointer-events: none; }
  .local-review-body { line-height: 1.5; max-height: 6em; overflow: hidden; }
  .local-review-body.is-faded {
    -webkit-mask-image: linear-gradient(to bottom, #000 0, #000 55%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 0, #000 55%, transparent 100%);
  }
  .local-badge-logo { -webkit-mask: var(--logo) center / contain no-repeat; mask: var(--logo) center / contain no-repeat; }
  .local-review-more { align-self: flex-start; margin-top: 0.35rem; padding: 0; cursor: pointer; border: 0; background: none; font-family: var(--font-display); font-weight: 700; font-size: 1rem; color: #000; }
  .local-review-more-label { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.2em; transition: text-decoration-thickness 0.15s ease-out; }
  .local-review-more:hover .local-review-more-label { text-decoration-thickness: 3px; }
  .local-review-dialog { width: min(38rem, calc(100vw - 2.5rem)); max-height: min(80vh, 44rem); overflow-y: auto; padding: 0; }
  .local-review-dialog::backdrop { background: rgb(0 0 0 / 0.55); }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.local-review-body').forEach((b) => {
    if (b.scrollHeight > b.clientHeight + 2) b.classList.add('is-faded');
  });
  document.querySelectorAll<HTMLElement>('.local-review-card').forEach((card) => {
    const body = card.querySelector<HTMLElement>('.local-review-body');
    const btn = card.querySelector<HTMLButtonElement>('.local-review-more');
    const dlg = card.querySelector<HTMLDialogElement>('.local-review-dialog');
    if (!body || !btn || !dlg) return;
    if (body.classList.contains('is-faded')) btn.classList.remove('hidden');
    btn.addEventListener('click', () => dlg.showModal());
    dlg.querySelector('.local-dialog-close')?.addEventListener('click', () => dlg.close());
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  });
</script>
