<script>
  // Level-card callouts animate once they scroll into view.
  const callouts = document.querySelectorAll<HTMLElement>('[data-local-callout]');
  if (callouts.length && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
    }, { threshold: 0.4 });
    callouts.forEach((c) => io.observe(c));
  } else callouts.forEach((c) => c.classList.add('is-in'));
</script>

<style is:global>
  .local-callout .lc-fill { opacity: 0; transform-box: fill-box; transform-origin: center; transform: scale(0.4); }
  .local-callout.is-in .lc-fill { animation: lcFill 0.5s cubic-bezier(0.3, 1.6, 0.5, 1) forwards; }
  @keyframes lcFill { to { opacity: 1; transform: scale(1); } }
  .local-callout .lc-line { stroke-dasharray: 1; stroke-dashoffset: 1; }
  .local-callout.is-in .lc-line { animation: lcDraw 1.4s ease-out forwards; }
  @keyframes lcDraw { to { stroke-dashoffset: 0; } }
  .local-callout .lc-ring { stroke-dashoffset: var(--lc-c); }
  .local-callout.is-in .lc-ring { animation: lcRing 1.3s cubic-bezier(0.2, 0.8, 0.2, 1) forwards; }
  @keyframes lcRing { to { stroke-dashoffset: var(--lc-off); } }
  .local-callout .lc-bar { width: 0; }
  .local-callout.is-in .lc-bar { animation: lcBar 1s cubic-bezier(0.2, 0.8, 0.2, 1) forwards; }
  @keyframes lcBar { to { width: var(--lc-w); } }
  .local-callout .lc-area, .local-callout .lc-dot { opacity: 0; }
  .local-callout.is-in .lc-area, .local-callout.is-in .lc-dot { animation: lcShow 0.6s ease-out 1.1s forwards; }
  @keyframes lcShow { to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) {
    .local-callout .lc-fill, .local-callout .lc-area, .local-callout .lc-dot { opacity: 1; transform: none; animation: none !important; }
    .local-callout .lc-line { stroke-dashoffset: 0; animation: none !important; }
    .local-callout .lc-ring { stroke-dashoffset: var(--lc-off); animation: none !important; }
    .local-callout .lc-bar { width: var(--lc-w); animation: none !important; }
  }
</style>

<style is:global>
  /* "Where does my child fit?": a black button bar that invites the click. */
  .local-fit { transition: transform 0.2s ease, box-shadow 0.2s ease; }
  .local-fit:not([open]):hover { transform: translateY(-2px); box-shadow: 0 10px 24px rgb(0 0 0 / 0.25); }
  .local-fit[open] { box-shadow: 0 14px 34px rgb(0 0 0 / 0.22); }
  .local-fit[open] .local-fit-btn { border-bottom: 1px solid rgb(255 255 255 / 0.12); }
  .local-fit[open] .local-fit-body { animation: fitOpen 0.35s ease-out; }
  @keyframes fitOpen { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: none; } }
  .local-fit:not([open]) .local-fit-plus { animation: fitPulse 2.4s ease-in-out infinite; }
  @keyframes fitPulse { 0%, 100% { box-shadow: 0 0 0 0 var(--lc); } 50% { box-shadow: 0 0 0 7px transparent; } }
  .local-fit-btn .local-fit-plus { animation-play-state: running; }
  @media (prefers-reduced-motion: reduce) { .local-fit:not([open]) .local-fit-plus { animation: none; } .local-fit:not([open]):hover { transform: none; } .local-fit[open] .local-fit-body { animation: none; } }
</style>
