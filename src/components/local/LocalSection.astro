---
/*
 * The /local SECTION LIBRARY: renders one section of a market page by its `kind`
 * (src/data/local-markets.json → markets[].sections). Order in the data = order on the page.
 * Any market can use any section; a new kind = one branch here + its data shape.
 *
 * Whole-school sections (accreditations, proof, features, reviews) read the same data as the
 * other go.bina.school pages, so a number or review is never re-typed for /local.
 * Each section uses exactly one theme (global.css "Section themes").
 */
import Pending from './Pending.astro';
import LocalButtons from './LocalButtons.astro';
import LocalEvents from './LocalEvents.astro';
import LocalTuition from './LocalTuition.astro';
import LocalReviews from './LocalReviews.astro';
import BrandText from '../BrandText.astro';
import landing from '../../data/esa-landing.json';
import survey from '../../data/family-survey.json';
import results from '../../data/student-results.json';
import reviewData from '../../data/reviews.json';
import { accreditations, priceRange } from '../../lib/local.js';

interface Props {
  market: any;
  section: any;
  /** The colour of the group this section sits in (set by the page); else the section's own. */
  theme?: string;
}
const { market, section, theme } = Astro.props;
const { school, reviewIds } = landing;

const reviews = section.kind === 'reviews' ? reviewIds.map((id: string) => reviewData.reviews.find((r: any) => r.id === id)).filter(Boolean) : [];
const sourceLabel: Record<string, string> = { niche: 'Niche', trustpilot: 'Trustpilot', site: 'thebinaschool.com' };
const reviewDate = (d?: string) =>
  d ? new Date(d + 'T00:00:00Z').toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' }) : null;

// FAQ answers: a computed price answer, then one optional link phrase inside the answer.
const faqItems =
  section.kind === 'faq'
    ? section.items.map((f: any) => ({ ...f, a: f.priceRange ? f.a.replace('{range}', priceRange(f.priceRange)) : f.a }))
    : [];
const splitLink = (f: any) => {
  if (!f.link || !f.a.includes(f.link.text)) return [{ t: f.a }];
  const at = f.a.indexOf(f.link.text);
  return [{ t: f.a.slice(0, at) }, { t: f.link.text, url: f.link.url }, { t: f.a.slice(at + f.link.text.length) }].filter((s) => s.t);
};

// Numbers inside copy are read from the data files, never retyped: {recommendAvg} {surveyN} {classCap}.
const fill = (t?: string) =>
  String(t ?? '')
    .replaceAll('{recommendAvg}', String(survey.headline.recommendAvg))
    .replaceAll('{surveyN}', String(survey.surveyA.n))
    .replaceAll('{classCap}', String(school.classCap));

// Proof cards: every number is read from the survey / results data. A section picks its cards
// by key (section.cards); without a list it shows the original three.
const rh = results.headline, sh = survey.headline;
const PROOF: Record<string, { value: string; title: string; note: string; link: string; href: string }> = {
  recommend: { value: String(sh.recommendAvg), title: 'Parents would send their friends here', note: `out of 10, ${survey.surveyA.n} families`, link: 'the survey', href: '/family-survey' },
  nps: { value: String(sh.nps), title: 'Net Promoter Score', note: 'the standard measure schools use', link: 'the survey', href: '/family-survey' },
  readGrowth: { value: `+${rh.readGrowthAvg}`, title: 'Points of reading growth in one school year', note: `STAR, ${rh.pairedN} students`, link: 'the results', href: '/student-results' },
  mathGrowth: { value: `+${rh.mathGrowthAvg}`, title: 'Points of math growth in one school year', note: `STAR, ${rh.pairedN} students`, link: 'the results', href: '/student-results' },
  readAtAbove: { value: `${rh.readAtAbovePct}%`, title: 'At or above the national reading benchmark', note: `${rh.readAtAboveN} students, May 2026`, link: 'the results', href: '/student-results' },
  classCap: { value: String(school.classCap), title: "The most children your child's class can hold", note: 'a cap, not an average', link: 'how classes work', href: 'https://thebinaschool.com/education' },
};
const proofCards = section.kind === 'proof' ? (section.cards ?? ['recommend', 'readGrowth', 'classCap']).map((k: string) => PROOF[k]).filter(Boolean) : [];

// FAQ question colours cycle like the ESA pages' FAQ (staging, 2026-11-20).
const FAQ_COLORS = ['clover', 'tangerine', 'lagoon', 'sky-blue', 'mint', 'dragon-fruit'];

const wrap = 'mx-auto max-w-5xl px-5 py-14';
const h2 = 'mb-6 text-title-xl sm:text-title-3xl';
---

{section.kind === 'hero' && (
  <header class="theme-lagoon" data-local-section="hero">
    {/* Same frame as the ESA heroes (max-w-5xl, one left edge with every section below);
        the market photo sits beside the title, facts in two columns, CTA and rating on one row. */}
    <div class="mx-auto max-w-5xl px-5 py-14 sm:py-20">
      <div class="grid items-center gap-8 md:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)]">
        <h1 class="max-w-3xl text-balance text-title-3xl sm:text-display-sm"><Pending text={section.h1} /></h1>
        {market.image && (
          <img
            src={market.image.src}
            alt={market.image.alt}
            width={market.image.width}
            height={market.image.height}
            fetchpriority="high"
            decoding="async"
            class="mx-auto h-auto w-full max-w-[420px] max-md:hidden"
          />
        )}
      </div>
      {section.facts && (
        <ul class="mt-10 grid gap-x-8 gap-y-3 sm:grid-cols-2">
          {section.facts.map((f: string) => (
            <li class="flex items-start gap-3">
              <span class="mt-0.5 grid h-6 w-6 flex-none place-items-center rounded-full bg-deep-ocean font-display text-body-md font-bold text-lagoon" aria-hidden="true">✓</span>
              <span class="font-display font-bold leading-snug"><Pending text={f} /></span>
            </li>
          ))}
        </ul>
      )}
      <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4">
        <LocalButtons market={market} />
        {section.rating && (
          <div class="flex items-center gap-3" data-local-rating>
            <p class="text-title-md text-hl tracking-[0.08em]" role="img" aria-label="5 stars">★★★★★</p>
            <p class="font-display text-title-sm">Rated {survey.headline.recommendAvg} out of 10</p>
            {section.rating.line && <p class="text-body-lg"><Pending text={section.rating.line} /></p>}
          </div>
        )}
      </div>
    </div>
  </header>
)}

{section.kind === 'accreditations' && (
  <section class="theme-black" data-local-section="accreditations">
    <div class:list={[wrap, 'text-center']}>
      <h2 class="mx-auto mb-10 max-w-3xl text-title-xl text-hl sm:text-title-3xl">{accreditations.headline}</h2>
      <ul class="flex flex-wrap items-center justify-center gap-x-14 gap-y-8">
        {accreditations.items.map((a: any) => (
          <li>
            <img
              src={a.image}
              alt={a.name}
              width={a.width}
              height={a.height}
              loading="lazy"
              decoding="async"
              class:list={['h-auto', a.variant === 'wide' ? 'w-[240px] sm:w-[272px]' : 'w-[112px] sm:w-[128px]']}
            />
          </li>
        ))}
      </ul>
      <p class="mx-auto mt-10 max-w-3xl text-body-md"><BrandText text={accreditations.note} /></p>
    </div>
  </section>
)}

{section.kind === 'proof' && (
  <section class={theme ?? 'theme-base'} data-local-section="proof">
    <div class={wrap}>
      {section.heading !== '' && <h2 class={h2}><Pending text={section.heading ?? 'Families rate the school, and the children grow'} /></h2>}
      <div class:list={['grid gap-4', proofCards.length === 2 ? 'sm:grid-cols-2' : 'sm:grid-cols-3']}>
        {proofCards.map((c: any) => (
          <div class="card-bina-solid p-6">
            <p class="font-display text-display-sm text-hl">{c.value}</p>
            <p class="mt-2 font-display text-title-sm">{c.title}</p>
            <p class="mt-1 text-body-md">{c.note} · <a href={c.href}>{c.link}</a></p>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

{section.kind === 'features' && (
  <section class="theme-mint" data-local-section="features">
    <div class={wrap}>
      <h2 class={h2}>What your child gets at <span class="normal-case">bina</span></h2>
      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {school.features.map((f: any) => (
          <li class="card-bina-solid p-6">
            <p class="label-bina mb-3 text-hl">{f.eyebrow}</p>
            <p class="mb-2 font-display text-title-sm">{f.title}</p>
            <p class="text-body-lg"><BrandText text={f.body} /></p>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

{section.kind === 'schoolDay' && (
  <section class="theme-base" data-local-section="school-day">
    <div class={wrap}>
      <h2 class={h2}><Pending text={section.heading} /></h2>
      <ul class="grid gap-3">
        {section.items.map((item: any) => (
          <li class="flex items-start gap-3 text-body-xl">
            <span class="mt-1 grid h-6 w-6 flex-none place-items-center rounded-full bg-lagoon font-display text-body-md font-bold text-black" aria-hidden="true">✓</span>
            {item.href ? <a href={item.href}><Pending text={item.text} /></a> : <Pending text={item.text} />}
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

{section.kind === 'group' && section.title && (
  <section class={theme ?? 'theme-lemon'} data-local-section="group">
    {/* wide: lines up with a full-width block below it (the level cards, max-w-6xl). Each sentence on its own line. */}
    <div class:list={['mx-auto px-5 py-10 sm:py-12', section.wide ? 'max-w-6xl' : 'max-w-5xl']}>
      <h2 class="text-balance text-title-3xl sm:text-display-sm">{section.title.split(/(?<=\.)\s+/).map((t: string) => <span class="sm:block">{t}{' '}</span>)}</h2>
      {section.intro && <p class="mt-3 max-w-3xl text-body-xl"><Pending text={fill(section.intro)} /></p>}
    </div>
  </section>
)}

{section.kind === 'levels' && (
  <section class={theme ?? 'theme-base'} data-local-section="levels">
    <div class="mx-auto grid max-w-6xl grid-cols-1 gap-6 px-5 pb-6 pt-4 md:grid-cols-2">
      {section.levels.map((l: any) => (
        <article class="local-level flex flex-col overflow-hidden rounded-[1.875rem] text-black" style={`background-color:${l.color}`}>
          <div class="local-level-art relative flex flex-col items-center overflow-hidden px-6 pt-10 text-center sm:pt-12">
            <img src={l.art.texture} alt="" aria-hidden="true" loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-cover" style={`opacity:${l.art.textureOpacity ?? 0.3}`} />
            <img src={l.art.ground} alt="" aria-hidden="true" loading="lazy" decoding="async" class="absolute inset-x-0 bottom-0 z-[1] w-full object-cover" style={`opacity:${l.art.groundOpacity ?? 0.5}`} />
            {(l.art.extras ?? []).map((x: any) => (
              <img src={x.src} alt="" aria-hidden="true" loading="lazy" decoding="async" class="absolute z-[3] object-contain" style={`top:${x.top};left:${x.left};width:${x.width}`} />
            ))}
            <div class="relative z-10">
              <h3 class="local-level-title">{l.title}</h3>
              <p class="mt-3 font-display text-title-sm font-bold sm:text-title-md">{l.meta}</p>
              <p class="mx-auto mt-2 max-w-md text-body-xl leading-snug"><Pending text={l.tagline} /></p>
            </div>
            <img src={l.art.kids} alt={l.art.alt ?? ''} loading="lazy" decoding="async" class="relative z-[2] mx-auto mt-6 block h-auto" style={`width:${l.art.kidsWidth ?? '70%'};margin-bottom:${l.art.kidsOffset ?? '-18%'}`} />
          </div>
          <div class="relative z-10 flex flex-1 flex-col gap-6 bg-white/55 px-6 py-8 backdrop-blur-sm sm:px-8">
            {l.blocks && (
              <dl class="flex flex-col">
                {l.blocks.map((bk: any, i: number) => bk.value ? (
                  <div class:list={['flex items-center justify-between gap-4 rounded-2xl bg-black px-6 py-4', i === 0 ? 'mb-7' : 'mt-auto']} style={`color:${l.color}`}>
                    <dt class="label-bina">{bk.label}</dt>
                    <dd class="font-display text-title-lg font-bold leading-none sm:text-title-xl"><Pending text={bk.value} /></dd>
                  </div>
                ) : (
                  <div class:list={['pb-6', i > 0 && !l.blocks[i - 1].value && 'border-t border-black/15 pt-6']}>
                    <dt class="label-bina mb-4">{bk.label}</dt>
                    {bk.items ? (
                      <dd>
                        <ul class="grid gap-3">
                          {bk.items.map((it: string) => (
                            <li class="flex items-start gap-3">
                              <span class="mt-0.5 grid h-6 w-6 flex-none place-items-center rounded-full bg-black font-display text-body-md font-bold" style={`color:${l.color}`} aria-hidden="true">✓</span>
                              <span class="font-display text-title-sm font-medium leading-snug"><Pending text={it} /></span>
                            </li>
                          ))}
                        </ul>
                      </dd>
                    ) : (
                      <dd class="text-body-lg"><Pending text={bk.text} /></dd>
                    )}
                    {bk.more && (
                      <details class="local-more group mt-5">
                        <summary class="inline-flex cursor-pointer list-none items-center gap-2 rounded-full border-2 border-black px-4 py-2 font-display text-body-lg font-bold [&::-webkit-details-marker]:hidden">
                          <span>{bk.more.label}</span>
                          <span class="text-title-sm leading-none transition-transform duration-300 group-open:rotate-45" aria-hidden="true">+</span>
                        </summary>
                        <div class="mt-4 grid gap-5 rounded-2xl bg-white/70 p-5 sm:p-6">
                          {bk.more.groups.map((g: any) => (
                            <div>
                              <p class="mb-2 font-display text-title-sm font-bold">{g.title}</p>
                              {g.items ? (
                                <ul class:list={['grid gap-1 text-body-lg', g.items.length > 4 && 'sm:grid-cols-2 sm:gap-x-6']}>
                                  {g.items.map((it: string) => (
                                    <li class="flex items-start gap-2">
                                      <span class="mt-[0.6em] h-1.5 w-1.5 flex-none rounded-full bg-black" aria-hidden="true"></span>
                                      <span><Pending text={it} /></span>
                                    </li>
                                  ))}
                                </ul>
                              ) : (
                                <p class="text-body-lg"><Pending text={g.text} /></p>
                              )}
                              {g.note && <p class="mt-2 text-body-md"><Pending text={g.note} /></p>}
                            </div>
                          ))}
                        </div>
                      </details>
                    )}
                  </div>
                ))}
              </dl>
            )}
            {l.grades && (
              <div>
              <details class="local-more local-fit group overflow-hidden rounded-2xl bg-black" style={`--lc:${l.color}`}>
                <summary class="local-fit-btn flex cursor-pointer list-none items-center gap-4 px-5 py-4 text-left sm:px-6 sm:py-5 [&::-webkit-details-marker]:hidden">
                  <span class="min-w-0 flex-1">
                    <span class="block font-display text-title-sm font-bold leading-tight sm:text-title-md" style={`color:${l.color}`}>{l.grades.label}</span>
                    {l.grades.sublabel && <span class="mt-1 block text-body-md" style="color:rgb(255 255 255 / 0.75)">{l.grades.sublabel}</span>}
                  </span>
                  <span class="local-fit-plus grid h-10 w-10 flex-none place-items-center rounded-full border-2 transition-transform duration-300 group-open:rotate-180" style={`border-color:${l.color};color:${l.color}`} aria-hidden="true">
                    <svg viewBox="0 0 20 20" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 8l5 5 5-5" /></svg>
                  </span>
                </summary>
                <div class="local-fit-body px-5 pb-6 sm:px-6 sm:pb-7">
              {l.grades.callout && (() => {
                const c = l.grades.callout;
                // Primary = gaps closed (share who grew + points gained); middle = moving ahead (reading vs the US average by time at bina). All numbers from student-results.json.
                return (
                  <div class="local-callout relative pt-6" style={`--lc:${l.color};color:${l.color}`} data-local-callout>
                    <p class="label-bina mb-3" style="color:rgb(255 255 255 / 0.6)">{c.eyebrow}</p>
                    <p class="font-display text-title-lg font-bold leading-tight sm:text-title-xl">{c.title}</p>
                    <p class="mt-2 max-w-sm text-body-lg" style="color:rgb(255 255 255 / 0.85)"><Pending text={c.text} /></p>
                    {c.kind === 'gaps' && (() => {
                      // Whole-school STAR numbers (student-results.json): share who grew in reading, and points gained.
                      const grew = rh.readGrewPct, R = 40, C = 2 * Math.PI * R;
                      const bars = [
                        { label: 'Reading', v: rh.readGrowthAvg },
                        { label: 'Math', v: rh.mathGrowthAvg },
                      ];
                      const vmax = Math.max(...bars.map((x) => x.v));
                      const p1 = results.levels.find((x: any) => x.level === 'P1');
                      return (
                        <div class="mt-6">
                          <div class="flex items-center gap-5 sm:gap-6">
                            <svg viewBox="0 0 100 100" class="h-28 w-28 flex-none -rotate-90 sm:h-32 sm:w-32" role="img" aria-label={`${grew}% grew in reading`}>
                              <circle cx="50" cy="50" r={R} fill="none" stroke="currentColor" stroke-opacity="0.18" stroke-width="12" />
                              <circle cx="50" cy="50" r={R} fill="none" stroke="currentColor" stroke-width="12" stroke-linecap="round" class="lc-ring" style={`--lc-c:${C};--lc-off:${C * (1 - grew / 100)}`} stroke-dasharray={C} />
                            </svg>
                            <div>
                              <p class="font-display text-display-sm font-bold leading-none">{grew}%</p>
                              <p class="mt-1 text-body-lg" style="color:#fff">grew in reading</p>
                            </div>
                          </div>
                          <div class="mt-6 grid gap-3">
                            {bars.map((x, i) => (
                              <div class="grid grid-cols-[4.5rem_1fr_auto] items-center gap-3">
                                <span class="text-body-md" style="color:rgb(255 255 255 / 0.7)">{x.label}</span>
                                <span class="h-3 overflow-hidden rounded-full" style="background:rgb(255 255 255 / 0.12)"><span class="lc-bar block h-full rounded-full" style={`background:${l.color};--lc-w:${(x.v / vmax) * 100}%;animation-delay:${0.4 + i * 0.2}s`}></span></span>
                                <span class="font-display text-title-sm font-bold">+{x.v} pts</span>
                              </div>
                            ))}
                          </div>
                          {p1 && <p class="mt-5 rounded-xl px-4 py-3 text-body-md" style="background:rgb(255 255 255 / 0.1);color:#fff"><strong class="font-display" style={`color:${l.color}`}>{p1.readBenchPct}%</strong> of P1 children read at or above the US benchmark.</p>}
                          <p class="mt-4 text-body-md" style="color:rgb(255 255 255 / 0.55)">STAR, {rh.pairedN} students, {results.year} · <a href="/student-results" style="color:rgb(255 255 255 / 0.75)">All results</a></p>
                        </div>
                      );
                    })()}
                    {c.kind === 'ahead' && (() => {
                      // Reading NCE by time at bina (student-results.json tenure); 50 = US national average.
                      const T = results.tenure, W = 300, H = 130, x0 = 14, x1 = W - 40, yTop = 18, yBot = 104;
                      const lo = 48, hi = Math.ceil(Math.max(...T.map((t: any) => t.readNceMean)) + 1);
                      const X = (i: number) => x0 + (i * (x1 - x0)) / (T.length - 1);
                      const Y = (v: number) => yBot - ((v - lo) / (hi - lo)) * (yBot - yTop);
                      const pts = T.map((t: any, i: number) => [X(i), Y(t.readNceMean)]);
                      const line = 'M' + pts.map((q: number[]) => q.join(' ')).join(' L ');
                      const area = `${line} L ${X(T.length - 1)} ${Y(50)} L ${x0} ${Y(50)} Z`;
                      const short = (s: string) => s.replace(' months', ' mo').replace(' years', ' yrs');
                      const m1 = results.levels.find((x: any) => x.level === 'M1');
                      const nAll = T.reduce((a: number, t: any) => a + t.n, 0);
                      return (
                        <div class="mt-6">
                          <svg viewBox={`0 0 ${W} ${H}`} class="block h-auto w-full overflow-visible" role="img" aria-label="Reading scores by time at bina, all above the US national average and rising">
                            <defs>
                              <linearGradient id={`lc-grad-${l.id}`} x1="0" y1="0" x2="0" y2="1">
                                <stop offset="0" stop-color="currentColor" stop-opacity="0.35" />
                                <stop offset="1" stop-color="currentColor" stop-opacity="0.02" />
                              </linearGradient>
                            </defs>
                            <path d={area} fill={`url(#lc-grad-${l.id})`} class="lc-area" />
                            <line x1={x0} y1={Y(50)} x2={x1} y2={Y(50)} stroke="#fff" stroke-opacity="0.45" stroke-width="2" stroke-dasharray="5 5" />
                            <text x={x1 + 6} y={Y(50) + 4} fill="#fff" fill-opacity="0.6" font-size="10" font-family="var(--font-display)">US avg</text>
                            <path d={line} fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" class="lc-line" pathLength="1" />
                            {pts.map((q: number[], i: number) => (
                              <g class="lc-dot">
                                <circle cx={q[0]} cy={q[1]} r={i === pts.length - 1 ? 6 : 4} fill="currentColor" />
                                <text x={q[0]} y={q[1] - 10} text-anchor="middle" fill="currentColor" font-size="12" font-weight="700" font-family="var(--font-display)">+{Math.round(T[i].aboveNational)}</text>
                              </g>
                            ))}
                            <text x={x1 + 12} y={pts[pts.length - 1][1] + 5} fill="currentColor" font-size="13" font-weight="700" font-family="var(--font-display)">bina</text>
                            {T.map((t: any, i: number) => (
                              <text x={X(i)} y={H - 4} text-anchor="middle" fill="#fff" fill-opacity="0.55" font-size="10" font-family="var(--font-display)">{short(t.label)}</text>
                            ))}
                          </svg>
                          <p class="mt-2 text-body-md" style="color:rgb(255 255 255 / 0.6)">Reading points above the US national average, by time at bina</p>
                          {m1 && (
                            <div class="mt-5 grid grid-cols-2 gap-3">
                              <p class="rounded-xl px-4 py-3 text-body-md" style="background:rgb(255 255 255 / 0.1);color:#fff"><strong class="block font-display text-title-md" style={`color:${l.color}`}>{m1.readGrewPct}%</strong>of M1 grew in reading</p>
                              <p class="rounded-xl px-4 py-3 text-body-md" style="background:rgb(255 255 255 / 0.1);color:#fff"><strong class="block font-display text-title-md" style={`color:${l.color}`}>{m1.readBenchPct}%</strong>of M1 at or above benchmark</p>
                            </div>
                          )}
