              <span class="faq-plus flex h-11 w-11 flex-none items-center justify-center transition-transform duration-500 ease-out group-open:rotate-45 md:h-12 md:w-12" aria-hidden="true">+</span>
            </summary>
            <p class="faq-a max-w-3xl pb-5 pr-10 pt-1 md:pb-6 md:pt-2">
              {splitLink(f).map((s: any) => (s.url ? <a href={s.url} rel="noopener"><Pending text={s.t} /></a> : <Pending text={s.t} />))}
            </p>
          </details>
        ))}
      </div>
    </div>
  </section>
)}

