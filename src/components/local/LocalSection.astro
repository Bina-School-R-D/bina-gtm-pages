          { v: `+${rh.mathGrowthAvg}`, t: 'points of math growth', n: `STAR, ${rh.pairedN} students` },
          { v: `${rh.readAtAbovePct}%`, t: 'at or above the US reading benchmark', n: `${rh.readAtAboveN} students, May 2026` },
          // Family survey, not STAR (Akis, 2026-11-23): its own source line, never merged with the STAR cards.
          { v: `${survey.fit.roundedPct}%`, t: 'of families say their child learns differently at bina', n: `bina family survey, ${survey.surveyA.n} families` },
        ].map((x) => (
          <li class="card-bina-solid flex items-center gap-4 p-4 sm:flex-col sm:items-start sm:gap-0 sm:p-6">
            <p class="w-20 flex-none font-display text-title-3xl leading-none sm:w-auto sm:text-title-4xl">{x.v}</p>
            <div class="flex flex-col sm:mt-2 sm:flex-1">
              <p class="font-display text-title-sm leading-snug">{x.t}</p>
              <p class="mt-1 text-body-lg opacity-80 sm:mt-auto sm:pt-3">{x.n}</p>
            </div>
          </li>
        ))}
      </ul>

      {/* 2 · Reading by time at bina (tenure; 50 NCE = US national average). Same animated line
          chart on every screen (Akis, 2026-11-23): a wide one from 1024px, a narrow one with short
          labels below it, so no label drops under 14px. */}
      {(() => {
        const T = results.tenure;
        const lo = 48, hi = Math.ceil(Math.max(...T.map((t: any) => t.readNceMean)) + 1);
        const nAll = T.reduce((a: number, t: any) => a + t.n, 0);
        const short = (s: string) => s.replace(' months', ' mo').replace(' years', ' yrs');
        const chart = (o: { id: string; W: number; H: number; x0: number; x1: number; yTop: number; yBot: number; fs: number; fv: number; r: number; sw: number; label: (s: string) => string; cls: string }) => {
          const X = (i: number) => o.x0 + (i * (o.x1 - o.x0)) / (T.length - 1);
          const Y = (v: number) => o.yBot - ((v - lo) / (hi - lo)) * (o.yBot - o.yTop);
          const pts = T.map((t: any, i: number) => [X(i), Y(t.readNceMean)]);
          const line = 'M' + pts.map((q: number[]) => q.join(' ')).join(' L ');
          const area = `${line} L ${X(T.length - 1)} ${Y(50)} L ${o.x0} ${Y(50)} Z`;
          return (
            <svg viewBox={`0 0 ${o.W} ${o.H}`} class:list={['block h-auto w-full overflow-visible', o.cls]} role="img" aria-label={`Reading above the US national average by time at bina: ${T.map((t: any) => `${t.label} +${Math.round(t.aboveNational)}`).join(', ')}`}>
              <defs>
                <linearGradient id={`rc-grad-${o.id}`} x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0" stop-color="currentColor" stop-opacity="0.3" />
                  <stop offset="1" stop-color="currentColor" stop-opacity="0.02" />
                </linearGradient>
              </defs>
              <path d={area} fill={`url(#rc-grad-${o.id})`} class="rc-area" />
              <line x1={o.x0} y1={Y(50)} x2={o.x1} y2={Y(50)} stroke="#000" stroke-opacity="0.55" stroke-width="2" stroke-dasharray="6 6" />
              <text x={o.x1 + 8} y={Y(50) + o.fs * 0.3} fill="#000" font-size={o.fs} font-family="var(--font-display)">US avg</text>
              <path d={line} fill="none" stroke="currentColor" stroke-width={o.sw} stroke-linecap="round" stroke-linejoin="round" class="rc-line" pathLength="1" />
              {pts.map((q: number[], i: number) => (
                <g class="rc-dot" style={`--d:${0.15 + (i * 1.6) / (T.length - 1)}s`}>
                  <circle cx={q[0]} cy={q[1]} r={i === pts.length - 1 ? o.r + 2 : o.r} fill="currentColor" />
                  <text x={q[0]} y={q[1] - o.r - 8} text-anchor="middle" fill="currentColor" font-size={o.fv} font-weight="700" font-family="var(--font-display)">+{Math.round(T[i].aboveNational)}</text>
                </g>
              ))}
              <text x={o.x1 + 12} y={pts[pts.length - 1][1] + o.fv * 0.3} fill="currentColor" font-size={o.fv} font-weight="700" font-family="var(--font-display)" class="rc-dot" style="--d:1.75s">bina</text>
              {T.map((t: any, i: number) => (
                <text x={X(i)} y={o.H - 6} text-anchor="middle" fill="#000" font-size={o.fs} font-family="var(--font-display)">{o.label(t.label)}</text>
              ))}
            </svg>
          );
        };
        return (
          <div class="local-callout mt-14 text-deep-ocean sm:mt-16" data-local-callout>
            <h3 class="text-title-lg text-black sm:text-title-xl">The longer they stay, the further ahead</h3>
            <p class="mt-2 text-pretty text-body-lg text-black">Reading points above the US national average (50) by time at <span class="normal-case">bina</span>, from STAR: {nAll} students, {results.year}. Measured twice a year with STAR assessments.</p>
            <div class="mt-6">
              {chart({ id: 'sm', W: 360, H: 230, x0: 30, x1: 300, yTop: 40, yBot: 175, fs: 15, fv: 18, r: 5, sw: 4, label: short, cls: 'lg:hidden' })}
              {chart({ id: 'lg', W: 1160, H: 250, x0: 60, x1: 1060, yTop: 36, yBot: 190, fs: 17, fv: 21, r: 6, sw: 5, label: (x) => x, cls: 'max-lg:hidden' })}
            </div>
          </div>
        );
      })()}

    </div>
  </section>
)}

