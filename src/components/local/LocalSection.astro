<script>
  // Level-card callouts animate once they scroll into view.
  const callouts = document.querySelectorAll<HTMLElement>('[data-local-callout]');
  if (callouts.length && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
    }, { threshold: 0.4 });
    callouts.forEach((c) => io.observe(c));
  } else callouts.forEach((c) => c.classList.add('is-in'));
</script>

<script>
  // Phones: level tabs (Primary / Middle) on the level cards and on the results section, kept in
  // sync. One panel shows; switching while scrolled into a panel brings its top back under the tabs.
  const levelSections = [...document.querySelectorAll<HTMLElement>('[data-local-levels]')].map((sec) => ({
    sec,
    tabs: [...sec.querySelectorAll<HTMLButtonElement>('[data-level-tab]')],
    panels: [...sec.querySelectorAll<HTMLElement>('[data-level-panel]')],
    bar: sec.querySelector<HTMLElement>('.local-level-tabs')!,
  }));
  const selectLevel = (id: string, from?: (typeof levelSections)[number], focus = false) => {
    for (const ls of levelSections) {
      ls.tabs.forEach((t) => {
        const on = t.dataset.levelTab === id;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        if (on && focus && ls === from) t.focus();
      });
      ls.panels.forEach((p) => p.classList.toggle('is-active', p.dataset.levelPanel === id));
    }
    if (!from) return;
    const panel = from.panels.find((p) => p.dataset.levelPanel === id);
    const barBottom = from.bar.getBoundingClientRect().bottom;
    if (panel && panel.getBoundingClientRect().top < barBottom) {
      scrollTo({ top: scrollY + panel.getBoundingClientRect().top - barBottom - 8, behavior: 'smooth' });
    }
  };
  for (const ls of levelSections) {
    ls.tabs.forEach((t, i) => {
      t.addEventListener('click', () => selectLevel(t.dataset.levelTab!, ls));
      t.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
        const next = ls.tabs[(i + (e.key === 'ArrowRight' ? 1 : ls.tabs.length - 1)) % ls.tabs.length];
        selectLevel(next.dataset.levelTab!, ls, true);
      });
    });
  }
</script>

