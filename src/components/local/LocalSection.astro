  @keyframes lcRing { to { stroke-dashoffset: var(--lc-off); } }
  .local-callout .lc-bar { width: 0; }
  .local-callout.is-in .lc-bar { animation: lcBar 1s cubic-bezier(0.2, 0.8, 0.2, 1) forwards; }
  @keyframes lcBar { to { width: var(--lc-w); } }
  .local-callout .lc-area, .local-callout .lc-dot { opacity: 0; }
  .local-callout.is-in .lc-area, .local-callout.is-in .lc-dot { animation: lcShow 0.6s ease-out 1.1s forwards; }
  @keyframes lcShow { to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) {
    .local-callout .lc-fill, .local-callout .lc-area, .local-callout .lc-dot { opacity: 1; transform: none; animation: none !important; }
    .local-callout .lc-line { stroke-dashoffset: 0; animation: none !important; }
    .local-callout .lc-ring { stroke-dashoffset: var(--lc-off); animation: none !important; }
    .local-callout .lc-bar { width: var(--lc-w); animation: none !important; }
