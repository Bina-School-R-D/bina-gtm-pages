---
/*
 * Testimonial / review card — extracted from /reviews' wall, where it originally existed as two
 * near-duplicate inline markup blocks (a "feature" card for permissioned thebinaschool.com
 * testimonials, and a "review" card for Niche/Trustpilot reviews). Unified into one component with
 * two variants selected by the presence of the `button` prop:
 *   - No `button`: a short, static blurb (name, source line, source link, optional title, description).
 *   - With `button`: adds a "See more…" pill. The description is CSS `line-clamp-3` — no fixed
 *     pixel/em height, no fade mask. The card's own height is whatever its content needs; it is
 *     NOT forced to match its grid neighbors (an earlier version fixed every card to one height via
 *     a page-level `.wall-cell` class, which caused long reviews' "See more" button to sit
 *     absolutely-positioned on top of the description text — a real bug, not a spacing tweak. Fixed
 *     by removing the fixed height and putting the button back in normal document flow, `mt-4`
 *     (16px) below the description). On load, the component checks whether its own description
 *     actually got clipped by the line-clamp (`scrollHeight > clientHeight`) — only then does the
 *     button appear, opening a native `<dialog>` with the full, untruncated text. A short review
 *     that already fits in 3 lines never gets a button at all.
 *
 * Layout: cards are meant to run in a CSS multi-column (`columns-*`) waterfall, not a uniform-row
 * grid — an equal-height-row grid was tried first and rejected: even with the description fix
 * above, a CSS grid's row height is set by the TALLEST card in that row across every column, so a
 * short card two columns over could force extra dead space below a neighbor before its next card
 * starts, making the vertical gap between stacked cards in one column inconsistent card to card.
 * A `columns-*` container flows items down each column independently, so the gap between one
 * card's bottom and the next card below it in the same column is always this component's own
 * `mb-4` (16px) — never dependent on any other column's height. Each card also carries
 * `break-inside-avoid` so a browser never slices one card's content across two columns.
 * `column-gap` (the *horizontal* gap between columns) is the caller's job — set `gap-4` (16px, to
 * match) on the `columns-*` container itself; `gap` is a valid multi-column property, not just a
 * grid/flex one. Do not swap the container back to `grid` + `items-start` — that was an earlier,
 * insufficient fix for this exact unevenness.
 *
 * Sizes below are the finalized scale for this component specifically — tuned by hand for
 * legibility in a dense review-wall grid — though every value happens to land on an exact step of
 * bina's official type scale, so they're now expressed as tokens (`text-small`/`text-body-3`):
 *   name 16px (`Small`), source line 16px (`Small`), source-link text 16px (`Small`), description
 *   18px (`Body3`), button text 16px (`Small`).
 * The description paragraph keeps an explicit `leading-[1.6]` alongside `text-body-3` rather than
 * accepting that token's baked 100% line-height — a deliberate, sitewide exception (see CLAUDE.md
 * "Typography"): 100% line-height reads fine for a single line of text, but visibly cramps a
 * genuinely wrapping, multi-line paragraph like this one (`line-clamp-3`). The "See more" dialog's
 * own full-text paragraphs keep the same override for the same reason.
 * **Known, pre-existing inconsistency, not introduced by this token migration:** the dialog view
 * renders `name` and `title` one tier larger than the card view does (`Body3`/18px and
 * `Body2`/20px respectively, vs. the card's `Small`/16px for both) — this was already true before
 * tokens existed and is preserved exactly as-is here, not resolved, since picking one size is a
 * design call this migration didn't make on its own.
 *
 * Button color is a deliberate, documented exception to the sitewide brand rule ("no text is
 * yellow") — see the CLAUDE.md catalog entry for this component. Do not "fix" it back to black
 * text or flag it in a future review; it was chosen and approved specifically for this button.
 *
 * `tint` sets the card's own background AND (via `TINT_TEXT_CLASS`) the full-review dialog's text
 * color — the two always match, since the dialog is part of the same card's content, just shown in
 * a native `<dialog>` instead of truncated inline. Per Rule 15 (CLAUDE.md), every `CardTestimonial`
 * in one grid is expected to use the SAME `tint` (the section's one accent) — the prop still
 * accepts any of the 8 colors so the component itself stays reusable for a future section with a
 * different single accent, but the *caller* is responsible for passing one consistent value across
 * a whole grid, not varying it per card. `/reviews` used to vary `tint` per card and solve accent
 * adjacency between neighbors offline (see this component's old catalog entry) — that entire
 * mechanism is gone now that every card in a grid shares one tint; there's no adjacency to solve
 * when nothing is adjacent-but-different.
 */

import UiLink from './ui_link.astro';

export interface TestimonialButtonProps {
  /** Defaults to "See more…". */
  label?: string;
}

export interface Props {
  name: string;
  /** e.g. "LinkedIn · she is also a psychologist" or "bina parent · US · May 2024". */
  sourceLabel: string;
  /** e.g. "Read it on LinkedIn" / "Verified on Trustpilot". */
  sourceLinkLabel: string;
  sourceLinkHref: string;
  logo: string;
  logoAlt?: string;
  tint: 'grass' | 'yellow' | 'purple' | 'pink' | 'green' | 'blue' | 'red' | 'orange';
  title?: string;
  /** Plain text; `\n\n` splits into paragraphs (matches the source data's own convention). */
  description: string;
  /** 1–5. Visual is always five filled stars (existing site convention) — only the aria-label reflects the real number. */
  rating?: number;
  /** Omit for the static (no expand) variant. */
  button?: TestimonialButtonProps;
  /** Passed through to the card root — e.g. this repo's `.wall-cell` fixed-height grid class. */
  class?: string;
  /** Any other attribute (e.g. `data-role`, `data-themes`) passes through to the card root untouched. */
  [key: `data-${string}`]: string | undefined;
}

const {
  name,
  sourceLabel,
  sourceLinkLabel,
  sourceLinkHref,
  logo,
  logoAlt = '',
  tint,
  title,
  description,
  rating,
  button,
  class: className,
  ...rest
} = Astro.props;

const TINT_CLASS: Record<Props['tint'], string> = {
  grass: 'bg-bina-grass',
  yellow: 'bg-bina-yellow',
  purple: 'bg-bina-purple',
  pink: 'bg-bina-pink',
  green: 'bg-bina-green',
  blue: 'bg-bina-blue',
  red: 'bg-bina-red',
  orange: 'bg-bina-orange',
};
// The full-review dialog sits on a solid #000 background (Rule 1 — text on dark always takes an
// accent), so its text follows the SAME `tint` the card itself uses — Rule 14 (one accent per
// section, applied everywhere within it). This used to be hardcoded to `text-bina-grass`
// regardless of the card's own tint, which was fine back when every card in a grid used a
// different tint anyway (nothing to be consistent WITH), but stopped being correct once Rule 15
// pushed testimonial grids to one uniform accent per section — see CLAUDE.md's `CardTestimonial`
// entry.
const TINT_TEXT_CLASS: Record<Props['tint'], string> = {
  grass: 'text-bina-grass',
  yellow: 'text-bina-yellow',
  purple: 'text-bina-purple',
  pink: 'text-bina-pink',
  green: 'text-bina-green',
  blue: 'text-bina-blue',
  red: 'text-bina-red',
  orange: 'text-bina-orange',
};

const paras = description.split('\n\n').filter(Boolean);
const gid = `testimonial-${Math.random().toString(36).slice(2, 9)}`;
---

<article
  class:list={[
    'testimonial-card card_base mb-4 flex flex-col break-inside-avoid px-7 py-5',
    TINT_CLASS[tint],
    className,
  ]}
  {...rest}
>
  <div class="mb-2 flex shrink-0 items-center gap-2.5">
    <img
      src={logo}
      alt={logoAlt}
      width="40"
      height="40"
      class="h-10 w-10 shrink-0 rounded-full"
      loading="lazy"
    />
    <span class="min-w-0 flex-1">
      <span class="block truncate font-display text-small font-bold text-coal-black">{name}</span>
      <span class="block truncate text-small text-coal-black">{sourceLabel}</span>
    </span>
  </div>

  <p class="mb-2 flex shrink-0 flex-wrap items-center gap-x-2 text-small">
    <UiLink href={sourceLinkHref} cardFill="accent" class="inline-flex items-center gap-1 !font-bold">
      {sourceLinkLabel}
      <svg
        aria-hidden="true"
        viewBox="0 0 24 24"
        class="h-3 w-3"
        fill="none"
        stroke="currentColor"
        stroke-width="2.6"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M14 4h6v6M20 4 10.5 13.5" />
        <path d="M18 14.5V19a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h4.5" />
      </svg>
      <span class="sr-only">(opens in a new tab)</span>
    </UiLink>
    {rating && (
      <span class="text-coal-black" aria-label={`${rating} out of 5`}>
        <span aria-hidden="true">★★★★★</span>
      </span>
    )}
  </p>

  {title && (
    <p class="mb-1 line-clamp-2 shrink-0 font-display text-small font-bold text-coal-black">
      {title}
    </p>
  )}

  <p class="testimonial-body line-clamp-3 whitespace-pre-line text-body-3 leading-[1.6] text-coal-black">
    {description}
  </p>

  {button && (
    <>
      <button type="button" class="testimonial-more mt-4 hidden self-start" data-dialog={`dlg-${gid}`}>
        {button.label ?? 'See more…'}
      </button>

      <dialog id={`dlg-${gid}`} class="testimonial-dialog card_base">
        <div class="p-6 sm:p-8">
          <div class="mb-4 flex items-start justify-between gap-4">
            <span>
              <span class:list={['block font-display text-body-3 font-bold', TINT_TEXT_CLASS[tint]]}>{name}</span>
              <span class:list={['block text-small', TINT_TEXT_CLASS[tint]]}>{sourceLabel}</span>
            </span>
            <button
              type="button"
              class="dialog-close shrink-0 cursor-pointer rounded-full border-2 border-coal-black bg-white px-3 py-1 font-display text-small font-bold text-coal-black transition-colors hover:bg-bina-pink"
              aria-label="Close"
              >Close</button
            >
          </div>
          {title && <p class:list={['mb-1 font-display text-body-2 font-bold', TINT_TEXT_CLASS[tint]]}>{title}</p>}
          {rating && (
            <p class:list={['mb-3 text-small', TINT_TEXT_CLASS[tint]]} aria-label={`${rating} out of 5`}>
              <span aria-hidden="true">★★★★★</span>
            </p>
          )}
          <div class:list={['text-body-3 leading-[1.6]', TINT_TEXT_CLASS[tint]]}>
            {paras.map((p) => (
              <p class="mb-3 last:mb-0 whitespace-pre-line">{p}</p>
            ))}
          </div>
          <p class="mt-5 text-small">
            <UiLink href={sourceLinkHref} cardFill="dark" accentColor={tint as Exclude<Props['tint'], 'yellow'>} class="!font-bold">
              {sourceLinkLabel} →
            </UiLink>
          </p>
        </div>
      </dialog>
    </>
  )}
</article>

<style>
  /* Truncation is pure CSS line-clamp (line-clamp-3, on the element in the markup above) — no
     fixed pixel/em height, no JS-measured mask. A card's height is therefore whatever its content
     needs: header + source line + optional title + up to 3 lines of description + (when present)
     the button, 16px below the description in normal flow. Cards are NOT forced to a uniform
     height across the grid — see CLAUDE.md's "layout" note on this component's catalog entry for
     why, and don't reintroduce a fixed height on `.testimonial-card` or the page's old `.wall-cell`. */

  /* Normal document flow, 16px (mt-4) below the description — never absolutely positioned over
     text. Black fill + lemon text is a deliberate, approved exception to the sitewide "no yellow
     text" brand rule — see the catalog entry, don't revert this to black text. */
  .testimonial-more {
    cursor: pointer;
    border: none;
    border-radius: 12px;
    background: #000000;
    padding: 0.4rem 0.9rem;
    font-family: 'Rund Display', Arial, sans-serif;
    font-weight: 700;
    font-size: 1rem;
    color: #ffe916;
    white-space: nowrap;
    transition: background-color 0.2s ease-out;
  }
  .testimonial-more:hover {
    background: #1c1c1c;
  }

  /* The full review, in a native dialog — no library, Esc and backdrop close for free. */
  .testimonial-dialog {
    width: min(38rem, calc(100vw - 2.5rem));
    max-height: min(80vh, 44rem);
    overflow-y: auto;
    padding: 0;
    background: #000;
    border-color: #2e2e2e;
  }
  .testimonial-dialog::backdrop {
    background: rgb(0 0 0 / 0.55);
  }
</style>

<script>
  // line-clamp-3 always clips at 3 lines via CSS alone. The only thing JS decides is whether the
  // button should appear at all — only when the description actually got clipped (scrollHeight >
  // clientHeight), never for a short review that already fits in 3 lines.
  document.querySelectorAll<HTMLElement>('.testimonial-card').forEach((card) => {
    const body = card.querySelector<HTMLElement>('.testimonial-body');
    const btn = card.querySelector<HTMLButtonElement>('.testimonial-more');
    const dialog = card.querySelector<HTMLDialogElement>('.testimonial-dialog');
    if (!body || !btn || !dialog) return;

    if (body.scrollHeight > body.clientHeight + 2) btn.classList.remove('hidden');

    btn.addEventListener('click', () => dialog.showModal());
    dialog.querySelector('.dialog-close')?.addEventListener('click', () => dialog.close());
    // click on the backdrop (i.e. outside the panel) closes it too
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
  });
</script>
