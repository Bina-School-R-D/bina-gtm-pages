---
import BaseLayout from '../layouts/BaseLayout.astro';

// Internal hub — add every new page here so the team can find it.
const pages = [
  {
    href: '/esa-guide',
    title: 'ESA Funding for bina — Parent Guide',
    desc: 'State-by-state ESA finder: program, award amount, payment model, and how to apply.',
    tag: 'Growth',
  },
];
---

<BaseLayout
  title="bina GTM pages"
  description="Growth, marketing, and sales-enablement pages for bina."
  noindex={true}
>
  <div class="mx-auto max-w-4xl px-5 py-16">
    <p class="pill-bina mb-6 text-sm">Internal directory</p>
    <h1 class="mb-4 text-4xl sm:text-5xl">GTM pages</h1>
    <p class="mb-10 max-w-2xl text-lg text-coal-900">
      Growth, marketing, and sales-enablement pages for bina. This directory is noindexed — the
      individual pages are the public artifacts.
    </p>
    <div class="grid gap-4">
      {
        pages.map((p) => (
          <a href={p.href} class="card-bina block p-6 no-underline transition-colors hover:bg-bina-yellow/20">
            <span class="pill-bina mb-2 text-xs">{p.tag}</span>
            <h2 class="mb-1 text-xl">{p.title}</h2>
            <p class="text-[15px] text-coal-900">{p.desc}</p>
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>
