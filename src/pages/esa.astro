---
/*
 * /esa — the chooser across the six states where bina can accept state funding (West Virginia
 * added 2026-11-09).
 *
 * Rebuilt 2026-11-04 from the Notion 'Main ESA page: content draft (/esa)' (restructured Nov 2
 * after Akis's feedback): hero → choose your state (approved cards, then coming soon, then
 * other ways to use state funding, all together) → how it works → getting to know bina →
 * CTA → FAQ. Only the five approved states are pages; the 45 others redirect here
 * (astro.config.mjs), and the coming-soon and other-ways states are text, never links to a
 * redirect.
 */
import Accordion from '../components/Accordion.astro';
import BrandText from '../components/BrandText.astro';
import CtaBlock from '../components/CtaBlock.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import landing from '../data/esa-landing.json';
import { CTA, CTA_LABEL, chooserStates, stateSlug } from '../lib/esa-states.js';

const { index: c } = landing;
const states = chooserStates();
// Valid destinations for the legacy ?state= redirect below.
const slugs = Object.fromEntries(states.map((s) => [stateSlug(s.state), true]));
// Six cards: two rows of three (md and up).
const span = (_i) => 'md:col-span-2';
// Each other-ways line stands alone in its row now, so it starts with a capital.
const sentence = (t) => t.charAt(0).toUpperCase() + t.slice(1);
---

<BaseLayout
  title="ESA Funding for bina — The Six States We Can Accept"
  description="bina can take state education funding in Arizona, New Hampshire, Idaho, Utah, West Virginia and Wyoming. Pick your state for the award, the deadlines and the whole process."
  ctaHref={CTA}
  ctaLabel={CTA_LABEL}
>
  <header class="theme-lagoon">
    <div class="mx-auto max-w-5xl px-5 py-16 sm:py-20">
      <h1 class="mb-5 max-w-3xl text-title-3xl sm:text-display-sm">
        Use your state's ESA toward a bina education
      </h1>
      <p class="mb-10 max-w-2xl text-body-xl"><BrandText text={c.line} /></p>
      <ul class="grid gap-3 sm:grid-cols-3">
        {
          c.checks.map((g) => (
            <li class="flex items-start gap-3">
              <span
                class="mt-0.5 grid h-6 w-6 flex-none place-items-center rounded-full bg-deep-ocean font-display text-body-md font-bold text-lagoon"
                aria-hidden="true"
              >
                ✓
              </span>
              <span class="font-display font-bold leading-snug">{g}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </header>

  <!-- choose your state: the six approved-state cards -->
  <section class="theme-base">
    <div class="mx-auto max-w-5xl px-5 py-14">
      <h2 class="mb-3 text-title-xl sm:text-title-3xl">{c.findTitle}</h2>
      <p class="mb-10 max-w-3xl text-pretty">{c.findLine}</p>

      <h3 class="mb-5 font-display text-title-lg font-bold">{c.approvedTitle}</h3>
      <ul class="grid list-none gap-4 p-0 md:grid-cols-6">
        {
          states.map((s, i) => (
            <li class={span(i)}>
              <!-- The card itself doesn't react to hover; only the link at the bottom fades, like every
                   other link (Zeyu, 2026-11-06). -->
              <!-- The Notion table's columns, word for word (2026-11-09): program, award, what you pay,
                   when to apply and how bina gets paid. The "when" text is too long for a tag, so it
                   is a row like the others. -->
              <div class="card-bina-mint flex h-full flex-col p-6">
                <strong class="mb-1 block font-display text-title-lg font-bold text-hl">{s.state}</strong>
                <span class="mb-4 block font-display text-body-lg font-bold">{s.program.prog}</span>
                <span class="mb-5 grid gap-2 text-body-lg">
                  <span class="flex flex-wrap items-baseline gap-x-2">
                    <strong class="font-display text-title-md font-bold text-hl">{s.card.award}</strong>
                    <span class="font-display font-medium text-hl">per child, per year</span>
                  </span>
                  {s.card.awardNote && <span class="font-display font-medium text-hl">{s.card.awardNote}</span>}
                  <span><strong class="font-bold">You pay:</strong> <span class="font-display font-medium">{s.card.pay}</span></span>
                  <span><strong class="font-bold">When to apply:</strong> <span class="font-display font-medium">{s.card.when}</span></span>
                  <span><strong class="font-bold">How <span class="normal-case">bina</span> gets paid:</strong> <span class="font-display font-medium">{s.card.paid}</span></span>
                </span>
                <a href={`/esa/${s.slug}`} class="mt-auto self-start font-bold underline decoration-2 underline-offset-4">
                  bina for {s.card.linkName ?? s.state} families →
                </a>
              </div>
            </li>
          ))
        }
      </ul>
      <p class="mt-5 text-body-lg">{c.approvedNote}</p>
    </div>
  </section>

  <!-- "Other ways to use your state's funding", in its own mint band directly under the approved
       cards, then "Ask us about your state"; "How ESA funding works" follows (Notion, Nov 2/9).
       A state links only to a real page (check-esa-static enforces it). -->
  <section class="theme-mint">
    <div class="mx-auto max-w-5xl px-5 py-14">
      <!-- "Coming soon" was removed on 2026-11-09 (Arkansas stays off until the state confirms). -->
      <div class="max-w-3xl">
        <h3 class="mb-2 font-display text-title-lg font-bold">{c.other.title}</h3>
        <p class="mb-6 text-body-lg"><BrandText text={c.other.line} /></p>
        <dl class="m-0">
          {
            c.other.states.map((st) => (
              <div class="grid gap-x-6 gap-y-1 py-2 sm:grid-cols-[10rem_1fr]">
                <dt class="font-display text-title-sm text-hl">{st.name}</dt>
                <dd class="m-0 text-body-lg">
                  {st.url ? <a href={st.url} class="font-bold underline"><BrandText text={sentence(st.text)} /></a> : <BrandText text={sentence(st.text)} />}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>

      <p class="mt-12 flex items-center gap-3 font-display text-body-xl font-bold">
        <span class="grid h-7 w-7 flex-none place-items-center rounded-full bg-deep-ocean text-body-md text-mint" aria-hidden="true">?</span>
        <span>{c.ask.line} <a href={c.ask.url} class="underline">{c.ask.label}</a></span>
      </p>
    </div>
  </section>

  <!-- how it works -->
  <section class="theme-base">
    <div class="mx-auto max-w-5xl px-5 py-14">
      <h2 class="mb-8 text-title-xl sm:text-title-3xl">{c.howTitle}</h2>
      <ol class="grid gap-6 md:grid-cols-3">
        {
          c.howSteps.map((st, i) => (
            <li class="flex gap-4">
              <span class="grid h-9 w-9 flex-none place-items-center rounded-full bg-lagoon font-display text-body-md font-bold text-black">
                {i + 1}
              </span>
              <span>
                <h3 class="mb-1 text-title-sm"><BrandText text={st.t} /></h3>
                <p class="text-body-lg"><BrandText text={st.d} /></p>
              </span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- getting to know bina: same editorial split as the state pages — heading left,
       each fact as a large statement right, dark section, lagoon heading -->
  <section class="theme-base">
    <div class="mx-auto grid max-w-5xl gap-10 px-5 py-16 md:grid-cols-[1fr_1.6fr] md:gap-16">
      <div>
        <h2 class="text-title-3xl text-lagoon sm:text-display-sm"><BrandText text={c.aboutTitle} /></h2>
      </div>
      <div class="md:pt-2">
        <ul class="m-0 grid list-none gap-5 p-0">
          {c.aboutBullets.map((b) => (
            <li class="font-display text-title-md font-bold sm:text-title-lg">{b}</li>
          ))}
        </ul>
        <!-- "Explore bina →" under the bullets (stakeholder, 2026-11-09), new tab. -->
        <p class="mt-8">
          <a href={c.exploreLink.url} target="_blank" rel="noopener noreferrer" class="font-bold underline">
            <BrandText text={c.exploreLink.label} /><span class="sr-only"> (opens in a new tab)</span>
          </a>
        </p>
      </div>
    </div>
  </section>

  <CtaBlock>
    <h2 class="cta-title mb-8 text-title-xl sm:text-title-3xl"><BrandText text={c.ctaTitle} /></h2>
    <div class="cta-actions">
      <a href={c.callUrl} class="btn-bina-secondary">Book an ESA call</a>
      <a href={CTA} class="btn-bina">{CTA_LABEL}</a>
    </div>
  </CtaBlock>

  <!-- FAQ: the last section before the footer -->
  <section class="theme-base">
    <div class="mx-auto max-w-5xl px-5 py-14">
      <h2 class="mb-8 text-title-xl sm:text-title-3xl">FAQ</h2>
      <Accordion items={c.faq} />
    </div>
  </section>


  <script is:inline define:vars={{ slugs }}>
    // Compatibility only: /esa?state=Arizona was the old shareable deep link. Send those
    // visits to the state's own page, keeping any ?ref= attribution on the URL. A state we
    // no longer serve just stays here — this page is the honest answer for it.
    (function () {
      var url = new URL(location.href);
      var requested = url.searchParams.get('state');
      if (!requested) return;
      var slug = requested.trim().toLowerCase().replace(/\s+/g, '-');
      if (!slugs[slug]) return;
      url.pathname = '/esa/' + slug;
      url.searchParams.delete('state');
      location.replace(url.pathname + url.search + url.hash);
    })();
  </script>
</BaseLayout>
