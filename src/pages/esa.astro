---
/*
 * /esa — the chooser across the five states where bina can accept state funding.
 *
 * It used to be a 50-state dropdown that explained the process. Both jobs moved onto the
 * state pages (hero → how it works → the money → the process → that state's FAQ), so this
 * page has one job: get a family to their state in one click, and give the honest answer to
 * everyone else. The 45 states we cannot serve redirect here (astro.config.mjs).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import landing from '../data/esa-landing.json';
import { CTA, CTA_LABEL, chooserStates, stateSlug } from '../lib/esa-states.js';

const { school, howItWorks } = landing;
const states = chooserStates();
// Valid destinations for the legacy ?state= redirect below.
const slugs = Object.fromEntries(states.map((s) => [stateSlug(s.state), true]));
const names = states.map((s) => s.state);
const nameList = names.slice(0, -1).join(', ') + ' and ' + names[names.length - 1];
---

<BaseLayout
  title="ESA Funding for bina — The Five States We Can Accept"
  description="bina can take state education funding in Arizona, New Hampshire, Idaho, Utah and Wyoming. Pick your state for the award, the deadlines and the whole process."
  ctaHref={CTA}
  ctaLabel="Start your journey"
>
  <header class="theme-lagoon">
    <div class="mx-auto max-w-5xl px-5 py-16 sm:py-20">
      <p class="eyebrow-line mb-5">ESA funding for families</p>
      <h1 class="mb-5 max-w-3xl text-title-3xl sm:text-display-sm">
        Five states can put public education money toward
        <span class="text-deep-ocean">bina</span>
      </h1>
      <p class="mb-8 max-w-2xl text-body-xl">
        {nameList} give families public education dollars — an
        <strong>Education Savings Account</strong> or its equivalent — and bina is approved in all
        five. Pick your state for the award, the deadlines and every step of the process.
      </p>
      <p class="max-w-2xl text-body-lg">
        These are the only states listed, because these are the only states where we can take your
        funding today. We would rather show you five honest pages than fifty hopeful ones.
      </p>
    </div>
  </header>

  <!-- the five states -->
  <section class="theme-base">
    <div class="mx-auto max-w-5xl px-5 py-14">
      <h2 class="mb-3 text-title-xl sm:text-title-3xl">Find your state</h2>
      <p class="mb-8 max-w-2xl">
        Every state runs its own program, with its own money, deadlines and rules. Each page shows
        what your state pays, what is left for you, and who does what at every step.
      </p>

      <ul class="grid list-none gap-4 p-0 md:grid-cols-2">
        {
          states.map((s) => (
            <li>
              <a
                href={`/esa/${s.slug}`}
                class="card-bina-mint flex h-full flex-col p-6 transition-transform hover:-translate-y-0.5"
              >
                <span class="mb-3 flex flex-wrap items-center justify-between gap-2">
                  <strong class="font-display text-title-lg font-bold text-hl">{s.state}</strong>
                  <span class="pill-bina">
                    {s.badge.label}
                  </span>
                </span>
                <span class="mb-4 block font-display text-body-md font-bold">
                  {s.program.prog}
                </span>
                <span class="mb-4 grid gap-2 text-body-md">
                  <span class="flex items-baseline gap-2">
                    <strong class="font-display text-title-md font-bold text-hl">{s.awardLabel}</strong>
                    <span>per child, per year</span>
                  </span>
                  <span>
                    {s.tier === 'reimbursed'
                      ? 'You pay bina, the state pays you back'
                      : `Paid to bina through ${s.program.platform}`}
                  </span>
                </span>
                <span class="mt-auto font-bold underline decoration-2 underline-offset-4">
                  bina for {s.state} families →
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- how it works, once, for everyone -->
  <section class="theme-mint">
    <div class="mx-auto max-w-5xl px-5 py-14">
      <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
        <div>
          <p class="eyebrow-bina mb-2">
            How it works
          </p>
          <h2 class="mb-6 text-title-xl sm:text-title-3xl">{howItWorks.fundingTitle}</h2>
          <ol class="grid gap-5">
            {
              howItWorks.fundingSteps.map((s, i) => (
                <li class="flex gap-4">
                  <span class="grid h-9 w-9 flex-none place-items-center rounded-full bg-deep-ocean font-display text-body-md font-bold text-mint">
                    {i + 1}
                  </span>
                  <span>
                    <h3 class="mb-1 text-title-sm">{s.t}</h3>
                    <p class="text-body-md">{s.d}</p>
                  </span>
                </li>
              ))
            }
          </ol>
          <p class="mt-6 text-body-md">
            Your state's page has the rest: the exact dates, who approves what, and the number you
            are left paying.
          </p>
        </div>
        <div>
          <p class="eyebrow-bina mb-2">
            The school
          </p>
          <h2 class="mb-4 text-title-xl sm:text-title-3xl">{howItWorks.schoolTitle}</h2>
          <p class="mb-6">{howItWorks.schoolLead}</p>
          <ul class="grid gap-3">
            {
              howItWorks.schoolPoints.map((p) => (
                <li class="flex items-start gap-3">
                  <span
                    class="mt-0.5 grid h-6 w-6 flex-none place-items-center rounded-full bg-deep-ocean font-display text-body-sm font-bold text-mint"
                    aria-hidden="true"
                  >
                    ✓
                  </span>
                  <span class="leading-snug">{p}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- the honest answer for every other state -->
  <section class="theme-grape">
    <div class="mx-auto max-w-5xl px-5 py-14">
      <h2 class="mb-3 text-title-xl text-hl sm:text-title-3xl">Not in one of those five states?</h2>
      <p class="mb-4 text-body-xl">
        You can still join bina — families do, from all over the world, with no state funding at all.
        What you cannot do yet is pay us with your state's money.
      </p>
      <p class="mb-8">
        We are working on more states, and new programs are approved most years. Some states require
        a physical campus or locally licensed teachers, which takes longer than paperwork. Email us
        your state and we will tell you straight where it stands — and let you know if that changes.
      </p>
      <div class="flex flex-wrap gap-3">
        <a
          href="mailto:admissions@thebinaschool.com?subject=ESA%20funding%20in%20my%20state"
          class="btn-bina-secondary">Email us about your state</a
        >
        <a href={CTA} class="btn-bina">{CTA_LABEL}</a>
      </div>
    </div>
  </section>

  <p slot="footer-note" class="max-w-2xl text-body-sm">
    Each program is run by its own state, not by bina. Program amounts, eligibility and deadlines are
    set by the state and subject to change — your state's official program site is the final word.
  </p>

  <script is:inline define:vars={{ slugs }}>
    // Compatibility only: /esa?state=Arizona was the old shareable deep link. Send those
    // visits to the state's own page, keeping any ?ref= attribution on the URL. A state we
    // no longer serve just stays here — this page is the honest answer for it.
    (function () {
      var url = new URL(location.href);
      var requested = url.searchParams.get('state');
      if (!requested) return;
      var slug = requested.trim().toLowerCase().replace(/\s+/g, '-');
      if (!slugs[slug]) return;
      url.pathname = '/esa/' + slug;
      url.searchParams.delete('state');
      location.replace(url.pathname + url.search + url.hash);
    })();
  </script>
</BaseLayout>
