---
/*
 * /esa — the state picker index. It no longer renders a state's answer itself: every state
 * is its own static page under /esa/<state>, so a family can be linked straight to theirs
 * and a crawler gets real HTML instead of a dropdown. See CLAUDE.md, "Indexable variants
 * are static pages, not query parameters".
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import EsaHero from '../components/EsaHero.astro';
import EsaPicker from '../components/EsaPicker.astro';
import { stateNames, stateSlug } from '../lib/esa-states.js';

// Valid destinations for the legacy ?state= redirect below.
const slugs = stateNames.map(stateSlug);
---

<BaseLayout
  title="ESA Funding for bina — Parent Guide"
  description="See if your state's Education Savings Account (ESA) can help pay for bina — and the exact steps, from your first call with bina to tuition paid."
>
  <EsaHero>
    <h1 slot="heading" class="mb-5 max-w-3xl text-4xl font-black sm:text-6xl">
      Can an ESA help pay for <span class="underline decoration-bina-yellow decoration-8 underline-offset-4">bina</span>?
    </h1>
  </EsaHero>

  <EsaPicker />

  <p slot="footer-note" class="text-xs text-white/60">
    Program details reflect the latest information available to the bina team and are subject to change — your state's official program site is the final word.
  </p>

  <script define:vars={{ slugs }}>
    // Compatibility only: /esa?state=Arizona was the old shareable deep link. Send those
    // visits to the state's own page and replace the history entry, so Back still works.
    (function () {
      var url = new URL(location.href);
      var requested = url.searchParams.get('state');
      if (!requested) return;
      var slug = requested.trim().toLowerCase().replace(/\s+/g, '-');
      if (slugs.indexOf(slug) === -1) return;
      url.pathname = '/esa/' + slug;
      url.searchParams.delete('state');
      location.replace(url.pathname + url.search + url.hash);
    })();
  </script>
</BaseLayout>
