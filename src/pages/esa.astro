---
import BaseLayout from '../layouts/BaseLayout.astro';
import PillLabel from '../components/sections/pill_label.astro';
import LayoutSequenceSteps from '../components/sections/layout_sequence_steps.astro';
import UiDropdown from '../components/sections/ui_dropdown.astro';
import esaData from '../data/esa-states.json';
import landing from '../data/esa-landing.json';

const { programs, allStates, noProgramNotes } = esaData;

// Every state is listed, so a family never has to guess whether silence means "no" — states
// without a usable program still get an honest answer instead of no answer.
const stateOptions = Array.from(new Set(allStates.concat(programs.map((d) => d.s))))
  .sort()
  .map((name) => ({ value: name, label: name }));

// States that also have a paid-search landing page at /esa/<slug>: the tool links across to
// it so a family who came here for the process can still read the case for the school.
const landingSlugs = Object.fromEntries(landing.states.map((st) => [st.state, st.slug]));

// One high-level journey, shown once under the hero. The per-state tool fills in the detail.
const journey = [
  {
    number: '1',
    title: 'Talk to bina',
    description: 'With bina — book a call, tell us your state, and we’ll confirm your numbers before you apply for anything.',
  },
  {
    number: '2',
    title: "Apply for your state's program",
    description: 'On your state’s site — submit your ESA application. We walk you through exactly what it needs first.',
  },
  {
    number: '3',
    title: 'Get approved & funded',
    description: 'On your state’s site — your state reviews your application and funds your account. Timing varies by state.',
  },
  {
    number: '4',
    title: 'Enroll at bina',
    description: 'With bina — finish admissions and pick a start date. We handle every document your program needs.',
  },
  {
    number: '5',
    title: 'Pay with your funds',
    description: 'Together — pay bina using your ESA funds, directly or by reimbursement depending on your state.',
  },
];
---

<BaseLayout
  title="ESA Funding for bina — Parent Guide"
  description="See if your state's Education Savings Account (ESA) can help pay for bina — and the exact steps, from your first call with bina to tuition paid."
  decorationSet="deco_waterlily"
>
  <!-- hero + journey, one unit -->
  <header class="bg-dark-bg">
    <div class="relative z-[1] mx-auto max-w-6xl px-8 py-[clamp(3rem,6vw,6rem)]">
      <PillLabel text="ESA funding for families" accentColor="grass" class="mb-6" />
      <h1 class="mb-5 max-w-3xl text-hero text-bina-grass">
        Can an ESA help pay for bina?
      </h1>
      <p class="mb-12 max-w-2xl text-body-2 text-bina-grass">
        Many U.S. states give families public education dollars — an
        <strong>Education Savings Account (ESA)</strong> — to spend on approved learning like bina.
        It takes a few steps, and we do them <strong>with you</strong>. Here's the whole path:
      </p>

      <!-- journey: numbered step cards -->
      <LayoutSequenceSteps steps={journey} accentColor="grass" />
    </div>
  </header>

  <!-- state tool -->
  <section class="bg-dark-bg">
    <div class="relative z-[1] mx-auto max-w-6xl px-8 py-[clamp(3rem,6vw,6rem)]">
      <h2 class="mb-8 text-section text-bina-purple">See your state's exact steps</h2>

      <p class="mb-8 max-w-2xl text-body-2 text-bina-purple">
        Every state runs its own program — different money, different deadlines, different rules.
        Pick yours and we'll show you the whole path, tailored to bina. Every state is listed —
        including the ones with no program yet, so you get a straight answer either way. New
        programs launch most years, so it's worth checking back.
      </p>
      <label class="mb-3 block font-display text-body-3 font-bold text-bina-purple">Which state do you live in?</label>
      <div class="relative max-w-md">
        <UiDropdown id="state" ariaLabel="Select your state" placeholder="Select your state…" options={stateOptions} accentColor="purple" fill="none" />
      </div>
      <div id="result" class="mt-8 scroll-mt-24"></div>
    </div>
  </section>

  <p slot="footer-note" class="text-small text-bina-grass">
    Program details reflect the latest information available to the bina team and are subject to change — your state's official program site is the final word.
  </p>

  <style>
    /* page-wide dark background — this page only, not a site-wide toggle */
    :global(body) {
      background: var(--color-dark-bg);
    }
  </style>

  <script define:vars={{ programs, noProgramNotes, landingSlugs }}>
    const WEBSITE = 'https://thebinaschool.com';
    const EMAIL = 'admissions@thebinaschool.com';

    const byState = {};
    programs.forEach((d) => (byState[d.s] = d));

    // Options are rendered at build time (see `stateOptions` in the frontmatter) — this is now
    // a UiDropdown component instance, not a native <select>, but it still exposes `.value` and
    // fires `change`, so the wiring below is unchanged from when this was a native select.
    const sel = document.getElementById('state');

    // One accent (purple/lila) throughout this panel, per Rule 14 — these used to carry
    // per-status fill colors (yellow/blue/grass/orange), which mixed unrelated accents into one
    // section. Now plain labels; every chip/badge shares the same outlined-purple treatment.
    const CHIP = {
      bina: 'with bina',
      state: "on your state's site",
      both: 'together',
    };

    const BADGE = {
      approved: '✓ bina is an approved provider',
      'approved-reimb': '✓ Ready to use for bina',
      'coming-soon': 'Coming soon',
      exploring: 'possible for some families — ask us',
    };

    const PAY_FACT = {
      approved: 'Yes — the state pays bina directly from your account.',
      // Idaho-style: usable today, but the money reaches you rather than us.
      'approved-reimb': 'You pay bina, then the state gets the money back to you — and we give you every receipt and document your claim needs.',
      exploring: "It depends on your approval — we'll know your route and handle it with you.",
    };

    // Third fact tile: "does the state pay bina" is the wrong question for a coming-soon
    // state, so those show where bina's approval actually stands instead.
    const FACT_LABELS = {
      'coming-soon': ['Who the state funds', 'What it’s worth per child', 'Where bina stands'],
      'approved-reimb': ['Who can apply', 'How much for bina', 'How the money works'],
      default: ['Who can apply', 'How much for bina', 'Does the state pay bina directly?'],
    };

    function esc(t) {
      const d = document.createElement('div');
      d.textContent = t;
      return d.innerHTML;
    }

    // Step 5 — pay copy. Definite for approved states; conditional (Akis's ask) otherwise.
    function payStep(d) {
      if (d.status === 'approved') {
        const acct = d.platform ? ' from your ' + d.platform + ' account' : ' from your account';
        return {
          w: 'both',
          t: 'Pay tuition from your account',
          x: 'bina is an approved ' + d.prog + ' provider, so the state pays bina directly' + acct + " — nothing comes out of your pocket. If your award doesn't cover full tuition, you only pay the difference.",
        };
      }
      if (d.status === 'approved-reimb') {
        return {
          w: 'both',
          t: 'Pay bina, then claim it back',
          x: 'You pay bina and claim it back through the ' + d.prog + '. We give you the itemized invoice, enrollment letter and accreditation details every time you need them, so your claim goes in clean and nothing gets held up over paperwork.',
        };
      }
      const acct = d.platform ? ' (from your ' + d.platform + ' account)' : '';
      return {
        w: 'both',
        t: 'Pay tuition — the way your approval allows',
        x:
          'How you pay depends on what your step-3 approval allows, and we handle it with you either way: ' +
          '(a) if it lets bina be paid directly, the state pays us' + acct + " and nothing comes out of your pocket; " +
          "(b) if it only allows reimbursement, you pay bina and we give you the itemized invoice, enrollment letter, and accreditation details to claim it back. " +
          "We'll know which one the moment you're approved.",
      };
    }

    // Coming-soon states get an honest picture instead of a path we can't yet deliver:
    // what the program is, what's in the way, what bina is doing, and what a family can do now.
    function comingSoonSteps(d) {
      const steps = [
        { w: 'state', t: 'The funding is real and worth planning for', x: d.soonWhy, link: { url: d.officialUrl, label: 'See the ' + d.s + ' program ↗' } },
      ];

      // Skip the dates block where the program itself is on hold — there's nothing to diary.
      if (d.applyWindow && !/^on hold/i.test(d.applyWindow))
        steps.push({
          w: 'state',
          t: 'Keep the dates on your radar',
          x: d.applyWindow + ' Applying keeps your state options open — and we’ll tell you straight the moment bina fits into them.',
          link: { url: d.applyUrl, label: 'Apply on the ' + d.s + ' site ↗' },
        });

      steps.push(
        { w: 'bina', t: 'What we’re doing about it', x: d.soonWork },
        {
          w: 'bina',
          t: 'How ' + d.s + ' families join bina today',
          x: 'Plenty of families choose bina without any state funding — small live classes of 6–8 with two teachers, and a real community your child belongs to. Book a call and we’ll be straight with you about timing, cost and exactly where the ' + d.prog + ' stands.',
          cta: 'book',
        },
        {
          w: 'bina',
          t: 'Be first in line when ' + d.s + ' opens',
          x: 'Send us one line saying you’re in ' + d.s + '. When this funding becomes usable at bina, you’ll hear from us before the next application window — not after it closes.',
          cta: 'notify',
        },
      );

      return [{ label: 'Where ' + d.s + ' stands today', steps: steps }];
    }

    function buildSteps(d) {
      if (d.status === 'coming-soon') return comingSoonSteps(d);

      const talk =
        d.status === 'exploring'
          ? { w: 'bina', t: 'Talk to bina first', x: "The " + d.prog + " isn't a guaranteed fit for online schools yet, but families do make it work. Book a call and we'll map whether it works for your family — before you spend anything.", cta: 'book' }
          : { w: 'bina', t: 'Talk to bina first', x: "Book a call and tell us you're using the " + d.prog + ". We'll confirm your numbers, your timing, and exactly what to prepare — so the state steps are quick.", cta: 'book' };

      const apply = {
        w: 'state',
        t: 'Apply for the ' + d.prog,
        x: d.applyWindow,
        link: { url: d.applyUrl, label: 'Apply on the ' + d.s + ' site ↗' },
      };

      const approved = { w: 'state', t: 'Get approved & funded', x: d.approval };

      const enroll = {
        w: 'bina',
        t: 'Enroll at bina',
        x: "Finish admissions and pick a start date. Your bina admissions contact emails you everything your program needs — itemized invoice, enrollment letter, and accreditation details — and answers anything specific your state asks for. You won't have to figure the paperwork out alone.",
      };

      return [
        { label: 'Before you enroll — during bina admissions', steps: [talk, apply, approved] },
        { label: 'After you enroll', steps: [enroll, payStep(d)] },
      ];
    }

    function ctaLink(kind, d) {
      if (kind === 'book')
        return '<a class="mt-2 inline-flex ui_link text-body-3 font-bold text-bina-purple underline decoration-2 underline-offset-2 transition-opacity duration-200 ease-out hover:opacity-70 focus-visible:outline-2 focus-visible:outline-offset-2" href="' + WEBSITE + '">Book a call with bina →</a>';
      if (kind === 'notify')
        return '<a class="mt-2 inline-flex ui_link text-body-3 font-bold text-bina-purple underline decoration-2 underline-offset-2 transition-opacity duration-200 ease-out hover:opacity-70 focus-visible:outline-2 focus-visible:outline-offset-2" href="mailto:' + EMAIL + '?subject=' + encodeURIComponent(d.s + ' funding updates') + '">Email us about ' + esc(d.s) + ' →</a>';
      return '';
    }

    // One consistent treatment for every step, no matter which group it's in: a purple-filled
    // circle (black number, Rule 2), a purple-filled tag with black text (never a per-status
    // fill color — always this one section accent), a heading and a description — separated
    // from the next step by spacing alone (32px, gap-8
    // on the parent <ul>), no divider line and no row background. An earlier pass added
    // alternating #242424/transparent striping to break up the rows, but the circle/heading/tag
    // already carry enough hierarchy on their own — the striping read as arbitrary rather than
    // intentional, so it was removed in favor of generous spacing, matching the sitewide
    // spacing-not-dividers convention (Rule 4).
    //
    // Step DESCRIPTIONS are muted gray (#999999, CLAUDE.md Rule 17's one approved muted-gray
    // value), not purple — a deliberate, page-scoped exception to Rule 1 ("text on dark bg is
    // always an accent, never white/gray"), confirmed with Akis: full-saturation lila reads fine
    // for short text (headings, numbers, tags) but is harder to read at this density for
    // multi-sentence body copy. The color itself used to be a one-off #a8a8a5, hand-picked before
    // Rule 17 existed — now the shared token, same visual intent. Using-gray-at-all here is still
    // NOT a sitewide rule — it's scoped to this one panel's step descriptions only. Don't
    // generalize it to other dark-bg body text elsewhere without asking first.
    function stepRow(step, n, d) {
      const tag = CHIP[step.w];
      const link = step.link
        ? '<a class="mt-2 inline-flex ui_link text-body-3 font-bold text-bina-purple underline decoration-2 underline-offset-2 transition-opacity duration-200 ease-out hover:opacity-70 focus-visible:outline-2 focus-visible:outline-offset-2" href="' + esc(step.link.url) + '" target="_blank" rel="noopener">' + esc(step.link.label) + '</a>'
        : '';
      return (
        '<li class="flex gap-4">' +
        '<span class="grid h-10 w-10 flex-none place-items-center rounded-xl bg-bina-purple font-display text-body-3 font-black text-coal-black">' + n + '</span>' +
        '<span class="min-w-0">' +
        '<span class="mb-0.5 flex flex-wrap items-center gap-2"><strong class="font-display text-body-3 text-bina-purple">' + esc(step.t) + '</strong>' +
        '<span class="inline-flex rounded-full bg-bina-purple px-2.5 py-0.5 font-display text-body-3 font-bold text-coal-black">' + tag + '</span></span>' +
        '<span class="block text-body-3 text-muted-gray">' + esc(step.x) + '</span>' +
        (step.cta ? ctaLink(step.cta, d) : '') +
        link +
        '</span></li>'
      );
    }

    function groupLabel(text) {
      return '<li class="mb-1 font-display text-body-3 font-bold uppercase text-muted-gray">' + text + '</li>';
    }

    // Facts sit directly on the black results panel (Rule 17 — no nested facts card). Labels are
    // text-muted-gray (secondary text, Rule 16) — possible specifically because this panel is
    // black, not accent-filled: Rule 2 only forces #000000 text on an *accent* card, a black card
    // has no such constraint, so gray reads correctly here and recedes behind the bold purple value.
    function fact(k, v) {
      return '<div><p class="mb-1 font-display text-body-3 font-bold uppercase text-muted-gray">' + k + '</p><p class="text-body-3 font-bold text-bina-purple">' + esc(v) + '</p></div>';
    }

    // Every state renders into ONE black panel (card_base, no divider lines, no nested card of
    // any color inside it — Rules 4/12/17): purple/lila is the section's single accent throughout,
    // used for primary text, outlines, and the step-number circle fill; black is the neutral base,
    // never a second accent. Secondary text (fact labels, group labels, the closing disclaimer)
    // uses --color-muted-gray (Rule 16) — legible here specifically because the panel is black,
    // not accent-filled (see Rule 17's own writeup for why that distinction matters).
    function render(name) {
      const box = document.getElementById('result');
      if (!name) {
        box.innerHTML = '';
        return;
      }
      const d = byState[name];
      if (!d) {
        const note = (noProgramNotes || {})[name];
        box.innerHTML =
          '<div class="card_base bg-coal-black p-6 sm:p-8">' +
          '<p class="font-display text-body-2 font-black text-bina-purple">' + esc(name) + " doesn't have a program you can use for bina yet.</p>" +
          (note ? '<p class="mt-3 text-body-3 font-bold text-bina-purple">' + esc(note) + '</p>' : '') +
          '<p class="mt-3 text-body-3 text-bina-purple">New programs launch every year — and plenty of bina families enroll privately in the meantime. Talk to us and we’ll flag you the moment ' + esc(name) + ' opens one.</p>' +
          '<div class="mt-6 flex flex-wrap gap-3">' +
          '<a class="ui_button_ghost !px-5 !py-2.5 text-body-3 !border-bina-purple !bg-transparent !text-bina-purple hover:!border-coal-black hover:!bg-bina-purple hover:!text-coal-black active:!border-coal-black active:!bg-bina-purple active:!text-coal-black" href="mailto:' + EMAIL + '?subject=Funding%20options%20in%20' + encodeURIComponent(name) + '">Email us about funding</a>' +
          '<a class="ui_button !px-5 !py-2.5 text-body-3" href="' + WEBSITE + '" target="_blank" rel="noopener">Visit bina to start</a>' +
          '</div></div>';
        return;
      }
      const badgeLabel = BADGE[d.status];
      const soon = d.status === 'coming-soon';
      const labels = FACT_LABELS[d.status] || FACT_LABELS.default;
      let n = 0;
      const stepsHtml = buildSteps(d)
        .map((g) => groupLabel(g.label) + g.steps.map((s) => stepRow(s, ++n, d)).join(''))
        .join('');
      // Funding/status info — the intro/special/boost callouts and the fact grid — sit directly
      // on the black panel now (Rule 17: no nested facts card). Grouped by spacing alone, matching
      // Rule 4's "spacing, not dividers" convention.
      const statusCardParts = [];
      if (soon && d.soonIntro) statusCardParts.push('<p class="mb-6 text-body-3 font-bold text-bina-purple">' + esc(d.soonIntro) + '</p>');
      if (d.special) statusCardParts.push('<p class="mb-6 text-body-3 font-bold text-bina-purple">⚠ ' + esc(d.special) + '</p>');
      statusCardParts.push(
        '<div class="grid gap-y-5 gap-x-8 sm:grid-cols-3">' +
          fact(labels[0], d.who) +
          fact(labels[1], d.howMuch) +
          fact(labels[2], soon ? d.standing : PAY_FACT[d.status]) +
          '</div>'
      );
      if (d.boost) statusCardParts.push('<p class="mt-4 text-body-3 font-bold text-bina-purple">✓ ' + esc(d.boost) + '</p>');
      const statusCard = '<div class="mt-6">' + statusCardParts.join('') + '</div>';
      box.innerHTML =
        '<div class="card_base bg-coal-black p-6 sm:p-8">' +
        // status header
        '<div class="flex flex-wrap items-center justify-between gap-3">' +
        '<div><p class="font-display text-body-1 font-black text-bina-purple">' + esc(d.s) + '</p>' +
        '<p class="text-body-3 font-bold text-bina-purple">' + esc(d.prog) + '</p></div>' +
        '<span class="rounded-full bg-bina-purple px-4 py-1.5 font-display text-body-3 font-bold text-coal-black">' + badgeLabel + '</span></div>' +
        statusCard +
        // numbered steps — one consistent style throughout
        '<ul class="m-0 list-none p-0 mt-6 flex flex-col gap-8">' + stepsHtml + '</ul>' +
        '<p class="mt-6 text-body-3 text-bina-purple">' +
        (soon
          ? 'We update this page the moment ' + esc(d.s) + '’s rules or bina’s status change — so what you read here is where things actually stand today.'
          : 'Funding renews each school year — we send you fresh paperwork every season, so renewing takes minutes.') +
        '</p>' +
        '<div class="mt-6 flex flex-wrap items-center gap-3">' +
        '<a class="ui_button_ghost !px-5 !py-2.5 text-body-3 !border-bina-purple !bg-transparent !text-bina-purple hover:!border-coal-black hover:!bg-bina-purple hover:!text-coal-black active:!border-coal-black active:!bg-bina-purple active:!text-coal-black" href="' + esc(d.officialUrl) + '" target="_blank" rel="noopener">' + esc(d.s) + ' program site ↗</a>' +
        '<a class="ui_button !px-5 !py-2.5 text-body-3" href="' + WEBSITE + '" target="_blank" rel="noopener">Visit bina to start</a>' +
        '<a class="ui_link text-body-3 font-bold text-bina-purple underline decoration-2 underline-offset-2 transition-opacity duration-200 ease-out hover:opacity-70 focus-visible:outline-2 focus-visible:outline-offset-2" href="' + esc(d.binaUrl) + '">bina’s ' + esc(d.s) + ' guide</a>' +
        (landingSlugs[d.s]
          ? '<a class="ui_link text-body-3 font-bold text-bina-purple underline decoration-2 underline-offset-2 transition-opacity duration-200 ease-out hover:opacity-70 focus-visible:outline-2 focus-visible:outline-offset-2" href="/esa/' + landingSlugs[d.s] + '">bina for ' + esc(d.s) + ' families →</a>'
          : '') +
        (soon ? ctaLink('notify', d).replace('mt-2 ', '') : '') +
        '</div>' +
        '<p class="mt-6 text-body-3 text-muted-gray">Numbers and deadlines change every year — the official ' + esc(d.prog) + ' site is the final word.</p>' +
        '</div>';
      box.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    // Keep the URL in sync so a selected state can be shared and deep-linked.
    function setUrl(name) {
      const url = new URL(location.href);
      if (name) url.searchParams.set('state', name);
      else url.searchParams.delete('state');
      history.replaceState(null, '', url);
    }

    sel.addEventListener('change', function () {
      render(this.value);
      setUrl(this.value);
    });

    // Deep link: ?state=Arizona (case-insensitive) selects and renders on load.
    const requested = new URLSearchParams(location.search).get('state');
    if (requested) {
      const match = programs.find((d) => d.s.toLowerCase() === requested.trim().toLowerCase());
      if (match) {
        sel.value = match.s;
        render(match.s);
      }
    }
  </script>
</BaseLayout>
