---
/*
 * /esa — the chooser across the five states where bina can accept state funding.
 *
 * Rebuilt 2026-11-04 from the Notion 'Main ESA page: content draft (/esa)' (restructured Nov 2
 * after Akis's feedback): hero → choose your state (approved cards, then coming soon, then
 * other ways to use state funding, all together) → how it works → getting to know bina →
 * CTA → FAQ. Only the five approved states are pages; the 45 others redirect here
 * (astro.config.mjs), and the coming-soon and other-ways states are text, never links to a
 * redirect.
 */
import Accordion from '../components/Accordion.astro';
import BrandText from '../components/BrandText.astro';
import CtaBlock from '../components/CtaBlock.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import landing from '../data/esa-landing.json';
import { CTA, CTA_LABEL, chooserStates, stateSlug } from '../lib/esa-states.js';

const { index: c } = landing;
const states = chooserStates();
// Valid destinations for the legacy ?state= redirect below.
const slugs = Object.fromEntries(states.map((s) => [stateSlug(s.state), true]));
// Two cards on the first row, three on the second, so no state sits alone (md and up).
const span = (i) => (i < 2 ? 'md:col-span-3' : 'md:col-span-2');
// Each other-ways line stands alone in its row now, so it starts with a capital.
const sentence = (t) => t.charAt(0).toUpperCase() + t.slice(1);
---

<BaseLayout
  title="ESA Funding for bina — The Five States We Can Accept"
  description="bina can take state education funding in Arizona, New Hampshire, Idaho, Utah and Wyoming. Pick your state for the award, the deadlines and the whole process."
  ctaHref={CTA}
  ctaLabel="Start your journey"
>
  <header class="theme-lagoon">
    <div class="mx-auto max-w-5xl px-5 py-16 sm:py-20">
      <p class="eyebrow-line mb-5">{c.kicker}</p>
      <h1 class="mb-5 max-w-3xl text-title-3xl sm:text-display-sm">
        Use your state's ESA toward a <span class="text-deep-ocean">bina</span> education
      </h1>
      <p class="mb-10 max-w-2xl text-body-xl"><BrandText text={c.line} /></p>
      <ul class="grid gap-3 sm:grid-cols-3">
        {
          c.checks.map((g) => (
            <li class="flex items-start gap-3">
              <span
                class="mt-0.5 grid h-6 w-6 flex-none place-items-center rounded-full bg-black font-display text-body-md font-bold text-lagoon"
                aria-hidden="true"
              >
                ✓
              </span>
              <span class="font-display font-bold leading-snug">{g}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </header>

  <!-- choose your state: approved cards, then the two text lists, all together (Akis) -->
  <section class="theme-base">
    <div class="mx-auto max-w-5xl px-5 py-14">
      <h2 class="mb-3 text-title-xl sm:text-title-3xl">{c.findTitle}</h2>
      <p class="mb-10 max-w-3xl text-pretty">{c.findLine}</p>

      <h3 class="mb-5 font-display text-title-lg font-bold">{c.approvedTitle}</h3>
      <ul class="grid list-none gap-4 p-0 md:grid-cols-6">
        {
          states.map((s, i) => (
            <li class={span(i)}>
              <a
                href={`/esa/${s.slug}`}
                class="card-bina-mint flex h-full flex-col p-6 transition-transform hover:-translate-y-0.5"
              >
                <span class="mb-3 flex flex-wrap items-center justify-between gap-2">
                  <strong class="font-display text-title-lg font-bold text-hl">{s.state}</strong>
                  <span class="pill-bina">{s.badge.label}</span>
                </span>
                <span class="mb-4 block font-display text-body-lg font-bold">{s.program.prog}</span>
                <span class="mb-4 grid gap-2 text-body-lg">
                  <span class="flex flex-wrap items-baseline gap-x-2">
                    <strong class="font-display text-title-md font-bold text-hl">{s.awardLabel}</strong>
                    <span>per child, per year</span>
                  </span>
                  <span>
                    <strong class="font-bold">You pay:</strong> {s.payLabel}
                  </span>
                  <span>
                    {s.tier === 'reimbursed'
                      ? 'You pay bina, the state reimburses you'
                      : `Paid to bina through ${s.program.platform}`}
                  </span>
                </span>
                <span class="mt-auto font-bold underline decoration-2 underline-offset-4">
                  bina for {s.state} families →
                </span>
              </a>
            </li>
          ))
        }
      </ul>

    </div>
  </section>

  <!-- the other two lists: their own mint band, directly under the approved cards (Akis: all
       state lists together), so they never read as states that work today. Coming-soon states
       are filled chips; other-ways states are rows with a line under each. Text only — no links
       to redirects (check-esa-static enforces it). -->
  <section class="theme-mint">
    <div class="mx-auto max-w-5xl px-5 py-14">
      <div class="grid gap-12 md:grid-cols-[1fr_1.5fr] md:gap-16">
        <div>
          <h3 class="mb-2 font-display text-title-lg font-bold">{c.soon.title}</h3>
          <p class="mb-6 text-body-lg"><BrandText text={c.soon.line} /></p>
          <ul class="m-0 flex list-none flex-wrap gap-3 p-0">
            {
              c.soon.states.map((st) => (
                <li class="rounded-full bg-deep-ocean px-5 py-2 font-display text-body-xl font-bold text-mint">
                  {st.url ? <a href={st.url} class="underline">{st.name} →</a> : st.name}
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <h3 class="mb-2 font-display text-title-lg font-bold">{c.other.title}</h3>
          <p class="mb-6 text-body-lg"><BrandText text={c.other.line} /></p>
          <dl class="m-0 border-t border-line">
            {
              c.other.states.map((st) => (
                <div class="grid gap-x-6 gap-y-1 border-b border-line py-4 sm:grid-cols-[10rem_1fr]">
                  <dt class="font-display text-title-sm text-hl">{st.name}</dt>
                  <dd class="m-0 text-body-lg">
                    {st.url ? <a href={st.url} class="font-bold underline"><BrandText text={st.text} /> →</a> : <BrandText text={sentence(st.text)} />}
                  </dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>

      <p class="mt-12 flex items-start gap-3 font-display text-body-xl font-bold">
        <span class="mt-0.5 grid h-7 w-7 flex-none place-items-center rounded-full bg-deep-ocean text-body-md text-mint" aria-hidden="true">?</span>
        <span>{c.ask.line} <a href={c.ask.url} class="underline">{c.ask.label}</a></span>
      </p>
    </div>
  </section>

  <!-- how it works -->
  <section class="theme-base">
    <div class="mx-auto max-w-5xl px-5 py-14">
      <h2 class="mb-8 text-title-xl sm:text-title-3xl">{c.howTitle}</h2>
      <ol class="grid gap-6 md:grid-cols-3">
        {
          c.howSteps.map((st, i) => (
            <li class="flex gap-4">
              <span class="grid h-9 w-9 flex-none place-items-center rounded-full bg-lagoon font-display text-body-md font-bold text-black">
                {i + 1}
              </span>
              <span>
                <h3 class="mb-1 text-title-sm"><BrandText text={st.t} /></h3>
                <p class="text-body-lg"><BrandText text={st.d} /></p>
              </span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- getting to know bina: same editorial split as the state pages — heading and link left,
       each fact as a large statement right, dark section, lagoon heading -->
  <section class="theme-base">
    <div class="mx-auto grid max-w-5xl gap-10 px-5 py-16 md:grid-cols-[1fr_1.6fr] md:gap-16">
      <div>
        <h2 class="mb-6 text-title-3xl text-lagoon sm:text-display-sm"><BrandText text={c.aboutTitle} /></h2>
        <a href={c.aboutLinkUrl} target="_blank" rel="noopener" class="text-body-xl font-bold underline">{c.aboutLinkLabel}</a>
      </div>
      <ul class="m-0 grid list-none gap-5 p-0 md:pt-2">
        {c.aboutBullets.map((b) => (
          <li class="font-display text-title-md font-bold sm:text-title-lg">{b}</li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBlock>
    <h2 class="cta-title mb-8 text-title-xl sm:text-title-3xl"><BrandText text={c.ctaTitle} /></h2>
    <div class="cta-actions">
      <a href="#" class="btn-bina-secondary">Book an ESA call</a>
      <a href={CTA} class="btn-bina">{CTA_LABEL}</a>
    </div>
  </CtaBlock>

  <!-- FAQ: the last section before the footer -->
  <section class="theme-base">
    <div class="mx-auto max-w-5xl px-5 py-14">
      <h2 class="mb-8 text-title-xl sm:text-title-3xl">FAQ</h2>
      <Accordion items={c.faq} />
    </div>
  </section>

  <p slot="footer-note" class="max-w-2xl text-body-md">
    Each program is run by its own state, not by bina. Program amounts, eligibility and deadlines are
    set by the state and subject to change — your state's official program site is the final word.
  </p>

  <script is:inline define:vars={{ slugs }}>
    // Compatibility only: /esa?state=Arizona was the old shareable deep link. Send those
    // visits to the state's own page, keeping any ?ref= attribution on the URL. A state we
    // no longer serve just stays here — this page is the honest answer for it.
    (function () {
      var url = new URL(location.href);
      var requested = url.searchParams.get('state');
      if (!requested) return;
      var slug = requested.trim().toLowerCase().replace(/\s+/g, '-');
      if (!slugs[slug]) return;
      url.pathname = '/esa/' + slug;
      url.searchParams.delete('state');
      location.replace(url.pathname + url.search + url.hash);
    })();
  </script>
</BaseLayout>
