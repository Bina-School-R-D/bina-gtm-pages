---
import BaseLayout from '../layouts/BaseLayout.astro';
import esaData from '../data/esa-states.json';

const { programs, allStates } = esaData;

// The bina-led journey — same 5 beats for every state; the tool below fills in the state specifics.
const timeline = [
  {
    who: 'bina',
    t: 'Start with bina',
    d: "Apply or book a call — tell us your state and we'll map your funding.",
  },
  {
    who: 'state',
    t: "Apply for your state's program",
    d: 'We point you to the right portal, window, and documents.',
  },
  {
    who: 'state',
    t: 'Get approved & funded',
    d: 'The state confirms your award and releases the money.',
  },
  {
    who: 'bina',
    t: 'Enroll at bina',
    d: 'Finish admissions and pick your start date.',
  },
  {
    who: 'both',
    t: 'Pay with your funds',
    d: 'Direct from your state account, or reimbursed with our invoices.',
  },
];

const chip = {
  bina: { label: 'with bina', cls: 'bg-bina-yellow' },
  state: { label: "on your state's site", cls: 'bg-bina-blue' },
  both: { label: 'together', cls: 'bg-bina-grass' },
};
---

<BaseLayout
  title="ESA Funding for bina — Parent Guide"
  description="See if your state's Education Savings Account (ESA) can help pay for bina — and the exact steps, from your first call with bina to tuition paid."
>
  <!-- hero -->
  <header class="border-b-2 border-coal-black bg-bina-purple">
    <div class="mx-auto max-w-4xl px-5 py-16 sm:py-20">
      <p class="pill-bina mb-6 text-sm tracking-wide">ESA funding for families</p>
      <h1 class="mb-5 text-4xl font-black sm:text-6xl">
        Can an ESA help pay for <span class="underline decoration-bina-yellow decoration-8 underline-offset-4">bina</span>?
      </h1>
      <p class="max-w-2xl text-lg text-coal-1000 sm:text-xl">
        Many U.S. states now give families public education dollars — an
        <strong>Education Savings Account (ESA)</strong> — to spend on approved learning outside a
        traditional school. Online school tuition, courses, and tutoring are common approved uses.
        Pick your state below to see how the program works <strong>for your case</strong>.
      </p>
    </div>
  </header>

  <!-- journey timeline -->
  <section class="border-b-2 border-coal-black bg-bina-grass/15">
    <div class="mx-auto max-w-6xl px-5 py-12">
      <h2 class="mb-8 text-center text-2xl sm:text-3xl">Five steps, and you're done</h2>
      <ol class="relative grid gap-6 md:grid-cols-5 md:gap-4">
        <span class="absolute left-[21px] top-2 h-[calc(100%-2rem)] w-0.5 bg-coal-black md:left-0 md:top-[22px] md:h-0.5 md:w-full" aria-hidden="true"></span>
        {
          timeline.map((step, i) => (
            <li class="relative flex gap-4 md:block">
              <span class="relative z-10 grid h-11 w-11 flex-none place-items-center rounded-xl border-2 border-coal-black bg-bina-yellow font-display text-xl font-black md:mb-3">
                {i + 1}
              </span>
              <span class="md:block">
                <h3 class="mb-1 text-base leading-snug">{step.t}</h3>
                <p class="mb-2 text-sm text-coal-900">{step.d}</p>
                <span class={`inline-flex rounded-full border-2 border-coal-black px-3 py-0.5 font-display text-xs font-bold ${chip[step.who].cls}`}>
                  {chip[step.who].label}
                </span>
              </span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- state tool -->
  <section>
    <div class="mx-auto max-w-4xl px-5 py-14">
      <p class="mb-2 font-display text-sm font-bold uppercase tracking-widest text-bina-pink">Your state</p>
      <h2 class="mb-3 text-3xl sm:text-4xl">See your state's exact steps</h2>
      <p class="mb-8 max-w-2xl text-coal-900">
        Every state runs its own program — different money, different deadlines, different rules.
        Pick yours and we'll show you the whole path.
      </p>

      <div class="card-bina p-6 sm:p-8">
        <label for="state" class="mb-3 block font-display text-lg font-bold">Which state do you live in?</label>
        <div class="relative">
          <select
            id="state"
            aria-label="Select your state"
            class="w-full cursor-pointer appearance-none rounded-2xl border-2 border-coal-black bg-white px-4 py-4 font-display text-lg font-bold focus-visible:outline-4 focus-visible:outline-bina-pink"
          >
            <option value="">Select your state…</option>
          </select>
          <span class="pointer-events-none absolute right-5 top-1/2 h-3 w-3 -translate-y-[70%] rotate-45 border-b-2 border-r-2 border-coal-black"></span>
        </div>
        <p class="mt-3 text-sm text-coal-900">
          Don't see a program for your state? Many states have none yet — but new ones launch most years.
        </p>
        <div id="result" class="mt-6 scroll-mt-24"></div>
      </div>
    </div>
  </section>

  <p slot="footer-note" class="text-xs text-white/60">
    Program details reflect the latest information available to the bina team and are subject to change — your state's official program site is the final word.
  </p>

  <script define:vars={{ programs, allStates }}>
    const byState = {};
    programs.forEach((d) => (byState[d.s] = d));

    const sel = document.getElementById('state');
    allStates.forEach((name) => {
      const o = document.createElement('option');
      o.value = name;
      o.textContent = byState[name] ? name : name + '  —  no program yet';
      sel.appendChild(o);
    });

    const APPLY_URL = 'https://form.thebinaschool.com/new';

    const CHIP = {
      bina: { label: 'with bina', cls: 'bg-bina-yellow' },
      state: { label: "on your state's site", cls: 'bg-bina-blue' },
      both: { label: 'together', cls: 'bg-bina-grass' },
    };

    const BADGE = {
      approved: { label: '✓ bina is an approved provider', cls: 'bg-bina-grass' },
      pending: { label: 'bina approval in progress', cls: 'bg-white' },
      exploring: { label: 'possible for some families — ask us', cls: 'bg-bina-blue' },
    };

    const PAY_FACT = {
      approved: 'Yes — the state pays bina directly from your account.',
      pending: "Almost — bina's approval is being finalized; until then you may pay and get paid back.",
      exploring: "Not yet — some families get reimbursed instead. We'll check your case first.",
    };

    function esc(t) {
      const d = document.createElement('div');
      d.textContent = t;
      return d.innerHTML;
    }

    function buildSteps(d) {
      const genericDocs = "You'll typically need proof you live in " + d.s + " and your child's basic documents.";
      const funded = d.platform
        ? 'Once approved, your money shows up in your ' + d.platform + ' account.' + (d.payNote ? ' ' + d.payNote : '') + " You don't touch it as cash — you spend it from there."
        : 'Once approved, the program confirms your award and tells you how the money is released.' + (d.payNote ? ' ' + d.payNote : '');
      const before = [
        d.status === 'exploring'
          ? { w: 'bina', t: 'Talk to bina first', x: 'The ' + d.prog + " isn't a one-click fit for online schools yet — but some families make it work through reimbursement. Book a call and we'll map whether it works for your family before you spend anything." }
          : { w: 'bina', t: 'Start with bina', x: "Apply to bina or book a call — and tell us you're using the " + d.prog + ". We'll confirm your numbers, your timing, and exactly what to prepare." },
        { w: 'state', t: 'Apply for the ' + d.prog, x: d.window + ' ' + (d.docs || genericDocs) },
        { w: 'state', t: 'Get approved & funded', x: funded },
      ];
      const payStep =
        d.status === 'approved'
          ? { w: 'both', t: 'Pay tuition from your account', x: 'bina is an approved ' + d.prog + ' provider — the state pays bina directly from your ' + d.platform + " account, so nothing comes out of your pocket. If the award doesn't cover full tuition, you only pay the difference." }
          : d.status === 'pending'
            ? { w: 'both', t: 'Pay tuition with your funds', x: "bina's provider approval with the " + d.prog + ' is being finalized. Depending on timing, the state pays bina directly — or you pay bina and get paid back using our itemized invoice. We confirm your exact route before you commit to anything.' }
            : { w: 'both', t: 'Pay & get paid back (where allowed)', x: 'If your program allows it, you pay bina and submit our itemized invoice to get reimbursed. We confirmed what is possible back in step 1 — no surprises.' };
      const after = [
        { w: 'bina', t: 'Enroll at bina', x: 'Finish admissions and pick a start date. We prepare everything your program asks for: itemized invoices, an enrollment letter, and accreditation details.' },
        payStep,
        { w: 'bina', t: 'Renew every year', x: 'Funding is per school year. We send you fresh paperwork each season so renewing takes minutes.' },
      ];
      return { before, after };
    }

    function stepRow(step, n) {
      const c = CHIP[step.w];
      return (
        '<li class="flex gap-4 border-t-2 border-coal-black bg-white px-5 py-4 sm:px-6">' +
        '<span class="grid h-10 w-10 flex-none place-items-center rounded-xl border-2 border-coal-black bg-bina-yellow font-display text-lg font-black">' + n + '</span>' +
        '<span class="min-w-0">' +
        '<span class="mb-0.5 flex flex-wrap items-center gap-2"><strong class="font-display text-base">' + esc(step.t) + '</strong>' +
        '<span class="inline-flex rounded-full border-2 border-coal-black px-2.5 py-0.5 font-display text-[11px] font-bold ' + c.cls + '">' + c.label + '</span></span>' +
        '<span class="block text-sm text-coal-900">' + esc(step.x) + '</span>' +
        '</span></li>'
      );
    }

    function groupLabel(text) {
      return '<li class="border-t-2 border-coal-black bg-coal-black px-5 py-2 font-display text-xs font-bold uppercase tracking-widest text-bina-yellow sm:px-6">' + text + '</li>';
    }

    function fact(k, v) {
      return '<div class="bg-white p-4 sm:px-6"><p class="mb-1 font-display text-[11px] font-bold uppercase tracking-widest text-coal-900/60">' + k + '</p><p class="text-[15px] font-bold">' + esc(v) + '</p></div>';
    }

    function render(name) {
      const box = document.getElementById('result');
      if (!name) {
        box.innerHTML = '';
        return;
      }
      const d = byState[name];
      if (!d) {
        box.innerHTML =
          '<div class="overflow-hidden rounded-[1.875rem] border-2 border-coal-black">' +
          '<div class="bg-bina-purple/20 px-6 py-5"><p class="font-display text-xl font-black">' + esc(name) + " doesn't have a program you can use for bina yet.</p>" +
          '<p class="mt-2 text-sm text-coal-900">New programs launch every year — and plenty of bina families enroll privately in the meantime. Talk to us and we’ll flag you the moment ' + esc(name) + ' opens one.</p></div>' +
          '<div class="flex flex-wrap gap-3 border-t-2 border-coal-black bg-white px-6 py-5">' +
          '<a class="btn-bina !px-5 !py-2.5 text-sm" href="' + APPLY_URL + '" target="_blank" rel="noopener">Start your bina application</a>' +
          '<a class="btn-bina-ghost !px-5 !py-2.5 text-sm" href="mailto:hello@thebinaschool.com?subject=Funding%20options%20in%20' + encodeURIComponent(name) + '">Email us about funding</a>' +
          '</div></div>';
        return;
      }
      const b = BADGE[d.status];
      const steps = buildSteps(d);
      let n = 0;
      const stepsHtml =
        groupLabel('Before you enroll — during bina admissions') +
        steps.before.map((s) => stepRow(s, ++n)).join('') +
        groupLabel('After you enroll') +
        steps.after.map((s) => stepRow(s, ++n)).join('');
      box.innerHTML =
        '<div class="overflow-hidden rounded-[1.875rem] border-2 border-coal-black">' +
        '<div class="flex flex-wrap items-center justify-between gap-3 bg-bina-yellow px-6 py-5">' +
        '<div><p class="font-display text-2xl font-black">' + esc(d.s) + '</p>' +
        '<p class="text-sm font-bold text-coal-900">' + esc(d.prog) + '</p></div>' +
        '<span class="rounded-full border-2 border-coal-black px-4 py-1.5 font-display text-xs font-bold ' + b.cls + '">' + b.label + '</span></div>' +
        (d.special ? '<div class="border-t-2 border-coal-black bg-bina-orange/25 px-6 py-3 text-sm font-bold">⚠ ' + esc(d.special) + '</div>' : '') +
        '<div class="grid gap-px border-t-2 border-coal-black bg-coal-black sm:grid-cols-3">' +
        fact('Who can apply', d.who) +
        fact('How much per child', d.howMuch) +
        fact('Does the state pay bina directly?', PAY_FACT[d.status]) +
        '</div>' +
        (d.boost ? '<div class="border-t-2 border-coal-black bg-bina-grass/25 px-6 py-3 text-sm font-bold">✓ ' + esc(d.boost) + '</div>' : '') +
        '<ul class="m-0 list-none p-0">' + stepsHtml + '</ul>' +
        '<div class="flex flex-wrap items-center gap-3 border-t-2 border-coal-black bg-white px-6 py-5">' +
        '<a class="btn-bina !px-5 !py-2.5 text-sm" href="' + APPLY_URL + '" target="_blank" rel="noopener">Start your bina application</a>' +
        '<a class="btn-bina-ghost !px-5 !py-2.5 text-sm" href="' + esc(d.officialUrl) + '" target="_blank" rel="noopener">' + esc(d.s) + ' program site ↗</a>' +
        '<a class="font-bold underline decoration-bina-pink decoration-2 underline-offset-4" href="' + esc(d.binaUrl) + '">bina’s ' + esc(d.s) + ' guide</a>' +
        '</div>' +
        '<div class="border-t-2 border-coal-black bg-white px-6 py-3 text-xs text-coal-900/70">Numbers and deadlines change every year — the official ' + esc(d.prog) + ' site is the final word.</div>' +
        '</div>';
      box.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    sel.addEventListener('change', function () {
      render(this.value);
    });
  </script>
</BaseLayout>
