---
import BaseLayout from '../layouts/BaseLayout.astro';
import PillLabel from '../components/sections/pill_label.astro';
import CardTestimonial from '../components/sections/card_testimonial.astro';
import CardPrompt, { PROMPT_CARD_ACCENTS } from '../components/sections/card_prompt.astro';
import PillSource from '../components/sections/pill_source.astro';
import UiLink from '../components/sections/ui_link.astro';
import data from '../data/reviews.json';
import survey from '../data/family-survey.json';

const { headline, sources, reviews, registry, beyond } = data;

// Survey figures live in family-survey.json only, so the two pages can never disagree.
const recommendAvg = survey.headline.recommendAvg;
const nps = survey.headline.nps;
const surveyN = survey.surveyA.n;
const npsTopBand = survey.npsBenchmark.worldClassFrom;

const SITE = 'https://thebinaschool.com';
const NICHE = 'https://www.niche.com/k12/bina-claymont-de/reviews/';
const TRUSTPILOT_WRITE = 'https://www.trustpilot.com/evaluate/thebinaschool.com';

/*
  Narrative order — the three-audience rule (CLAUDE.md):
    hero (one claim, one CTA, and the platform pills carrying each score underneath it, so a
    sceptic can leave and check in a single click) -> the filtered wall, opening with the two
    things parents made unprompted -> the closing CTA. Provenance, exclusions and the caveats live
    in the footer note.

  CTA ladder: "Visit bina" to thebinaschool.com, the same as /esa and /student-results — we want
  the main site to take the enquiry. The review ask is for current families and is deliberately
  demoted to a text link in the hero plus one in-wall card.

  Scanners get the h1, the provider bar and the H2s, each a complete claim. Focused readers get
  two lines under each H2. Detail readers get the source cards, the per-card verify links
  and the methodology expanders. Nothing on this page is written by bina: every quote is
  copied whole from a site we do not control, or from a family who let us quote them.
*/

const WORLD_SCHOOLS = 'https://world-schools.com/schools/bina-school/';

const TRUSTPILOT = 'https://www.trustpilot.com/review/thebinaschool.com';

const sourceUrl: Record<string, string> = {
  niche: NICHE,
  trustpilot: TRUSTPILOT,
  site: SITE,
  'world-schools': WORLD_SCHOOLS,
};
/* The bar carries the three review platforms plus our own survey. thebinaschool.com is not an
   independent site, Instagram/LinkedIn live in their own section further down, and Glassdoor is
   about working here rather than being a family here. */
const BAR = ['niche', 'trustpilot', 'world-schools', 'survey'];
const barSources = BAR.map((key) => sources.find((src) => src.key === key)!);
const sourceLogo: Record<string, string> = {
  niche: '/images/logos/niche.svg',
  trustpilot: '/images/logos/trustpilot.svg',
  'world-schools': '/images/logos/world-schools.svg',
  site: '/images/logos/bina.svg',
  survey: '/images/logos/bina.svg',
};

const sourceInitial: Record<string, string> = {
  niche: 'N',
  trustpilot: 'T',
  site: 'b',
  'world-schools': 'W',
};
const sourceVerb: Record<string, string> = {
  niche: 'Verified on Niche',
  trustpilot: 'Verified on Trustpilot',
  site: 'Published on thebinaschool.com',
  'world-schools': 'Verified on world-schools.com',
};


const niche = reviews.filter((r) => r.source === 'niche');
const site = reviews.filter((r) => r.source === 'site');

// Reviews signed with a real name — the ones the reviewer published under their own name on a
// platform we don't control — lead the wall, because a name earns trust faster than an initial.
const named = reviews.filter((r) => r.author && !r.fullNameWithheld);
const unnamed = reviews.filter((r) => !r.author || r.fullNameWithheld);

// Within the rest, spread the short reviews through the long ones — three long, one short — so no
// column ends up carrying every 1,000-character review while its neighbour runs dry.
const short = unnamed.filter((r) => r.body.length <= 520);
const long = unnamed.filter((r) => r.body.length > 520);
const ordered: typeof reviews = [...named];
let si = 0;
let li = 0;
while (si < short.length || li < long.length) {
  for (let k = 0; k < 3 && li < long.length; k++) ordered.push(long[li++]);
  if (si < short.length) ordered.push(short[si++]);
}

// Two in-wall cards, placed where a reader is warm but not finished.
type WallItem =
  | { kind: 'review'; review: (typeof reviews)[number] }
  | { kind: 'cta'; at: number }
  | { kind: 'feature'; item: (typeof beyond)[number] };
const wall: WallItem[] = [];
// The article and the reel open the wall and stay put under every filter — they are the two
// things a parent made unprompted, and neither is a review, so neither is counted as one.
beyond.forEach((item) => wall.push({ kind: 'feature', item }));
ordered.forEach((review, i) => {
  if (i === 5) wall.push({ kind: 'cta', at: 0 });
  if (i === 13) wall.push({ kind: 'cta', at: 2 });
  if (i === 20) wall.push({ kind: 'cta', at: 1 });
  wall.push({ kind: 'review', review });
});

// Every card in this wall — testimonials and features alike — shares ONE accent (purple) per
// Rule 14 (one accent color per section, applied everywhere within it — the section this whole
// wall belongs to is a single-accent section). There is no per-card tint assignment or adjacency
// solve to do anymore; see card_testimonial.astro's own doc comment for why the old REVIEW_TINTS
// mechanism (a graph-colored array, solved offline against real rendered adjacency) was removed.
const WALL_TINT = 'purple' as const;

// CardPrompt is the deliberate exception to that same rule (CLAUDE.md's CardPrompt entry) — each one
// gets its own accent, assigned by source order from CardPrompt's own PROMPT_CARD_ACCENTS list, never
// repeated within this grid. It also may never use the wall's own accent (WALL_TINT) — a CardPrompt
// needs to read as distinct from the surrounding testimonial grid, not just from its sibling
// CardPrompts — so that color is filtered out before assignment. Count how many CardPrompts this wall
// actually renders and fail the build rather than silently reusing a color if that ever exceeds
// the remaining approved list.
const availablePromptAccents = PROMPT_CARD_ACCENTS.filter((accent) => accent !== WALL_TINT);
const ctaCount = wall.filter((item) => item.kind === 'cta').length;
if (ctaCount > availablePromptAccents.length) {
  throw new Error(
    `/reviews wall has ${ctaCount} CardPrompts but only ${availablePromptAccents.length} approved PROMPT_CARD_ACCENTS colors remain once the wall's own accent (${WALL_TINT}) is excluded — add more approved colors or reduce the number of CardPrompts.`
  );
}

const monthYear = (iso: string | null) =>
  iso
    ? new Date(iso + 'T00:00:00Z').toLocaleDateString('en-GB', {
        month: 'short',
        year: 'numeric',
        timeZone: 'UTC',
      })
    : null;

---

<BaseLayout
  title="bina Reviews — What Families Actually Say About Us"
  description="Every review of bina in one place — 27 verbatim parent and teacher reviews, and links to every independent site where families rate us."
  flushFooter={true}
  decorationSet="deco_leaves"
>
  <!-- hero: one claim, one line, one CTA -->
  <header class="bg-dark-bg">
    <div class="relative z-[1] mx-auto max-w-6xl px-8 py-[clamp(3rem,6vw,6rem)]">
      <PillLabel text="reviews" accentColor="purple" class="mb-6" />
      <h1 class="mb-5 max-w-3xl text-hero text-bina-purple">
        What parents say
        about bina
      </h1>
      <p class="mb-8 max-w-xl text-body-2 text-bina-purple">
        Their words, not ours — every one of them copied whole from a site we don't control.
      </p>
      <a href={SITE} class="ui_button">Visit bina</a>

      <nav aria-label="Where bina is reviewed" class="mt-8">
        <p class="mb-3 font-display text-body-3 font-bold uppercase text-muted-gray">
          As seen on
        </p>
        <ul class="flex flex-wrap items-center gap-2">
          {
            barSources.map((src) => (
              <li>
                <PillSource
                  name={src.barLabel}
                  logo={sourceLogo[src.key]}
                  rating={src.barStat}
                  href={src.url}
                />
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </header>

  <!-- the wall -->
  <section class="bg-dark-bg">
    <div class="relative z-[1] mx-auto max-w-[96rem] px-6 py-8 sm:px-10 sm:py-10">
      <div
        id="review-wall"
        class="columns-1 gap-4 md:columns-2 xl:columns-3 2xl:columns-4"
      >
        {
          (() => {
            let promptCardIndex = 0;
            return wall.map((item) => {
            if (item.kind === 'feature') {
              const f = item.item;
              return (
                <CardTestimonial
                  name={f.who}
                  sourceLabel={f.platform}
                  sourceLinkLabel={f.cta}
                  sourceLinkHref={f.url}
                  logo={f.logo}
                  tint={WALL_TINT}
                  title={f.title}
                  description={f.detail}
                />
              );
            }

            if (item.kind === 'cta') {
              const accentColor = availablePromptAccents[promptCardIndex++];
              if (item.at === 0) {
                return (
                  <CardPrompt
                    icon="star"
                    heading="Already a bina family?"
                    body="Your honest opinion is what the next family reads before they dare to switch."
                    buttonLabel="Write a review"
                    buttonHref={TRUSTPILOT_WRITE}
                    accentColor={accentColor}
                  />
                );
              }
              if (item.at === 2) {
                return (
                  <CardPrompt
                    icon="eye"
                    heading="Reading about it only goes so far."
                    body="See how bina teaches and whether these families are right about us."
                    buttonLabel="Visit bina"
                    buttonHref={SITE}
                    accentColor={accentColor}
                  />
                );
              }
              return (
                <CardPrompt
                  icon="chart"
                  heading="Stories are one thing. Scores are another."
                  body={`${surveyN} families rated us out of 10. We published every score, worst included.`}
                  buttonLabel="See the scores"
                  buttonHref="/family-survey"
                  accentColor={accentColor}
                />
              );
            }

            const r = item.review;
            const tint = WALL_TINT;
            const initial = r.author ? r.author.charAt(0) : sourceInitial[r.source];
            const when = monthYear(r.date);
            const name = r.author ?? (r.role === 'staff' ? 'A bina team member' : 'A bina parent');
            const labelParts: string[] = [];
            if (r.author) {
              if (r.roleLabel) labelParts.push(r.roleLabel);
              if (r.country) labelParts.push(r.country);
              if (when) labelParts.push(when);
            } else {
              if (r.country) labelParts.push(r.country);
              if (when) labelParts.push(when);
              else if (r.roleLabel) labelParts.push(r.roleLabel);
            }

            return (
              <CardTestimonial
                class="review-card"
                name={name}
                sourceLabel={labelParts.join(' · ')}
                sourceLinkLabel={sourceVerb[r.source]}
                sourceLinkHref={sourceUrl[r.source]}
                logo={sourceLogo[r.source]}
                tint={tint}
                title={r.title}
                description={r.body}
                rating={r.rating}
                button={{}}
                data-role={r.role}
                data-themes={r.themes.join(' ')}
              />
            );
          });
          })()
        }
      </div>

    </div>
  </section>


  <!-- CTA -->
  <section class="bg-dark-bg">
    <div class="relative z-[1] mx-auto max-w-4xl px-5 py-16 text-center">
      <h2 class="mb-4 text-section text-bina-grass">
        Read all you like — then come and see for yourself
      </h2>
      <p class="mx-auto mb-8 max-w-xl text-body-2 text-bina-grass">
        See how bina teaches, meet the teachers these families keep naming, and decide for yourself
        whether the reviews hold up.
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        <a
          href="/family-survey"
          class="ui_button_ghost !border-bina-grass !bg-transparent !text-bina-grass hover:!border-coal-black hover:!bg-bina-grass hover:!text-coal-black active:!border-coal-black active:!bg-bina-grass active:!text-coal-black"
          >See the family survey</a
        >

        <a href={SITE} class="ui_button">Visit bina</a>
      </div>

    </div>
  </section>

  <p slot="footer-note" class="text-small text-bina-grass">
    Every quote here comes from the Growth team's testimonial registry, which holds {registry.total}
    entries; only the {registry.approved} marked approved for public use are published, and the {
      registry.needsPermission
    } awaiting a family's consent plus the {registry.needsRetrieval} not yet transcribed are not on
    this page. Reviews are copied verbatim and by hand — {headline.nicheCount} from
    <UiLink href={NICHE} cardFill="dark" accentColor="grass">bina's Niche page</UiLink>, {
      headline.trustpilotPublished
    } from <UiLink href={TRUSTPILOT} cardFill="dark" accentColor="grass">bina's Trustpilot page</UiLink> (both
    last read 21 August 2026) and {site.length} from families who gave permission to be quoted on
    thebinaschool.com. This page is not a live feed, so read the source for the current picture.
    Niche reports 21 reviews, of which 20 carry review text. Trustpilot reports {
      headline.trustpilotCount
    } and a {headline.trustpilotScore} TrustScore — Trustpilot's own weighted score, not an average of
    the reviews shown. Three Trustpilot entries are deliberately not reproduced: two are the same
    families' Niche reviews cross-posted, and one is a review of an unrelated trading firm. bina
    cannot add, edit or remove reviews on Niche, Trustpilot or world-schools.com, and has never
    offered anything in exchange for a review. Reviewers are self-selecting and their experiences are their own. Niche
    lists bina as PK–6; bina teaches ages 4–15. The {recommendAvg}/10 and NPS {nps} figures come from
    bina's own survey of {surveyN} families, and the {npsTopBand}+ parent band is Independent School
    Management's, not ours — <UiLink href="/family-survey" cardFill="dark" accentColor="grass">
      method, sources and every score here</UiLink
    >. NPS® is a registered trademark of Bain &amp; Company, Fred Reichheld and Satmetrix Systems.
  </p>

  <!-- With JS off, the "See more" button never appears (its own script is what un-hides it), so
       nothing is ever truncated-and-unreachable: undo the line-clamp entirely instead. -->
  <noscript>
    <style>
      .testimonial-body {
        -webkit-line-clamp: unset !important;
        display: block !important;
        overflow: visible !important;
      }
    </style>
  </noscript>

  <style>
    /* page-wide dark background — this page only, not a site-wide toggle */
    :global(body) {
      background: var(--color-dark-bg);
    }
  </style>
</BaseLayout>
