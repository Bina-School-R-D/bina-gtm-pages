---
import CtaBlock from '../components/CtaBlock.astro';
import BrandText from '../components/BrandText.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import data from '../data/reviews.json';
import survey from '../data/family-survey.json';
import { CTA, CTA_LABEL } from '../lib/esa-states.js';

const { headline, sources, reviews, registry, beyond } = data;

// Survey figures live in family-survey.json only, so the two pages can never disagree.
const recommendAvg = survey.headline.recommendAvg;
const nps = survey.headline.nps;
const surveyN = survey.surveyA.n;
const npsTopBand = survey.npsBenchmark.worldClassFrom;

const SITE = 'https://thebinaschool.com';
const NICHE = 'https://www.niche.com/k12/bina-claymont-de/reviews/';
const TRUSTPILOT_WRITE = 'https://www.trustpilot.com/evaluate/thebinaschool.com';

/*
  Narrative order — the three-audience rule (CLAUDE.md):
    hero (one claim, one CTA, and the platform pills carrying each score underneath it, so a
    sceptic can leave and check in a single click) -> the filtered wall, opening with the two
    things parents made unprompted -> the closing CTA. Provenance, exclusions and the caveats live
    in the footer note.

  CTA ladder: "Visit bina" to thebinaschool.com, the same as /esa and /student-results — we want
  the main site to take the enquiry. The review ask is for current families and is deliberately
  demoted to a text link in the hero plus one in-wall card.

  Scanners get the h1, the provider bar and the H2s, each a complete claim. Focused readers get
  two lines under each H2. Detail readers get the source cards, the per-card verify links
  and the methodology expanders. Nothing on this page is written by bina: every quote is
  copied whole from a site we do not control, or from a family who let us quote them.
*/

const WORLD_SCHOOLS = 'https://world-schools.com/schools/bina-school/';

const TRUSTPILOT = 'https://www.trustpilot.com/review/thebinaschool.com';

const sourceUrl: Record<string, string> = {
  niche: NICHE,
  trustpilot: TRUSTPILOT,
  site: SITE,
  'world-schools': WORLD_SCHOOLS,
};
/* The bar carries the three review platforms plus our own survey. thebinaschool.com is not an
   independent site, Instagram/LinkedIn live in their own section further down, and Glassdoor is
   about working here rather than being a family here. */
const BAR = ['niche', 'trustpilot', 'world-schools', 'survey'];
const barSources = BAR.map((key) => sources.find((src) => src.key === key)!);
const sourceLogo: Record<string, string> = {
  // Black-only logos (Zeyu, 2026-11-04), so the badges and cards stay within the page's colors.
  niche: '/images/logos/niche-black.svg',
  trustpilot: '/images/logos/trustpilot-black.svg',
  'world-schools': '/images/logos/world-schools-black.svg',
  site: '/images/logos/bina-black.svg',
  survey: '/images/logos/bina-black.svg',
};

const sourceInitial: Record<string, string> = {
  niche: 'N',
  trustpilot: 'T',
  site: 'b',
  'world-schools': 'W',
};
const sourceVerb: Record<string, string> = {
  niche: 'Verified on Niche',
  trustpilot: 'Verified on Trustpilot',
  site: 'Published on thebinaschool.com',
  'world-schools': 'Verified on world-schools.com',
};


const niche = reviews.filter((r) => r.source === 'niche');
const site = reviews.filter((r) => r.source === 'site');

// Reviews signed with a real name — the ones the reviewer published under their own name on a
// platform we don't control — lead the wall, because a name earns trust faster than an initial.
const named = reviews.filter((r) => r.author && !r.fullNameWithheld);
const unnamed = reviews.filter((r) => !r.author || r.fullNameWithheld);

// Within the rest, spread the short reviews through the long ones — three long, one short — so no
// column ends up carrying every 1,000-character review while its neighbour runs dry.
const short = unnamed.filter((r) => r.body.length <= 520);
const long = unnamed.filter((r) => r.body.length > 520);
const ordered: typeof reviews = [...named];
let si = 0;
let li = 0;
while (si < short.length || li < long.length) {
  for (let k = 0; k < 3 && li < long.length; k++) ordered.push(long[li++]);
  if (si < short.length) ordered.push(short[si++]);
}

// Two in-wall cards, placed where a reader is warm but not finished.
type WallItem =
  | { kind: 'review'; review: (typeof reviews)[number] }
  | { kind: 'cta'; at: number }
  | { kind: 'feature'; item: (typeof beyond)[number] };
const wall: WallItem[] = [];
// The article and the reel open the wall and stay put under every filter — they are the two
// things a parent made unprompted, and neither is a review, so neither is counted as one.
beyond.forEach((item) => wall.push({ kind: 'feature', item }));
// Notion draft (2026-11-04): the review ask after the first 7 reviews, the survey card in the
// middle of the list. The "Reading about it only goes so far" card is gone: the CTA card at the
// end does that job.
const middle = Math.floor(ordered.length / 2);
ordered.forEach((review, i) => {
  if (i === 7) wall.push({ kind: 'cta', at: 0 });
  if (i === middle) wall.push({ kind: 'cta', at: 1 });
  wall.push({ kind: 'review', review });
});
// Every card keeps the same width (Zeyu, 2026-11-04: the stretched last card was removed).
const spanFor = (_idx: number) => '';

// Chromatic tints, cycled. Literal classes so Tailwind picks them up.
// Cards reuse the section's colors (bina Foundation: no fourth color), so no tints.
const tints = [''];

const monthYear = (iso: string | null) =>
  iso
    ? new Date(iso + 'T00:00:00Z').toLocaleDateString('en-GB', {
        month: 'short',
        year: 'numeric',
        timeZone: 'UTC',
      })
    : null;

---

<BaseLayout
  title="bina Reviews — What Families Actually Say About Us"
  description="Every review of bina in one place — 27 verbatim parent and teacher reviews, and links to every independent site where families rate us."
  flushFooter={true}
  ctaHref={CTA}
  ctaLabel="Start your bina journey"
>
  <!-- hero: one claim, one line, one CTA -->
  <header class="theme-lagoon">
    <div class="mx-auto max-w-5xl px-5 py-16 sm:py-20">
      <p class="eyebrow-line mb-5">Reviews</p>
      <h1 class="mb-5 text-title-3xl sm:text-display-sm">
        What parents say about
        <span class="text-deep-ocean">bina</span>
      </h1>
      <p class="mb-8 text-body-xl">
        <BrandText text="Reviews from bina families, copied word for word from Niche, Trustpilot and the families who gave us permission to share them." />
      </p>

      <nav aria-label="Where bina is reviewed">
        <ul class="flex flex-wrap items-center gap-2">
          {
            barSources.map((src) => (
              <li>
                <a
                  href={src.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 rounded-full border-2 border-line px-3 py-1.5 font-display text-label uppercase no-underline transition-colors duration-200 hover:bg-black hover:text-lagoon"
                >
                  {sourceLogo[src.key] ? (
                    <!-- The logo as a mask filled with the text color, so it turns lagoon with the label on hover. -->
                    <span
                      aria-hidden="true"
                      class="badge-logo h-[1.125rem] w-[1.125rem] shrink-0 bg-current"
                      style={`--logo:url(${sourceLogo[src.key]})`}
                    ></span>
                  ) : (
                    <span
                      aria-hidden="true"
                      class:list={[
                        'flex h-[1.125rem] w-[1.125rem] shrink-0 items-center justify-center rounded-full bg-black text-body-md text-lagoon',
                      ]}
                    >
                      {src.mark}
                    </span>
                  )}
                  <span>{src.barLabel}</span>
                  {src.barStat && <span class="font-normal">{src.barStat}</span>}
                  <svg
                    aria-hidden="true"
                    viewBox="0 0 24 24"
                    class="h-3 w-3 shrink-0"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M14 4h6v6M20 4 10.5 13.5" />
                    <path d="M18 14.5V19a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h4.5" />
                  </svg>
                  <span class="sr-only">(opens in a new tab)</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </header>

  <!-- the wall -->
  <section class="theme-base">
    <div class="mx-auto max-w-5xl px-5 py-14">
      <div
        id="review-wall"
        class="grid grid-cols-1 gap-5 md:grid-cols-2 xl:grid-cols-3"
      >
        {
          wall.map((item, idx) => {
            if (item.kind === 'feature') {
              const f = item.item;
              return (
                <a
                  href={f.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class:list={[
                    'wall-cell card-bina-solid relative flex flex-col px-7 py-5 no-underline',
                    spanFor(idx),
                  ]}
                >
                  <div class="mb-2 flex shrink-0 items-center gap-2.5">
                    <img
                      src={f.logo}
                      alt=""
                      width="26"
                      height="26"
                      class="h-[1.625rem] w-[1.625rem] shrink-0"
                      loading="lazy"
                    />
                    <span class="min-w-0 flex-1">
                      <span class="block truncate font-display text-body-md font-bold">
                        {f.who}
                      </span>
                      <span class="block truncate text-body-md leading-tight">
                        {f.platform}
                      </span>
                    </span>
                  </div>

                  <p class="mb-2 inline-flex shrink-0 items-center gap-1 text-body-md font-display font-bold underline underline-offset-2">
                    {f.cta}
                    <svg
                      aria-hidden="true"
                      viewBox="0 0 24 24"
                      class="h-3 w-3"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.6"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M14 4h6v6M20 4 10.5 13.5" />
                      <path d="M18 14.5V19a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h4.5" />
                    </svg>
                    <span class="sr-only">(opens in a new tab)</span>
                  </p>

                  <p class="mb-1 line-clamp-2 shrink-0 font-display text-body-lg font-bold">
                    {f.title}
                  </p>

                  <div class="review-body min-h-0 text-body-lg">{f.detail}</div>
                </a>
              );
            }

            if (item.kind === 'cta') {
              if (item.at === 0) {
                return (
                  <div class:list={['wall-cell flex flex-col rounded-lg bg-deep-ocean p-6 text-mint', spanFor(idx)]}>
                    <p class="mb-2 font-display text-body-xl font-bold">
                      Already a <span class="normal-case">bina</span> family?
                    </p>
                    <p class="mb-4 text-body-lg">
                      Your review helps the next family find their way to bina.
                    </p>
                    <a href={TRUSTPILOT_WRITE} rel="noopener" class="btn-bina btn-sm mt-auto self-start">
                      Write a review
                    </a>
                  </div>
                );
              }
              return (
                <div class:list={['wall-cell flex flex-col rounded-lg bg-deep-ocean p-6 text-mint', spanFor(idx)]}>
                  <p class="mb-2 font-display text-body-xl font-bold">
                    Want to see the numbers too?
                  </p>
                  <p class="mb-4 text-body-lg">
                    {surveyN} families rated bina out of 10, and every score is published.
                  </p>
                  <a href="/family-survey" class="btn-bina btn-sm mt-auto self-start">See the family survey →</a>
                </div>
              );
            }

            const r = item.review;
            const i = ordered.indexOf(r);
            const tint = tints[i % tints.length];
            const initial = r.author ? r.author.charAt(0) : sourceInitial[r.source];
            const when = monthYear(r.date);
            const paras = r.body.split('\n\n').filter(Boolean);

            return (
              <article
                class:list={[
                  'review-card wall-cell card-bina-solid relative flex flex-col px-7 py-5',
                  tint,
                  spanFor(idx),
                ]}
                data-role={r.role}
                data-themes={r.themes.join(' ')}
              >
                <div class="mb-2 flex shrink-0 items-center gap-2.5">
                  <img
                    src={sourceLogo[r.source]}
                    alt=""
                    width="26"
                    height="26"
                    class="h-[1.625rem] w-[1.625rem] shrink-0"
                    loading="lazy"
                  />
                  <span class="min-w-0 flex-1">
                    <span class="block truncate font-display text-body-md font-bold">
                      {r.author ?? (r.role === 'staff' ? 'A bina team member' : 'A bina parent')}
                    </span>
                    <span class="block truncate text-body-md leading-tight">
                      {r.author && r.roleLabel}
                      {r.country && ` · ${r.country}`}
                      {r.author && when && ' · '}
                      {when}
                      {!r.author && !when && r.roleLabel}
                    </span>
                  </span>
                </div>

                <p class="mb-2 flex shrink-0 flex-wrap items-center gap-x-2 text-body-md">
                  <a
                    href={sourceUrl[r.source]}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1 font-display font-bold underline underline-offset-2"
                  >
                    {sourceVerb[r.source]}
                    <svg
                      aria-hidden="true"
                      viewBox="0 0 24 24"
                      class="h-3 w-3"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.6"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M14 4h6v6M20 4 10.5 13.5" />
                      <path d="M18 14.5V19a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h4.5" />
                    </svg>
                    <span class="sr-only">(opens in a new tab)</span>
                  </a>
                  {r.rating && (
                    <span class="text-hl" aria-label={`${r.rating} out of 5`}>
                      <span aria-hidden="true">★★★★★</span>
                    </span>
                  )}
                </p>

                {r.title && (
                  <p class="mb-1 shrink-0 truncate font-display text-body-lg font-bold">
                    {r.title}
                  </p>
                )}

                <div class="review-body min-h-0 text-body-lg">
                  {paras.map((p) => (
                    <p class="mb-1.5 last:mb-0 whitespace-pre-line">{p}</p>
                  ))}
                </div>

                <button type="button" class="review-more hidden" data-dialog={`dlg-${r.id}`}>
                  See more →
                </button>

                <dialog id={`dlg-${r.id}`} class="review-dialog card-bina-solid">
                  <div class="p-6 sm:p-8">
                    <div class="mb-4 flex items-start justify-between gap-4">
                      <span>
                        <span class="block font-display text-body-xl font-bold">
                          {r.author ?? (r.role === 'staff' ? 'A bina team member' : 'A bina parent')}
                        </span>
                        <span class="block text-body-md">
                          {r.roleLabel}
                          {r.country && ` · ${r.country}`}
                          {when && ` · ${when}`}
                        </span>
                      </span>
                      <button
                        type="button"
                        class="dialog-close shrink-0 cursor-pointer rounded-full border-2 border-line px-3 py-1 font-display text-body-md font-bold transition-colors hover:bg-lagoon hover:text-black"
                        aria-label="Close"
                        >Close</button
                      >
                    </div>
                    {r.title && (
                      <p class="mb-1 font-display text-title-sm">{r.title}</p>
                    )}
                    {r.rating && (
                      <p
                        class="mb-3 text-body-md text-hl"
                        aria-label={`${r.rating} out of 5`}
                      >
                        <span aria-hidden="true">★★★★★</span>
                      </p>
                    )}
                    <div class="">
                      {paras.map((p) => (
                        <p class="mb-3 last:mb-0 whitespace-pre-line">{p}</p>
                      ))}
                    </div>
                    <p class="mt-5 text-body-md">
                      <a
                        href={sourceUrl[r.source]}
                        rel="noopener"
                        class="font-display font-bold underline underline-offset-4"
                      >
                        {sourceVerb[r.source]} →
                      </a>
                    </p>
                  </div>
                </dialog>
              </article>
            );
          })
        }
      </div>

    </div>
  </section>


  <!-- CTA: the last section before the footer -->
  <CtaBlock>
    <h2 class="cta-title text-title-xl sm:text-title-3xl"><BrandText text="See if bina is right for your child" /></h2>
    <p class="cta-copy">See how bina teaches and meet the teachers these families talk about.</p>
    <div class="cta-actions">
      <a href={CTA} class="btn-bina">{CTA_LABEL}</a>
    </div>
  </CtaBlock>


  <!-- With JS off, cards grow to fit and nothing is faded, so no review is ever unreachable. -->
  <noscript>
    <style>
      .wall-cell {
        height: auto !important;
      }
      .review-body {
        mask-image: none !important;
        -webkit-mask-image: none !important;
        max-height: none !important;
        overflow: visible !important;
      }
    </style>
  </noscript>

  <style>
    /* Every cell in the wall is the same height, so the grid stays a grid. */
    .wall-cell {
      height: 14.5rem;
    }
    @media (min-width: 640px) {
      .wall-cell {
        height: 15rem;
      }
    }

    /* Three lines of review: two solid, the third fading out to nothing. */
    .review-body {
      line-height: 1.6;
      max-height: 4.8em;
      overflow: hidden;
    }
    .review-body.is-faded {
      -webkit-mask-image: linear-gradient(to bottom, #000 0, #000 66%, transparent 100%);
      mask-image: linear-gradient(to bottom, #000 0, #000 66%, transparent 100%);
    }

    /* "See more" sits on top of the fade, bottom-right of the card. */
    /* "See more" reads as the site's text links (bold, underlined, arrow; hover thickens the
       underline), not a pill button. It sits bottom-left, on a strip of the card's own color so
       the faded text behind it never shows through. */
    .badge-logo {
      -webkit-mask: var(--logo) center / contain no-repeat;
      mask: var(--logo) center / contain no-repeat;
    }
    .review-more {
      position: absolute;
      left: 1.75rem;
      right: 1.75rem;
      bottom: 0;
      padding: 0.4rem 0 0.9rem;
      cursor: pointer;
      border: 0;
      background: var(--card-bg, var(--t-bg));
      text-align: left;
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 1rem;
      color: var(--t-fg);
      text-decoration: underline;
      text-decoration-thickness: 1.5px;
      text-underline-offset: 4px;
      transition: text-decoration-thickness 0.15s ease-out, text-underline-offset 0.15s ease-out;
    }
    .review-more:hover {
      text-decoration-thickness: 3px;
      text-underline-offset: 3px;
    }

    /* The full review, in a native dialog — no library, Esc and backdrop close for free. */
    .review-dialog {
      width: min(38rem, calc(100vw - 2.5rem));
      max-height: min(80vh, 44rem);
      overflow-y: auto;
      padding: 0;
    }
    .review-dialog::backdrop {
      background: rgb(0 0 0 / 0.55);
    }
  </style>

  <script>
    // Cards are a fixed height. Where a review overflows, fade it out and offer the full text
    //    in a dialog; where it fits, leave it completely alone.
    document.querySelectorAll<HTMLElement>('.review-body').forEach((body) => {
      if (body.scrollHeight > body.clientHeight + 2) body.classList.add('is-faded');
    });

    document.querySelectorAll<HTMLElement>('.review-card').forEach((card) => {
      const body = card.querySelector<HTMLElement>('.review-body');
      const btn = card.querySelector<HTMLButtonElement>('.review-more');
      const dialog = card.querySelector<HTMLDialogElement>('.review-dialog');
      if (!body || !btn || !dialog) return;

      if (body.classList.contains('is-faded')) btn.classList.remove('hidden');

      btn.addEventListener('click', () => dialog.showModal());
      dialog.querySelector('.dialog-close')?.addEventListener('click', () => dialog.close());
      // click on the backdrop (i.e. outside the panel) closes it too
      dialog.addEventListener('click', (e) => {
        if (e.target === dialog) dialog.close();
      });
    });

  </script>
</BaseLayout>
