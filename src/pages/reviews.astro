---
import BaseLayout from '../layouts/BaseLayout.astro';
import data from '../data/reviews.json';
import survey from '../data/family-survey.json';

const { headline, sources, filters, reviews, registry, beyond } = data;

// Survey figures live in family-survey.json only, so the two pages can never disagree.
const recommendAvg = survey.headline.recommendAvg;
const nps = survey.headline.nps;
const surveyN = survey.surveyA.n;
const npsTopBand = survey.npsBenchmark.worldClassFrom;

const SITE = 'https://thebinaschool.com';
/* Same conversion CTA as the main site — these pages stand in for it. */
const JOURNEY = 'https://form.thebinaschool.com/new';
const NICHE = 'https://www.niche.com/k12/bina-claymont-de/reviews/';
const TRUSTPILOT_WRITE = 'https://www.trustpilot.com/evaluate/thebinaschool.com';

/*
  Narrative order — the three-audience rule (CLAUDE.md):
    hero (one claim, one CTA, no numbers) -> a one-row provider bar carrying each platform's score,
    so a sceptic can leave and check in a single click -> the filtered wall -> what two parents made
    unprompted -> methodology expanders -> the closing CTA.

  CTA ladder: same as the main site, because these pages stand in for it — every primary CTA is
  "Start your bina journey" to form.thebinaschool.com/new — nav and hero use the main site's exact
  wording, and the closing block reuses its "Begin now". BaseLayout forwards any ?ref= on the
  current URL onto that link so partner attribution survives. The review ask is for current families
  and is deliberately demoted to a text link in the hero plus one in-wall card.

  Scanners get the h1, the provider bar and the H2s, each a complete claim. Focused readers get
  two lines under each H2. Detail readers get the source cards, the per-card verify links
  and the methodology expanders. Nothing on this page is written by bina: every quote is
  copied whole from a site we do not control, or from a family who let us quote them.
*/

const WORLD_SCHOOLS = 'https://world-schools.com/schools/bina-school/';

const TRUSTPILOT = 'https://www.trustpilot.com/review/thebinaschool.com';

const sourceUrl: Record<string, string> = {
  niche: NICHE,
  trustpilot: TRUSTPILOT,
  site: SITE,
  'world-schools': WORLD_SCHOOLS,
};
/* The bar carries the three review platforms plus our own survey. thebinaschool.com is not an
   independent site, Instagram/LinkedIn live in their own section further down, and Glassdoor is
   about working here rather than being a family here. */
const BAR = ['niche', 'trustpilot', 'world-schools', 'survey'];
const barSources = BAR.map((key) => sources.find((src) => src.key === key)!);
const barLogo: Record<string, string> = {
  niche: '/images/logos/niche.svg',
  trustpilot: '/images/logos/trustpilot.svg',
  'world-schools': '/images/logos/world-schools.svg',
};

const sourceInitial: Record<string, string> = {
  niche: 'N',
  trustpilot: 'T',
  site: 'b',
  'world-schools': 'W',
};
const sourceVerb: Record<string, string> = {
  niche: 'Verified on Niche',
  trustpilot: 'Verified on Trustpilot',
  site: 'Published on thebinaschool.com',
  'world-schools': 'Verified on world-schools.com',
};

// Counts per filter pill — a pill that would show nothing never renders.
const filterCounts = Object.fromEntries(
  filters.map((f) => [
    f.key,
    f.key === 'all'
      ? reviews.length
      : f.type === 'role'
        ? reviews.filter((r) => r.role === f.key).length
        : reviews.filter((r) => r.themes.includes(f.key)).length,
  ])
);
const pills = filters.filter((f) => filterCounts[f.key] > 0);

const niche = reviews.filter((r) => r.source === 'niche');
const site = reviews.filter((r) => r.source === 'site');

// Spread the short reviews through the long ones — three long, one short — so no masonry
// column ends up carrying every 1,000-character review while its neighbour runs dry.
const short = reviews.filter((r) => r.body.length <= 520);
const long = reviews.filter((r) => r.body.length > 520);
const ordered: typeof reviews = [];
let si = 0;
let li = 0;
while (si < short.length || li < long.length) {
  for (let k = 0; k < 3 && li < long.length; k++) ordered.push(long[li++]);
  if (si < short.length) ordered.push(short[si++]);
}

// Two in-wall cards, placed where a reader is warm but not finished.
type WallItem = { kind: 'review'; review: (typeof reviews)[number] } | { kind: 'cta'; at: number };
const wall: WallItem[] = [];
ordered.forEach((review, i) => {
  if (i === 5) wall.push({ kind: 'cta', at: 0 });
  if (i === 13) wall.push({ kind: 'cta', at: 2 });
  if (i === 20) wall.push({ kind: 'cta', at: 1 });
  wall.push({ kind: 'review', review });
});

// Chromatic tints, cycled. Literal classes so Tailwind picks them up.
const tints = [
  'bg-white',
  'bg-bina-grass/25',
  'bg-white',
  'bg-bina-yellow/30',
  'bg-bina-blue/20',
  'bg-white',
  'bg-bina-purple/20',
  'bg-bina-pink/15',
  'bg-white',
  'bg-bina-green/20',
  'bg-bina-orange/15',
  'bg-white',
];

const monthYear = (iso: string | null) =>
  iso
    ? new Date(iso + 'T00:00:00Z').toLocaleDateString('en-GB', {
        month: 'short',
        year: 'numeric',
        timeZone: 'UTC',
      })
    : null;

const explainers = [
  {
    q: 'Where did these reviews come from?',
    a: `${headline.nicheCount} are copied word for word from bina's page on Niche and ${headline.trustpilotPublished} from our Trustpilot page — both independent sites where we cannot add, edit or delete anything. The other ${site.length} are families who gave us permission to quote them on our own site. Every card says which is which and links straight to the source so you can read it there instead.`,
    accent: 'bg-bina-grass',
  },
  {
    q: 'Did you edit any of them?',
    a: `No. Every quote is the complete review, including the typos, the double spaces and the emoji. Long ones are collapsed to eight lines with a "read the rest" button, but nothing is cut. Some reviewers are anonymous because Niche publishes them that way — we do not know who they are either. We left three Trustpilot entries off: two are families whose Niche review is already here, and one is a review of a currency-trading firm that landed on our page by mistake.`,
    accent: 'bg-bina-yellow',
  },
  {
    q: 'Are you only showing the good ones?',
    a: `We keep a log of every kind word a family or child has said about bina — ${registry.total} entries so far, from public reviews, from messages to teachers, from things said out loud in class. Only ${registry.approved} of them are on this page, and not because the rest are bad: ${registry.needsPermission} are waiting on a family to say yes to being quoted, and ${registry.needsRetrieval} are still sitting in a screenshot or a video that nobody has typed up. Nothing has been declined. If a family has not given permission, their words stay off this page however good they are — which is exactly why the ones here are all public reviews.`,
    accent: 'bg-bina-blue',
  },
  {
    q: 'What should I be sceptical about?',
    a: `Parents who write reviews are rarely the neutral middle — happy and unhappy families both write more than everyone else, and ours skew happy. This is ${reviews.length} reviews, not a survey, so treat it as stories rather than statistics; the scored survey of ${surveyN} families is the statistics, and it is linked above. ${headline.staffCount} of the reviews are written by bina staff and are labelled as such — they tell you what it is like to work here, not what it is like to be a family here.`,
    accent: 'bg-bina-purple',
  },
];
---

<BaseLayout
  ctaHref={JOURNEY}
  ctaLabel="Start your bina journey"
  title="bina Reviews — What Families Actually Say About Us"
  description="Every review of bina in one place — 27 verbatim parent and teacher reviews, and links to every independent site where families rate us."
  flushFooter={true}
>
  <!-- hero: one claim, one line, one CTA -->
  <header class="bg-bina-purple/25">
    <div class="mx-auto max-w-5xl px-5 py-16 sm:py-24">
      <p class="pill-bina mb-6 text-sm tracking-wide">reviews</p>
      <h1 class="mb-5 max-w-3xl text-5xl font-black sm:text-7xl">
        What parents say
        <span class="underline decoration-bina-yellow decoration-8 underline-offset-4">about bina</span>
      </h1>
      <p class="mb-8 max-w-xl text-lg text-coal-1000 sm:text-xl">
        Their words, not ours — every one of them copied whole from a site we don't control.
      </p>
      <a href={JOURNEY} class="btn-bina text-lg">Start your bina journey →</a>
    </div>
  </header>

  <!-- mid-page provider bar: where the reviews live, one row, scores on the way past -->
  <nav aria-label="Where bina is reviewed" class="border-y-2 border-coal-black bg-white">
    <ul class="mx-auto flex max-w-[100rem] overflow-x-auto">
      {
        barSources.map((src) => (
          <li class="flex-1 shrink-0 border-r-2 border-coal-black last:border-r-0">
            <a
              href={src.url}
              rel="noopener"
              class="group flex h-full min-w-[12rem] items-center gap-3 px-5 py-5 no-underline transition-colors duration-300 hover:bg-bina-yellow"
            >
              {barLogo[src.key] ? (
                <img
                  src={barLogo[src.key]}
                  alt=""
                  width="32"
                  height="32"
                  class="h-8 w-8 shrink-0"
                  loading="lazy"
                />
              ) : (
                <span
                  aria-hidden="true"
                  class:list={[
                    'flex h-8 w-8 shrink-0 items-center justify-center rounded-full border-2 border-coal-black font-display text-xs font-bold text-coal-black',
                    src.markColor,
                  ]}
                >
                  {src.mark}
                </span>
              )}
              <span class="min-w-0 flex-1">
                <span class="block truncate font-display font-bold text-coal-black">
                  {src.barLabel}
                </span>
                {src.barStat && (
                  <span class="block text-xs font-medium text-coal-900">{src.barStat}</span>
                )}
              </span>
              <span
                aria-hidden="true"
                class="font-display font-bold text-coal-black transition-transform group-hover:translate-x-1"
                >→</span
              >
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <!-- the wall -->
  <section class="bg-bina-purple/10">
    <div class="mx-auto max-w-[100rem] px-5 py-10 sm:py-12">
      <div
        id="review-filters"
        class="mb-8 flex flex-wrap gap-2"
        role="group"
        aria-label="Filter reviews"
      >
        {
          pills.map((f, i) => (
            <button
              type="button"
              class="filter-pill cursor-pointer rounded-full border-2 border-coal-black bg-white px-4 py-2 font-display text-sm font-bold text-coal-black transition-colors duration-200 hover:bg-bina-grass aria-pressed:bg-coal-black aria-pressed:text-bina-yellow"
              data-filter={f.key}
              data-type={f.type ?? 'all'}
              aria-pressed={i === 0 ? 'true' : 'false'}
            >
              {f.label}
              <span class="ml-1 font-normal opacity-60">{filterCounts[f.key]}</span>
            </button>
          ))
        }
      </div>

      <div
        id="review-wall"
        class="grid grid-cols-1 gap-5 md:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4"
      >
        {
          wall.map((item) => {
            if (item.kind === 'cta') {
              if (item.at === 0) {
                return (
                  <div class="wall-cell card-bina flex flex-col bg-bina-yellow p-6">
                    <p class="mb-2 font-display text-xl font-bold text-coal-black">
                      Already a bina family?
                    </p>
                    <p class="mb-4 text-coal-1000">
                      Two minutes of your honest opinion is what the next family reads before they
                      dare to switch schools.
                    </p>
                    <a href={TRUSTPILOT_WRITE} rel="noopener" class="btn-bina-ghost mt-auto self-start">
                      Write a review
                    </a>
                  </div>
                );
              }
              if (item.at === 2) {
                return (
                  <div class="wall-cell card-bina flex flex-col bg-bina-grass/40 p-6">
                    <p class="mb-2 font-display text-xl font-bold text-coal-black">
                      Reading about it only goes so far.
                    </p>
                    <p class="mb-4 text-coal-1000">
                      Tell us about your child, meet the teachers, and see whether every family on
                      this page is right about us.
                    </p>
                    <a href={JOURNEY} class="btn-bina mt-auto self-start">Start your bina journey →</a>
                  </div>
                );
              }
              return (
                <div class="wall-cell card-bina flex flex-col bg-coal-black p-6">
                  <p class="mb-2 font-display text-xl font-bold text-white">
                    Stories are one thing. Scores are another.
                  </p>
                  <p class="mb-4 text-white/80">
                    We asked all {surveyN} families to rate us out of 10 on seven things, then
                    published every score — including our worst one.
                  </p>
                  <a href="/family-survey" class="btn-bina mt-auto self-start">See the scores</a>
                </div>
              );
            }

            const r = item.review;
            const i = ordered.indexOf(r);
            const tint = tints[i % tints.length];
            const initial = r.author ? r.author.charAt(0) : sourceInitial[r.source];
            const when = monthYear(r.date);
            const paras = r.body.split('\n\n').filter(Boolean);

            return (
              <article
                class:list={['review-card wall-cell card-bina flex flex-col p-6', tint]}
                data-role={r.role}
                data-themes={r.themes.join(' ')}
              >
                <div class="mb-3 flex items-center gap-3">
                  <span
                    aria-hidden="true"
                    class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border-2 border-coal-black bg-white font-display font-bold text-coal-black"
                  >
                    {initial}
                  </span>
                  <span class="min-w-0">
                    <span class="block truncate font-display font-bold text-coal-black">
                      {r.author ?? (r.role === 'staff' ? 'A bina team member' : 'A bina parent')}
                    </span>
                    <span class="block text-xs text-coal-900">
                      {/* anonymous cards already say the role in the name line above */}
                      {r.author && r.roleLabel}
                      {r.country && ` · ${r.country}`}
                      {r.author && when && ' · '}
                      {when}
                      {!r.author && !when && r.roleLabel}
                    </span>
                  </span>
                </div>

                {r.title && (
                  <p class="mb-1 font-display font-bold text-coal-black">{r.title}</p>
                )}

                {r.rating && (
                  <p class="mb-2 text-sm tracking-widest text-coal-black" aria-label={`${r.rating} out of 5`}>
                    <span aria-hidden="true">★★★★★</span>
                  </p>
                )}

                <div class="review-body min-h-0 flex-1 text-coal-1000">
                  {paras.map((p) => (
                    <p class="mb-2 last:mb-0 whitespace-pre-line">{p}</p>
                  ))}
                </div>

                <p class="review-foot mt-3 flex items-center justify-between gap-3 border-t-2 border-coal-black/15 pt-3 text-xs">
                  <a
                    href={sourceUrl[r.source]}
                    rel="noopener"
                    class="font-display font-bold text-coal-black underline underline-offset-4"
                  >
                    {sourceVerb[r.source]} →
                  </a>
                  <button type="button" class="review-more hidden" data-dialog={`dlg-${r.id}`}>
                    See more…
                  </button>
                </p>

                <dialog id={`dlg-${r.id}`} class="review-dialog card-bina">
                  <div class="p-6 sm:p-8">
                    <div class="mb-4 flex items-start justify-between gap-4">
                      <span>
                        <span class="block font-display text-lg font-bold text-coal-black">
                          {r.author ?? (r.role === 'staff' ? 'A bina team member' : 'A bina parent')}
                        </span>
                        <span class="block text-xs text-coal-900">
                          {r.roleLabel}
                          {r.country && ` · ${r.country}`}
                          {when && ` · ${when}`}
                        </span>
                      </span>
                      <button
                        type="button"
                        class="dialog-close shrink-0 cursor-pointer rounded-full border-2 border-coal-black bg-white px-3 py-1 font-display text-sm font-bold text-coal-black transition-colors hover:bg-bina-pink"
                        aria-label="Close"
                        >Close</button
                      >
                    </div>
                    {r.title && (
                      <p class="mb-1 font-display text-xl font-bold text-coal-black">{r.title}</p>
                    )}
                    {r.rating && (
                      <p
                        class="mb-3 text-sm tracking-widest text-coal-black"
                        aria-label={`${r.rating} out of 5`}
                      >
                        <span aria-hidden="true">★★★★★</span>
                      </p>
                    )}
                    <div class="text-coal-1000">
                      {paras.map((p) => (
                        <p class="mb-3 last:mb-0 whitespace-pre-line">{p}</p>
                      ))}
                    </div>
                    <p class="mt-5 text-xs">
                      <a
                        href={sourceUrl[r.source]}
                        rel="noopener"
                        class="font-display font-bold text-coal-black underline underline-offset-4"
                      >
                        {sourceVerb[r.source]} →
                      </a>
                    </p>
                  </div>
                </dialog>
              </article>
            );
          })
        }
      </div>

      <p id="review-empty" class="hidden pt-4 font-display font-bold">
        No reviews mention that yet. Try another filter.
      </p>
    </div>
  </section>


  <!-- approved public content that is not a quote: an article and a reel -->
  <section class="border-t-2 border-coal-black">
    <div class="mx-auto max-w-5xl px-5 py-14 sm:py-16">
      <h2 class="mb-3 text-3xl sm:text-4xl">Two parents didn't stop at a review</h2>
      <p class="mb-8 max-w-2xl text-coal-900">
        Nobody asked them for either of these. They made them, published them on their own accounts,
        and left them up.
      </p>
      <ul class="grid gap-4 md:grid-cols-2">
        {
          beyond.map((b, i) => (
            <li>
              <a
                href={b.url}
                rel="noopener"
                class:list={[
                  'card-bina group flex h-full flex-col p-6 no-underline transition-colors duration-300 sm:p-7',
                  i === 0 ? 'bg-bina-blue/20 hover:bg-bina-blue/40' : 'bg-bina-pink/15 hover:bg-bina-pink/30',
                ]}
              >
                <span class="mb-2 block font-display text-xs font-bold uppercase tracking-widest text-coal-900">
                  {b.kind}
                </span>
                <span class="mb-3 block font-display text-xl font-bold text-coal-black">{b.title}</span>
                <span class="mb-5 block text-coal-1000">{b.detail}</span>
                <span class="mt-auto block font-display font-bold text-coal-black">
                  {b.cta}
                  <span class="inline-block transition-transform group-hover:translate-x-1">→</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- methodology, for the reader who trusts nothing -->
  <section id="how-we-built-this" class="border-t-2 border-coal-black bg-bina-yellow/20">
    <div class="mx-auto max-w-4xl px-5 py-14 sm:py-16">
      <h2 class="mb-3 text-3xl sm:text-4xl">Nothing here was written, edited or paid for by bina</h2>
      <p class="mb-8 max-w-2xl text-coal-900">
        Here's exactly where each review came from, what we left out, and what you should hold
        against us.
      </p>
      <div class="space-y-4">
        {
          explainers.map((e) => (
            <details class="card-bina group overflow-hidden bg-white p-0">
              <summary
                class="flex cursor-pointer list-none items-center justify-between gap-4 p-6 font-display text-lg font-bold text-coal-black"
              >
                {e.q}
                <span
                  class:list={[
                    'flex h-8 w-8 shrink-0 items-center justify-center rounded-full border-2 border-coal-black font-display transition-transform duration-300 group-open:rotate-45',
                    e.accent,
                  ]}
                  aria-hidden="true">+</span
                >
              </summary>
              <p class="px-6 pb-6 text-coal-1000">{e.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="border-t-2 border-coal-black bg-coal-black">
    <div class="mx-auto max-w-4xl px-5 py-16 text-center">
      <h2 class="mb-4 text-3xl text-white sm:text-4xl">
        Read all you like — then come and <span class="text-bina-grass">see for yourself</span>
      </h2>
      <p class="mx-auto mb-8 max-w-xl text-white/80">
        Tell us about your child. We'll show you how bina teaches, introduce the teachers these
        families keep naming, and let you decide whether the reviews hold up.
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        <a href={JOURNEY} class="btn-bina text-lg">Begin now →</a>
        <a href={SITE} class="btn-bina-ghost text-lg">Visit bina</a>
      </div>
      <p class="mt-6 text-sm text-white/70">
        Prefer numbers to stories?{' '}
        <a href="/family-survey" class="font-bold text-bina-grass underline underline-offset-4"
          >Read the family survey</a
        > — all seven scores, including our weakest.
      </p>
    </div>
  </section>

  <p slot="footer-note" class="text-xs text-white/60">
    Every quote here comes from the Growth team's testimonial registry, which holds {registry.total}
    entries; only the {registry.approved} marked approved for public use are published, and the {
      registry.needsPermission
    } awaiting a family's consent plus the {registry.needsRetrieval} not yet transcribed are not on
    this page. Reviews are copied verbatim and by hand — {headline.nicheCount} from
    <a href={NICHE} rel="noopener" class="underline">bina's Niche page</a>, {
      headline.trustpilotPublished
    } from <a href={TRUSTPILOT} rel="noopener" class="underline">bina's Trustpilot page</a> (both
    last read 21 August 2026) and {site.length} from families who gave permission to be quoted on
    thebinaschool.com. This page is not a live feed, so read the source for the current picture.
    Niche reports 21 reviews, of which 20 carry review text. Trustpilot reports {
      headline.trustpilotCount
    } and a {headline.trustpilotScore} TrustScore — Trustpilot's own weighted score, not an average of
    the reviews shown. Three Trustpilot entries are deliberately not reproduced: two are the same
    families' Niche reviews cross-posted, and one is a review of an unrelated trading firm. bina
    cannot add, edit or remove reviews on Niche, Trustpilot or world-schools.com, and has never
    offered anything in exchange for a review. Reviewers are self-selecting and their experiences are their own. Niche
    lists bina as PK–6; bina teaches ages 4–15. The {recommendAvg}/10 and NPS {nps} figures come from
    bina's own survey of {surveyN} families, and the {npsTopBand}+ parent band is Independent School
    Management's, not ours — <a href="/family-survey" class="underline">
      method, sources and every score here</a
    >. NPS® is a registered trademark of Bain &amp; Company, Fred Reichheld and Satmetrix Systems.
  </p>

  <!-- With JS off, cards grow to fit and nothing is faded, so no review is ever unreachable. -->
  <noscript>
    <style>
      .wall-cell {
        height: auto !important;
      }
      .review-body {
        mask-image: none !important;
        -webkit-mask-image: none !important;
        overflow: visible !important;
      }
    </style>
  </noscript>

  <style>
    /* Every cell in the wall is the same height, so the grid stays a grid. */
    .wall-cell {
      height: 24rem;
    }
    @media (min-width: 640px) {
      .wall-cell {
        height: 25rem;
      }
    }

    /* A clipped review fades out towards the bottom edge instead of stopping dead. */
    .review-body {
      overflow: hidden;
    }
    .review-body.is-faded {
      -webkit-mask-image: linear-gradient(to bottom, #000 55%, rgba(0, 0, 0, 0.35) 82%, transparent 100%);
      mask-image: linear-gradient(to bottom, #000 55%, rgba(0, 0, 0, 0.35) 82%, transparent 100%);
    }

    .review-more {
      cursor: pointer;
      border: 2px solid #000;
      border-radius: 9999px;
      background: #fff;
      padding: 0.15rem 0.7rem;
      font-family: 'Rund Display', Arial, sans-serif;
      font-weight: 700;
      font-size: 0.75rem;
      color: #000;
      white-space: nowrap;
      transition: background-color 0.2s ease-out;
    }
    .review-more:hover {
      background: #f7d928;
    }

    /* The full review, in a native dialog — no library, Esc and backdrop close for free. */
    .review-dialog {
      width: min(38rem, calc(100vw - 2.5rem));
      max-height: min(80vh, 44rem);
      overflow-y: auto;
      padding: 0;
      background: #fff;
    }
    .review-dialog::backdrop {
      background: rgb(0 0 0 / 0.55);
    }
  </style>

  <script>
    // 1. Cards are a fixed height. Where a review overflows, fade it out and offer the full text
    //    in a dialog; where it fits, leave it completely alone.
    document.querySelectorAll<HTMLElement>('.review-card').forEach((card) => {
      const body = card.querySelector<HTMLElement>('.review-body');
      const btn = card.querySelector<HTMLButtonElement>('.review-more');
      const dialog = card.querySelector<HTMLDialogElement>('.review-dialog');
      if (!body || !btn || !dialog) return;

      if (body.scrollHeight > body.clientHeight + 2) {
        body.classList.add('is-faded');
        btn.classList.remove('hidden');
      }

      btn.addEventListener('click', () => dialog.showModal());
      dialog.querySelector('.dialog-close')?.addEventListener('click', () => dialog.close());
      // click on the backdrop (i.e. outside the panel) closes it too
      dialog.addEventListener('click', (e) => {
        if (e.target === dialog) dialog.close();
      });
    });

    // 2. Filter pills — one active at a time, counts already rendered server-side.
    const wall = document.getElementById('review-wall');
    const empty = document.getElementById('review-empty');
    const pills = document.querySelectorAll<HTMLButtonElement>('#review-filters .filter-pill');
    const cards = wall ? Array.from(wall.querySelectorAll<HTMLElement>('.review-card')) : [];

    pills.forEach((pill) => {
      pill.addEventListener('click', () => {
        const key = pill.dataset.filter ?? 'all';
        const type = pill.dataset.type ?? 'all';
        pills.forEach((p) => p.setAttribute('aria-pressed', String(p === pill)));

        let shown = 0;
        cards.forEach((card) => {
          const match =
            key === 'all' ||
            (type === 'role' && card.dataset.role === key) ||
            (type === 'theme' && (card.dataset.themes ?? '').split(' ').includes(key));
          card.classList.toggle('hidden', !match);
          if (match) shown++;
        });
        empty?.classList.toggle('hidden', shown > 0);
      });
    });
  </script>
</BaseLayout>
