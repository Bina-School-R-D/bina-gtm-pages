---
import BaseLayout from '../layouts/BaseLayout.astro';
import esaData from '../data/esa-states.json';

const { programs, allStates } = esaData;

const steps = [
  {
    t: "Confirm you're eligible",
    d: "Check your state's current-year rules — some are open to all K–12 families, others are limited by income or a qualifying disability. Age and residency requirements apply.",
  },
  {
    t: 'Apply through the official portal',
    d: "Create an account on your state's program site during its application window (a few states accept applications year-round). Upload proof of residency, your child's age, and any required documents.",
  },
  {
    t: 'Get approved & funded',
    d: 'Once approved, funds are placed in your account — often on a marketplace platform like ClassWallet or Odyssey — usually released quarterly or per semester.',
  },
  {
    t: 'Spend on approved expenses',
    d: 'Enroll with an approved provider or buy approved materials. Some programs pay providers directly; others reimburse you after you pay and submit receipts.',
  },
  {
    t: 'Keep records & report',
    d: 'Save every invoice and receipt, and complete any required progress or spending reports to stay compliant and keep your funding for next year.',
  },
];

const covered = [
  'Online school tuition',
  'Online learning programs',
  'Curriculum & materials',
  'Tutoring & teaching services',
  'Private school tuition',
  'Educational therapy',
  'Standardized & norm-referenced testing',
  'Technology (usually capped 10–15%)',
];
const notCovered = ['Everyday household items', 'Non-educational subscriptions', 'Anything without a receipt'];

const checks = [
  {
    q: 'Does your state have an ESA, and are you eligible this year?',
    d: 'Confirm income, disability, age, and residency rules on the official portal — they change annually.',
  },
  {
    q: "What's the application window?",
    d: "Note whether it's rolling or a fixed window, and put the deadline in your calendar today.",
  },
  {
    q: 'How much will you actually receive?',
    d: 'Confirm the current-year amount and the disbursement schedule (quarterly vs. per semester).',
  },
  {
    q: 'Direct-pay or reimbursement?',
    d: 'This decides whether you need cash on hand up front. Check the approved marketplace for online-learning providers.',
  },
  {
    q: 'What must you document and report?',
    d: "Line up invoices, receipts, and any progress reports so you keep this year's funds and requalify next year.",
  },
];
---

<BaseLayout
  title="ESA Funding for bina — Parent Guide"
  description="See if your state's Education Savings Account (ESA) can help pay for bina. Pick your state for the program, award amount, payment model, and how to apply."
>
  <!-- hero -->
  <header class="border-b-2 border-coal-black bg-bina-purple">
    <div class="mx-auto max-w-4xl px-5 py-16 sm:py-20">
      <p class="pill-bina mb-6 text-sm tracking-wide">ESA funding for families</p>
      <h1 class="mb-5 text-4xl font-black sm:text-6xl">
        Can an ESA help pay for <span class="underline decoration-bina-yellow decoration-8 underline-offset-4">bina</span>?
      </h1>
      <p class="max-w-2xl text-lg text-coal-1000 sm:text-xl">
        Many U.S. states now give families public education dollars — an
        <strong>Education Savings Account (ESA)</strong> — to spend on approved learning outside a
        traditional school. Online school tuition, courses, and tutoring are common approved uses.
        Pick your state below to see how the program works <strong>for your case</strong>.
      </p>
    </div>
  </header>

  <!-- state finder -->
  <section class="border-b-2 border-coal-black">
    <div class="mx-auto max-w-4xl px-5 py-14">
      <p class="mb-2 font-display text-sm font-bold uppercase tracking-widest text-bina-pink">Start here</p>
      <h2 class="mb-3 text-3xl sm:text-4xl">Find your state's program</h2>
      <p class="mb-8 max-w-2xl text-coal-900">
        Programs, amounts, and rules differ by state and change every year. This shows the current
        picture and links you to the official source of truth.
      </p>

      <div class="card-bina p-6 sm:p-8">
        <label for="state" class="mb-3 block font-display text-lg font-bold">Which state do you live in?</label>
        <div class="relative">
          <select
            id="state"
            aria-label="Select your state"
            class="w-full cursor-pointer appearance-none rounded-2xl border-2 border-coal-black bg-white px-4 py-4 font-display text-lg font-bold focus-visible:outline-4 focus-visible:outline-bina-pink"
          >
            <option value="">Select your state…</option>
          </select>
          <span class="pointer-events-none absolute right-5 top-1/2 h-3 w-3 -translate-y-[70%] rotate-45 border-b-2 border-r-2 border-coal-black"></span>
        </div>
        <p class="mt-3 text-sm text-coal-900">
          Don't see a program for your state? Many states have no ESA yet — but new ones are added most years.
        </p>
        <div id="result" class="mt-6">
          <div class="rounded-[1.875rem] border-2 border-dashed border-coal-900/40 p-8 text-center text-coal-900">
            Choose a state to see its program, award amount, how funds are paid, and the steps to apply.
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- steps -->
  <section class="border-b-2 border-coal-black bg-bina-grass/20">
    <div class="mx-auto max-w-4xl px-5 py-14">
      <p class="mb-2 font-display text-sm font-bold uppercase tracking-widest text-bina-pink">How it works</p>
      <h2 class="mb-3 text-3xl sm:text-4xl">The process, step by step</h2>
      <p class="mb-8 max-w-2xl text-coal-900">
        The details vary, but nearly every ESA follows the same five stages. This is the path for your own case.
      </p>
      <ol class="grid gap-4">
        {
          steps.map((step, i) => (
            <li class="card-bina flex gap-5 p-5 sm:p-6">
              <span class="grid h-11 w-11 flex-none place-items-center rounded-xl border-2 border-coal-black bg-bina-yellow font-display text-xl font-black">
                {i + 1}
              </span>
              <span>
                <h3 class="mb-1 text-lg">{step.t}</h3>
                <p class="text-[15px] text-coal-900">{step.d}</p>
              </span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- payment models -->
  <section class="border-b-2 border-coal-black">
    <div class="mx-auto max-w-4xl px-5 py-14">
      <p class="mb-2 font-display text-sm font-bold uppercase tracking-widest text-bina-pink">Getting paid</p>
      <h2 class="mb-3 text-3xl sm:text-4xl">The two ways ESAs pay</h2>
      <p class="mb-8 max-w-2xl text-coal-900">
        Knowing which model your state uses tells you whether you'll ever front the money yourself.
      </p>
      <div class="grid gap-4 sm:grid-cols-2">
        <div class="card-bina bg-bina-blue/15 p-6">
          <p class="pill-bina mb-3 text-xs">Model A</p>
          <h3 class="mb-2 text-xl">Direct-pay marketplace</h3>
          <p class="mb-3 text-[15px] text-coal-900">
            You shop inside an approved marketplace and the program pays the provider directly from
            your account. No out-of-pocket cost.
          </p>
          <p class="text-sm text-coal-900/80">Platforms: ClassWallet, Odyssey, Step Up's EMA / MyScholarShop.</p>
        </div>
        <div class="card-bina bg-bina-yellow/20 p-6">
          <p class="pill-bina mb-3 text-xs">Model B</p>
          <h3 class="mb-2 text-xl">Pay &amp; reimburse</h3>
          <p class="mb-3 text-[15px] text-coal-900">
            You pay the provider yourself, then submit the invoice and receipt through the portal to
            be reimbursed from your account.
          </p>
          <p class="text-sm text-coal-900/80">Keep itemized invoices — bina provides these on request.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- coverage -->
  <section class="border-b-2 border-coal-black">
    <div class="mx-auto max-w-4xl px-5 py-14">
      <p class="mb-2 font-display text-sm font-bold uppercase tracking-widest text-bina-pink">What funds cover</p>
      <h2 class="mb-3 text-3xl sm:text-4xl">Typical approved expenses</h2>
      <p class="mb-8 max-w-2xl text-coal-900">
        Exact lists differ by state, but most ESAs approve these categories. Online school tuition
        and online learning programs — the category bina falls under — are widely covered.
      </p>
      <div class="mb-4 flex flex-wrap gap-2.5">
        {
          covered.map((c) => (
            <span class="rounded-full border-2 border-coal-black bg-bina-grass px-4 py-1.5 font-display text-sm font-bold">{c}</span>
          ))
        }
      </div>
      <div class="mb-8 flex flex-wrap gap-2.5">
        {
          notCovered.map((c) => (
            <span class="rounded-full border-2 border-coal-900/30 px-4 py-1.5 font-display text-sm font-bold text-coal-900/50 line-through">{c}</span>
          ))
        }
      </div>
      <div class="card-bina bg-bina-purple/15 p-6">
        <p class="text-[15px] text-coal-900">
          <strong class="text-coal-black">Where bina fits:</strong> bina is a nonpublic online school
          for ages 4–15. Online school tuition and online learning programs are an approved category
          in most ESAs. Whether bina specifically is reimbursable depends on your program's vendor
          and expense rules — bina supplies itemized invoices, enrollment documentation, and
          accreditation details to support your claim.
        </p>
      </div>
    </div>
  </section>

  <!-- five checks -->
  <section class="border-b-2 border-coal-black bg-bina-pink/10">
    <div class="mx-auto max-w-4xl px-5 py-14">
      <p class="mb-2 font-display text-sm font-bold uppercase tracking-widest text-bina-pink">Your case</p>
      <h2 class="mb-3 text-3xl sm:text-4xl">Build your case in five checks</h2>
      <p class="mb-8 max-w-2xl text-coal-900">
        Run through these before you enroll or spend. Answering them tells you exactly where you stand.
      </p>
      <ul class="grid gap-3">
        {
          checks.map((c, i) => (
            <li class="card-bina flex gap-4 p-5">
              <span class="grid h-8 w-8 flex-none place-items-center rounded-lg border-2 border-coal-black bg-bina-green font-display text-sm font-black text-white">
                {i + 1}
              </span>
              <span class="text-[15px] text-coal-900">
                <strong class="text-coal-black">{c.q}</strong> {c.d}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- disclaimer -->
  <section>
    <div class="mx-auto max-w-4xl px-5 py-14">
      <div class="card-bina bg-bina-yellow/15 p-6 sm:p-8">
        <h2 class="mb-3 text-xl sm:text-2xl">Please verify everything with your state</h2>
        <p class="mb-3 text-sm text-coal-900">
          This guide is general information to help you get oriented — it is <strong>not</strong>
          legal, financial, or eligibility advice, and amounts, deadlines, and rules shown here may
          have changed. ESA programs are run by state agencies and their contractors, not by bina.
        </p>
        <p class="text-sm text-coal-900">
          You are responsible for confirming eligibility, approved expenses, documentation, the
          payment process, reimbursement rules, and timing
          <strong>directly with your state's official program</strong> before relying on any funds.
          bina can provide itemized invoices, enrollment records, and accreditation details where
          permitted, but cannot determine your eligibility, guarantee approval, or guarantee
          reimbursement of applied ESA funds.
        </p>
      </div>
    </div>
  </section>

  <p slot="footer-note" class="text-xs text-white/60">
    Program details reflect publicly available information for the 2025–26 / 2026–27 school years and are subject to change.
  </p>

  <script define:vars={{ programs, allStates }}>
    const byState = {};
    programs.forEach((d) => (byState[d.s] = d));

    const sel = document.getElementById('state');
    allStates.forEach((name) => {
      const o = document.createElement('option');
      o.value = name;
      o.textContent = byState[name] ? name : name + '  —  no ESA yet';
      sel.appendChild(o);
    });

    const eligLabel = { ok: 'Broad eligibility', limit: 'Limited eligibility', check: 'Conditions apply' };
    const eligColor = { ok: '#03ecc5', limit: '#f7d928', check: '#fe6c23' };

    function esc(t) {
      const d = document.createElement('div');
      d.textContent = t;
      return d.innerHTML;
    }

    function render(name) {
      const box = document.getElementById('result');
      const placeholder =
        '<div class="rounded-[1.875rem] border-2 border-dashed border-coal-900/40 p-8 text-center text-coal-900">Choose a state to see its program, award amount, how funds are paid, and the steps to apply.</div>';
      if (!name) {
        box.innerHTML = placeholder;
        return;
      }
      const d = byState[name];
      if (!d) {
        box.innerHTML =
          '<div class="rounded-[1.875rem] border-2 border-dashed border-coal-900/40 p-8 text-center text-coal-900"><strong>' +
          esc(name) +
          '</strong> does not have a broad Education Savings Account program yet.<br>New programs are added most years — and bina can still be paid for privately in the meantime. Email hello@thebinaschool.com and we’ll help you explore options.</div>';
        return;
      }
      const warn =
        d.elig === 'check'
          ? '<div class="border-t-2 border-coal-black bg-bina-orange/20 px-6 py-3 text-sm font-bold">⚠ Special status — confirm this program is active and accepting applications before you rely on it.</div>'
          : '';
      const cell = (k, v, big) =>
        '<div class="bg-white p-4 sm:px-6"><p class="mb-1 font-display text-[11px] font-bold uppercase tracking-widest text-coal-900/60">' +
        k +
        '</p><p class="font-bold ' +
        (big ? 'font-display text-lg' : 'text-[15px]') +
        '">' +
        esc(v) +
        '</p></div>';
      box.innerHTML =
        '<div class="overflow-hidden rounded-[1.875rem] border-2 border-coal-black bg-coal-black">' +
        '<div class="flex flex-wrap items-baseline justify-between gap-3 bg-bina-yellow px-6 py-5 border-b-2 border-coal-black">' +
        '<div><p class="font-display text-2xl font-black">' + esc(d.s) + '</p>' +
        '<p class="text-sm text-coal-900">' + esc(d.prog) + '</p></div>' +
        '<span class="rounded-full border-2 border-coal-black px-4 py-1 font-display text-xs font-bold" style="background:' + eligColor[d.elig] + '">' +
        eligLabel[d.elig] + '</span></div>' +
        '<div class="grid gap-px sm:grid-cols-2">' +
        cell('Who qualifies', d.eligText, false) +
        cell('Typical award', d.amount, true) +
        cell('How funds are paid', d.pay, false) +
        cell('When to apply', d.window, false) +
        '</div>' +
        warn +
        '<div class="border-t-2 border-coal-black bg-white px-6 py-4 text-[15px] text-coal-900"><strong class="text-coal-black">How bina fits:</strong> ' +
        esc(d.note) +
        '</div>' +
        '<div class="flex flex-wrap gap-3 bg-white px-6 pb-6">' +
        '<a class="btn-bina !px-5 !py-2.5 text-sm" href="' + esc(d.url) + '" target="_blank" rel="noopener">Open the official program ↗</a>' +
        '<a class="btn-bina-ghost !px-5 !py-2.5 text-sm" href="mailto:hello@thebinaschool.com?subject=ESA%20funding%20for%20bina%20%E2%80%94%20' +
        encodeURIComponent(d.s) +
        '">Ask bina for invoices &amp; docs</a>' +
        '</div></div>';
    }

    sel.addEventListener('change', function () {
      render(this.value);
    });
  </script>
</BaseLayout>
