---
import BaseLayout from '../layouts/BaseLayout.astro';
import PillLabel from '../components/sections/pill_label.astro';
import UiAccordion from '../components/sections/ui_accordion.astro';
import LayoutStatSection from '../components/sections/layout_stat_section.astro';
import CardStat from '../components/sections/card_stat.astro';
import SectionTabbedStat from '../components/sections/section_tabbed_stat.astro';
import ChartVerticalBar from '../components/sections/chart_vertical_bar.astro';
import UiLink from '../components/sections/ui_link.astro';
import results from '../data/student-results.json';

const { headline, curves, levels, tenure, year } = results;

const SITE = 'https://thebinaschool.com';

// Plain-language explainers for the STAR section — the page's only jargon, defused.
const explainers = [
  {
    question: 'What is STAR, and why does it matter?',
    answer: "STAR is an adaptive reading and math assessment by Renaissance Learning, normed on millions of U.S. students. Because it's built and scored by an outside company, the results aren't ours to bend — every number on this page comes from it.",
  },
  {
    question: 'What is a "scaled score"?',
    answer: 'A single number for what a student can do, on one continuous scale across all grades. It only goes up when ability goes up — which is why growth in scaled-score points is the cleanest way to show a year of learning.',
  },
  {
    question: 'What is the "national benchmark"?',
    answer: 'Renaissance flags a student as at or above benchmark when they score in the top 60% of U.S. students for their grade (the 40th percentile or higher). It is the standard line schools use for "on track".',
  },
  {
    question: 'How we report these numbers',
    answer: `Growth figures cover the ${headline.pairedN} students assessed in both Oct '25 and May '26 at the same level. Spring standing covers everyone assessed in May. Groups with fewer than 10 students are never reported. All figures are school aggregates — no individual student data appears on this page.`,
  },
];

// ---- distribution curves (built at compile time — pure static SVG) ----
// Multi-series chart colors (CLAUDE.md Rule 20): first series (Oct '25) is the section's own
// accent — magenta #fe49c1, the literal swatch hex for the "pink" role, matching how Rule 7's
// approved fills are expressed — and the second series (May '26) is a contrasting palette color,
// grass green #03cb5b, kept unchanged from its original choice. Black 2px strokes + direct labels
// carry identity; semi-transparent fills (Rule 21) keep both readable where the curves overlap.
const W = 640;
const H = 230;
const PAD = 14;

function gaussianPath(mean, sd, xMin, xMax, yMax, close) {
  const pts = [];
  const steps = 90;
  for (let i = 0; i <= steps; i++) {
    const x = xMin + ((xMax - xMin) * i) / steps;
    const y = Math.exp(-0.5 * ((x - mean) / sd) ** 2) / (sd * Math.sqrt(2 * Math.PI));
    const px = PAD + ((x - xMin) / (xMax - xMin)) * (W - 2 * PAD);
    const py = H - PAD - (y / yMax) * (H - 2 * PAD - 26);
    pts.push(`${px.toFixed(1)},${py.toFixed(1)}`);
  }
  const line = `M${pts.join(' L')}`;
  return close ? `${line} L${W - PAD},${H - PAD} L${PAD},${H - PAD} Z` : line;
}

function xPos(x, xMin, xMax) {
  return PAD + ((x - xMin) / (xMax - xMin)) * (W - 2 * PAD);
}

function buildCurveChart(subject) {
  const { oct, may } = curves[subject];
  const xMin = Math.min(oct.mean, may.mean) - 3 * Math.max(oct.sd, may.sd);
  const xMax = Math.max(oct.mean, may.mean) + 3 * Math.max(oct.sd, may.sd);
  const yMax = 1 / (Math.min(oct.sd, may.sd) * Math.sqrt(2 * Math.PI));
  return {
    octArea: gaussianPath(oct.mean, oct.sd, xMin, xMax, yMax, true),
    octLine: gaussianPath(oct.mean, oct.sd, xMin, xMax, yMax, false),
    mayArea: gaussianPath(may.mean, may.sd, xMin, xMax, yMax, true),
    mayLine: gaussianPath(may.mean, may.sd, xMin, xMax, yMax, false),
    octMeanX: xPos(oct.mean, xMin, xMax),
    mayMeanX: xPos(may.mean, xMin, xMax),
    oct,
    may,
  };
}

const charts = {
  reading: buildCurveChart('reading'),
  math: buildCurveChart('math'),
};

const curveCards = [
  {
    key: 'reading',
    title: 'Reading',
    growth: headline.readGrowthAvg,
    accent: 'text-bina-green',
  },
  {
    key: 'math',
    title: 'Math',
    growth: headline.mathGrowthAvg,
    accent: 'text-bina-green',
  },
];

---

<BaseLayout
  title="bina Student Results — Independently Measured"
  description="How much do bina students actually learn? See a year of reading and math growth, measured by the nationally normed Renaissance STAR assessment."
  flushFooter={true}
  decorationSet="deco_waterlily"
>
  <!-- hero -->
  <header class="bg-dark-bg">
    <div class="relative z-[1] mx-auto max-w-6xl px-8 py-[clamp(3rem,6vw,6rem)]">
      <PillLabel text={`student results · ${year}`} accentColor="grass" class="mb-6" />
      <h1 class="mb-5 max-w-3xl text-hero text-bina-grass">
        How much do kids actually learn at
        bina?
      </h1>
      <p class="max-w-2xl text-body-2 text-bina-grass">
        We don't grade our own homework. bina students (ages 4–15) sit
        <strong>Renaissance STAR</strong> — an independent, nationally normed assessment used by
        schools across the U.S. — so families can see real growth against real national benchmarks.
        Here's what one school year looked like.
      </p>
    </div>
  </header>

  <!-- headline stats -->
  <section class="bg-dark-bg">
    <div class="relative z-[1] mx-auto max-w-6xl px-8 py-[clamp(3rem,6vw,6rem)]">
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <CardStat
          count={headline.readGrowthAvg}
          countPrefix="+"
          label="points of reading growth"
          note="average per student in one school year¹"
          accentColor="grass"
        />
        <CardStat
          count={headline.mathGrowthAvg}
          countPrefix="+"
          label="points of math growth"
          note="average per student in one school year¹"
          accentColor="grass"
        />
        <CardStat
          count={headline.readAtAbovePct}
          countSuffix="%"
          label="at or above the national reading benchmark"
          note={`of ${headline.readAtAboveN} students assessed in spring '26`}
          accentColor="grass"
        />
        <CardStat
          count={headline.readGrewPct}
          countSuffix="%"
          label="of students grew their reading score"
          note="autumn to spring¹"
          accentColor="grass"
        />
      </div>
      <p class="mt-4 text-body-3 text-bina-grass">
        ¹ STAR scaled-score points, Oct '25 → May '26, across the {headline.pairedN} students
        assessed at both points at the same level.
      </p>
    </div>
  </section>

  <!-- distribution curves: bell-curve chart stays bespoke page-specific SVG, per CLAUDE.md's
       reusable-chart-set rule — only the shell (eyebrow/heading/intro) is componentized below -->
  <LayoutStatSection eyebrow="One year of growth" heading="The whole school moved forward" accentColor="pink">
    <Fragment slot="intro">
      Each curve is the spread of student scores across the school. Watch the spring curve sit to
      the right of autumn — that's a year of learning, in one picture.
    </Fragment>
      <div class="grid gap-6 lg:grid-cols-2">
        {
          curveCards.map((c) => {
            const ch = charts[c.key];
            return (
              <figure class="card_base bg-coal-black curve-card p-6">
                <figcaption class="mb-1 flex items-baseline justify-between gap-3">
                  <span class="font-display text-body-2 font-bold text-bina-pink">{c.title}</span>
                  <span class="font-display text-body-2 font-black text-bina-pink">
                    +{c.growth} pts avg growth
                  </span>
                </figcaption>
                <p class="mb-3 text-body-3 text-bina-pink">STAR scaled scores, {headline.pairedN} students</p>
                <p class="mb-2 flex gap-5 font-display text-body-3 font-bold text-bina-pink">
                  <span class="inline-flex items-center gap-2">
                    <span class="h-3.5 w-3.5 rounded-full border-2 border-coal-black" style="background:#fe49c1"></span>
                    Oct '25
                  </span>
                  <span class="inline-flex items-center gap-2">
                    <span class="h-3.5 w-3.5 rounded-full border-2 border-coal-black bg-bina-green"></span>
                    May '26
                  </span>
                </p>
                <svg
                  viewBox={`0 0 ${W} ${H}`}
                  role="img"
                  aria-label={`${c.title}: distribution of scores shifted right from October to May; average grew ${c.growth} points`}
                  class="w-full"
                >
                  <line x1={PAD} y1={H - PAD} x2={W - PAD} y2={H - PAD} stroke="#fe48c2" stroke-width="2" />
                  <g class="curve-oct">
                    <path d={ch.octArea} fill="#fe49c1" fill-opacity="0.3" />
                    <path d={ch.octLine} fill="none" stroke="#000" stroke-width="2" />
                    <line x1={ch.octMeanX} y1={H - PAD} x2={ch.octMeanX} y2="40" stroke="#fe48c2" stroke-width="1.5" stroke-dasharray="5 4" />
                  </g>
                  <g class="curve-may">
                    <path d={ch.mayArea} fill="#03cb5b" fill-opacity="0.4" />
                    <path d={ch.mayLine} fill="none" stroke="#000" stroke-width="2" />
                    <line x1={ch.mayMeanX} y1={H - PAD} x2={ch.mayMeanX} y2="40" stroke="#fe48c2" stroke-width="1.5" stroke-dasharray="5 4" />
                  </g>
                  <text x={ch.octMeanX - 8} y="30" text-anchor="end" class="chart-label">Oct '25</text>
                  <text x={ch.mayMeanX + 8} y="30" text-anchor="start" class="chart-label">May '26</text>
                </svg>
                <details class="mt-3 text-bina-pink">
                  <summary class="cursor-pointer font-display text-body-3 font-bold text-bina-pink">See the numbers</summary>
                  <table class="mt-2 w-full text-left text-body-3 text-bina-pink">
                    <thead>
                      <tr class="border-b-2 border-bina-pink font-display">
                        <th class="py-1 pr-3">Point</th>
                        <th class="py-1 pr-3">Average scaled score</th>
                        <th class="py-1">Students</th>
                      </tr>
                    </thead>
                    <tbody>
                      <tr class="border-b border-bina-pink/20">
                        <td class="py-1 pr-3">Oct '25</td>
                        <td class="py-1 pr-3">{ch.oct.mean}</td>
                        <td class="py-1">{ch.oct.n}</td>
                      </tr>
                      <tr>
                        <td class="py-1 pr-3">May '26</td>
                        <td class="py-1 pr-3">{ch.may.mean}</td>
                        <td class="py-1">{ch.may.n}</td>
                      </tr>
                    </tbody>
                  </table>
                  <p class="mt-2 text-body-3 text-bina-pink">
                    Average growth (+{c.growth}) is the average of each student's own change, so it
                    can differ slightly from subtracting the rounded averages above.
                  </p>
                </details>
              </figure>
            );
          })
        }
      </div>
  </LayoutStatSection>

  <!-- per-level tool -->
  <LayoutStatSection eyebrow="Your child's level" heading="See results for your child's age group" accentColor="orange">
    <Fragment slot="intro">
      Pick your child's age group — P1 is our youngest primary group, M1 the start of middle
      school. Not sure which one fits?
      <UiLink href={SITE} cardFill="dark" accentColor="orange">Visit bina to learn more</UiLink>.
    </Fragment>

      <SectionTabbedStat
        items={levels.map((l) => ({ value: l.level, label: l.level, sublabel: `ages ${l.ages}` }))}
        accentColor="orange"
        ariaLabel="Your child's level"
        class="level-picker"
      >
        {
          levels.map((l, i) => (
            <div data-tabbed-stat-panel={l.level} hidden={i !== 0} aria-live="polite">
              <div class="grid gap-4">
                <CardStat
                  fill="none"
                  valueSize="md"
                  value={`${l.readBenchPct}%`}
                  label="at or above the national reading benchmark"
                  note={`${l.readBenchAt} of ${l.readBenchN} ${l.level} students assessed in spring '26`}
                  accentColor="orange"
                />
                {l.readGrowthMedian != null && (
                  <>
                    <CardStat
                      fill="none"
                      valueSize="md"
                      value={`+${l.readGrowthMedian} pts`}
                      label="typical reading growth in one year"
                      note={`median scaled-score change across the ${l.readGrowthN} ${l.level} students assessed autumn and spring`}
                      accentColor="orange"
                    />
                    <CardStat
                      fill="none"
                      valueSize="md"
                      value={`${l.readGrewPct}%`}
                      label="grew their reading score"
                      note={`autumn to spring, same group of ${l.readGrowthN} students`}
                      accentColor="orange"
                    />
                  </>
                )}
              </div>
              {l.readGrowthMedian == null && (
                <p class="mt-4 text-body-2 text-coal-black">
                  Fewer than 10 {l.level} students were assessed at both points of the year, so we
                  don't report a growth figure — small groups aren't statistically reliable, and
                  we'd rather show you less than stretch the truth.
                </p>
              )}
              <p class="mt-4 text-body-2 text-coal-black">
                Want to see what a typical week looks like for a {l.level} student (ages {l.ages})?
                <UiLink href={SITE} cardFill="accent">Visit bina to learn more</UiLink>.
              </p>
            </div>
          ))
        }
      </SectionTabbedStat>
  </LayoutStatSection>

  <!-- tenure chart -->
  <LayoutStatSection eyebrow="Time with bina" heading="The longer at bina, the further ahead in reading" accentColor="purple">
    <Fragment slot="intro">
      Every group of bina students reads above the U.S. national average — and the gap widens the
      longer they've been with us. Each bar shows how far a group sits <strong>above</strong> the
      national average.
    </Fragment>
      <figure class="card_base bg-coal-black p-6 sm:p-8">
        <ChartVerticalBar
          bars={tenure.map((b) => ({
            label: b.label,
            value: b.aboveNational,
            title: `${b.label} at bina — ${b.n} students, average reading NCE ${b.readNceMean} (national average = 50)`,
          }))}
          baselineLabel="national average reading level"
          valuePrefix="+"
          fillColor="#b38cff"
          hoverColor="#fe6c23"
          cardFill="dark"
          accentColor="purple"
          ariaLabel="Reading scores above the national average, by time enrolled at bina — from 5.4 points above for newer students to 10.7 points above after 2–3 years"
        />
        <figcaption class="mt-4 text-body-3 text-bina-purple">
          Average reading score in NCE points above the U.S. national average (50), spring '26,
          grouped by how long each student has been enrolled. Groups with fewer than 10 students
          aren't shown — too small to report reliably.
        </figcaption>
      </figure>
  </LayoutStatSection>

  <!-- understanding STAR -->
  <LayoutStatSection eyebrow="Understanding STAR" heading="Who marks our homework?" accentColor="green">
    <Fragment slot="intro">
      Not us. Every number on this page comes from <strong>Renaissance STAR</strong> — an
      independent assessment sat by millions of U.S. students. Here's what that means, and what
      each term on this page actually says about a child.
    </Fragment>

      <div class="mb-6 grid gap-4 md:grid-cols-3">
        <div class="card_base bg-bina-green flex flex-col gap-2 p-6">
          <span class="pill_solid self-start text-body-3">independent</span>
          <p class="font-display text-body-3 font-bold text-coal-black">Built and scored outside bina</p>
          <p class="text-body-3 text-coal-black">
            Renaissance Learning sets the questions and the national comparisons — we can't tune
            either.
          </p>
        </div>
        <div class="card_base bg-bina-green flex flex-col gap-2 p-6">
          <span class="pill_solid self-start text-body-3">adaptive</span>
          <p class="font-display text-body-3 font-bold text-coal-black">It finds each child's real level</p>
          <p class="text-body-3 text-coal-black">
            Questions get harder or easier as a child answers, so the result reflects what they can
            genuinely do.
          </p>
        </div>
        <div class="card_base bg-bina-green flex flex-col gap-2 p-6">
          <span class="pill_solid self-start text-body-3">nationally normed</span>
          <p class="font-display text-body-3 font-bold text-coal-black">Compared to U.S. peers, not to us</p>
          <p class="text-body-3 text-coal-black">
            "On track" means on track against the whole country's students in the same grade.
          </p>
        </div>
      </div>

      <UiAccordion items={explainers} />
  </LayoutStatSection>

  <!-- CTA -->
  <section class="bg-dark-bg">
    <div class="relative z-[1] mx-auto max-w-4xl px-5 py-16 text-center">
      <h2 class="mb-4 text-section text-bina-grass">
        Curious what a year at bina could do for your child?
      </h2>
      <p class="mx-auto mb-8 max-w-xl text-body-2 text-bina-grass">
        See how bina teaches, how we track every child's progress, and how to start — all on our
        main site.
      </p>
      <div class="flex justify-center">
        <a href={SITE} class="ui_button">Visit bina</a>
      </div>
    </div>
  </section>

  <p slot="footer-note" class="text-small text-bina-grass">
    Results reflect the {year} school year and are school-wide aggregates from Renaissance STAR
    assessments. Individual results vary, and past results don't guarantee future ones. Learn more
    about STAR at <UiLink href="https://www.renaissance.com/products/star-assessments/" cardFill="dark" accentColor="grass">renaissance.com</UiLink>.
  </p>

  <style>
    /* page-wide dark background — this page only, not a site-wide toggle */
    :global(body) {
      background: var(--color-dark-bg);
    }
    .chart-label {
      font-family: 'Rund Display', Arial, sans-serif;
      font-weight: 700;
      font-size: 18px;
      fill: var(--color-bina-pink);
    }
    .curve-oct,
    .curve-may {
      transition: opacity 0.2s ease-out;
    }
    /* scroll-in animation, curves rise one after the other */
    .curve-card .curve-oct,
    .curve-card .curve-may {
      opacity: 0;
      transform: translateY(14px);
      transition:
        opacity 0.7s ease-out,
        transform 0.7s ease-out;
    }
    .curve-card.in .curve-oct {
      opacity: 1;
      transform: none;
    }
    .curve-card.in .curve-may {
      opacity: 1;
      transform: none;
      transition-delay: 0.55s;
    }
    @media (prefers-reduced-motion: reduce) {
      .curve-card .curve-oct,
      .curve-card .curve-may {
        opacity: 1;
        transform: none;
        transition: none;
      }
    }
  </style>

  <script define:vars={{ levels }}>
    // ---- distribution-curve reveal (the bell-curve chart stays bespoke, so this stays too —
    //      count-up stat tiles now self-animate via card_stat.astro's own script) ----
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (!e.isIntersecting) return;
            io.unobserve(e.target);
            e.target.classList.add('in');
          });
        },
        { threshold: 0.35 }
      );
      document.querySelectorAll('.curve-card').forEach((el) => io.observe(el));
    } else {
      document.querySelectorAll('.curve-card').forEach((el) => el.classList.add('in'));
    }

    // ---- level picker ----
    // All per-level content is pre-rendered at build time now (SectionTabbedStat + CardStat,
    // fill="none" — see the static markup above), so this script only needs to (a) sync the
    // selected level into the URL for sharing/deep-linking, and (b) apply a requested `?level=`
    // deep link on load by clicking the matching tab — the component's own click handler does
    // the actual panel show/hide, this doesn't duplicate that logic.
    const levelPicker = document.querySelector('.level-picker');
    if (levelPicker) {
      levelPicker.addEventListener('tabchange', (e) => {
        const url = new URL(location);
        url.searchParams.set('level', e.detail.value);
        history.replaceState(null, '', url);
      });

      const requested = new URLSearchParams(location.search).get('level');
      const validLevels = levels.map((l) => l.level);
      if (requested && validLevels.includes(requested)) {
        const tab = levelPicker.querySelector(`[data-value="${requested}"]`);
        tab?.click();
      }
    }
  </script>
</BaseLayout>
