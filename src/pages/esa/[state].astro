---
/*
 * Paid-search ESA landing pages — one static URL per state we can actually serve.
 *
 * Different job from /esa: that page is the process tool a family uses once they have
 * already chosen bina. This one has to sell the school AND clear the funding gate in the
 * same breath, because the search behind it ("esa online school", "online school that
 * accepts esa") is a parent shopping for a school with a hard go/no-go attached.
 *
 * Program facts come from esa-states.json only. Proof numbers are imported from the other
 * pages' data files, never re-typed. Sales copy lives in esa-landing.json.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PillLabel from '../../components/sections/pill_label.astro';
import UiAccordion from '../../components/sections/ui_accordion.astro';
import LayoutSequenceSteps from '../../components/sections/layout_sequence_steps.astro';
import LayoutStatSection from '../../components/sections/layout_stat_section.astro';
import CardStat from '../../components/sections/card_stat.astro';
import PillOutline from '../../components/sections/pill_outline.astro';
import UiLink from '../../components/sections/ui_link.astro';
import landing from '../../data/esa-landing.json';
import esaData from '../../data/esa-states.json';
import survey from '../../data/family-survey.json';
import results from '../../data/student-results.json';
import reviewData from '../../data/reviews.json';

export function getStaticPaths() {
  return landing.states.map((s) => ({ params: { state: s.slug }, props: { copy: s } }));
}

const { copy } = Astro.props;
const { school, faq, reviewIds, tierCopy } = landing;

// Program facts: esa-states.json is the only source. Fail loudly rather than ship a page
// with invented numbers if the state ever disappears from the database.
const program = esaData.programs.find((p) => p.s === copy.state);
if (!program) throw new Error(`No esa-states.json entry for ${copy.state} — sync the ESA database first.`);

const tier = tierCopy[copy.tier];
const live = copy.tier === 'funded' || copy.tier === 'reimbursed';

// Hero fact-card #1's headline word — derived from the state's existing `tier` (already loaded
// data), not a new per-state field. "Approved"/"Qualifies" cover the two tiers every one of the 5
// live states currently uses; "Pending" covers the two tiers that exist in `tierCopy` but aren't in
// use yet (`vendor-pending`, `application-pending`) — see the hero fact-card block below for the
// "state has a program but it isn't live yet" fallback this feeds.
const approvalWord = { funded: 'Approved', reimbursed: 'Qualifies', 'vendor-pending': 'Pending', 'application-pending': 'Pending' }[copy.tier];

// Money math, computed rather than written down, so a tuition change flows through.
const usd = (n) => '$' + n.toLocaleString('en-US');
const gapHigh = school.tuitionYearly - copy.esaMin;
const gapLow = school.tuitionYearly - copy.esaMax;
const perMonth = (gap) => Math.round(gap / 12);
const awardLabel =
  copy.esaMin === copy.esaMax ? usd(copy.esaMax) : `${usd(copy.esaMin)}–${usd(copy.esaMax)}`;
// Fail the build if the ESA database moves and this page's award drifts out of step with it.
for (const n of new Set([copy.esaMin, copy.esaMax])) {
  if (!program.howMuch.includes(usd(n)))
    throw new Error(
      `${copy.state}: esa-landing.json says ${usd(n)} but esa-states.json says "${program.howMuch}" — reconcile them.`
    );
}
// The base award is what we quote; several states pay more for children with special needs.
const awardNote = /special needs/i.test(program.howMuch)
  ? 'The base award. Several states pay more for a child with special needs.'
  : `Paid through ${program.platform}.`;
const gapLabel = {
  funded: 'is what you cover yourself',
  reimbursed: 'your net cost after the refund',
  'vendor-pending': "is what you'd cover once the funding is live",
  'application-pending': "is what you'd cover once the funding is live",
}[copy.tier];
const monthLabel =
  gapLow === gapHigh
    ? `about ${usd(perMonth(gapHigh))} a month`
    : `about ${usd(perMonth(gapLow))}–${usd(perMonth(gapHigh))} a month`;

const reviews = reviewIds.map((id) => reviewData.reviews.find((r) => r.id === id)).filter(Boolean);
const sourceLabel = { niche: 'Niche', trustpilot: 'Trustpilot', site: 'thebinaschool.com' };
const reviewDate = (d) =>
  d ? new Date(d + 'T00:00:00Z').toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' }) : null;

const CTA = 'https://form.thebinaschool.com/new';
const CTA_LABEL = 'Start your bina journey';

const steps = [
  {
    number: '1',
    title: 'Talk to us first',
    description: `With bina — one call. We tell you what bina costs, what ${program.prog} covers in ${copy.state}, and what is left for you — before you fill in anything.`,
  },
  {
    number: '2',
    title: `Apply on ${copy.state}'s own portal`,
    description: `On ${copy.state}'s site — ${program.applyWindow} Apply directly on ${copy.state}'s own portal.`,
  },
  {
    number: '3',
    title: 'Get approved and funded',
    description: `On ${copy.state}'s site — ${program.approval}`,
  },
  {
    number: '4',
    title: 'Start at bina',
    description: live
      ? `Together — we time your start around your funding date, and handle the ${program.platform} side with you.`
      : 'Together — you can start before the funding is settled — families do it every month — and we keep your paperwork ready for the day it lands.',
  },
];
---

<BaseLayout
  title={copy.seoTitle}
  description={copy.seoDesc}
  ctaHref={CTA}
  ctaLabel="Start your journey"
  decorationSet="deco_leaves"
>
  <!-- hero: the school claim and the funding gate in one screen -->
  <header class="bg-dark-bg">
    <div class="relative z-[1] mx-auto max-w-6xl px-8 py-[clamp(3rem,6vw,6rem)]">
      <PillLabel text={copy.pill} accentColor="purple" class="mb-6" />
      <h1 class="mb-5 max-w-3xl text-hero text-bina-purple">{copy.h1}</h1>
      <p class="mb-8 max-w-2xl text-body-2 text-bina-purple">{copy.lead}</p>

      <div class="mb-10 flex flex-wrap items-center gap-3">
        <a
          href={`/esa?state=${encodeURIComponent(copy.state)}`}
          class="ui_button_ghost !border-bina-purple !bg-transparent !text-bina-purple hover:!border-coal-black hover:!bg-bina-purple hover:!text-coal-black active:!border-coal-black active:!bg-bina-purple active:!text-coal-black"
        >
          See every step for {copy.state}
        </a>
        <a href={CTA} class="ui_button">{CTA_LABEL}</a>
      </div>

      <!-- the funding claim: three facts, one message (Rule 14 — purple throughout), each a
           value + one supporting line rather than a run-in checklist. Reuses CardStat (fill="dark",
           labelColor="muted" — see that component's own doc comment) rather than a new component. -->
      <div class="grid gap-4 pt-8 sm:grid-cols-3">
        <CardStat fill="dark" labelColor="muted" accentColor="purple" valueSize="md" value={approvalWord} label={copy.gate[0]} />
        <CardStat fill="dark" labelColor="muted" accentColor="purple" valueSize="md" value={awardLabel} label="per child, per year" />
        <CardStat fill="dark" labelColor="muted" accentColor="purple" valueSize="md" value={program.platform} label="how you spend the funding" />
      </div>

      <!-- supporting credentials: gray, not accent — see CLAUDE.md's note on this pattern
           (primary message vs. supporting facts) below the pill_outline.astro entry. -->
      <ul class="mt-6 flex flex-wrap gap-2">
        <li><PillOutline>Ages {school.ages.replace(' to ', '–')}</PillOutline></li>
        {school.dayFacts.map((f) => <li><PillOutline>{f}</PillOutline></li>)}
        {school.accreditations.map((a) => <li><PillOutline>{a}</PillOutline></li>)}
      </ul>
    </div>
  </header>

  <!-- proof: is this actually a good school? -->
  <LayoutStatSection
    heading={`The school, before the money: our families score us ${survey.headline.recommendAvg} out of 10`}
    accentColor="green"
  >
    <Fragment slot="intro">
      The funding only matters if the school is worth it. So here is our own survey data, our own
      assessment results, and every review we have — including the platforms we cannot edit.
    </Fragment>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <CardStat value={String(survey.headline.recommendAvg)} label="Parents would send their friends here" accentColor="green">
          <Fragment slot="note">
            out of 10, from {survey.surveyA.n} families · <UiLink href="/family-survey" cardFill="accent">all seven scores</UiLink>
          </Fragment>
        </CardStat>
        <CardStat value={`${reviewData.headline.nicheAvg.toFixed(1)} ★`} label="Every review on Niche is five stars" accentColor="green">
          <Fragment slot="note">
            {reviewData.headline.nicheCount} reviews · <UiLink href="/reviews" cardFill="accent">read all of them</UiLink>
          </Fragment>
        </CardStat>
        <CardStat value={`+${results.headline.readGrowthAvg}`} label="Points of reading growth in one school year" accentColor="green">
          <Fragment slot="note">
            STAR, {results.headline.pairedN} students · <UiLink href="/student-results" cardFill="accent">the full results</UiLink>
          </Fragment>
        </CardStat>
        <CardStat value={String(school.classCap)} label="The most children your child's class can hold" note="a cap, not an average" accentColor="green" />
      </div>
  </LayoutStatSection>

  <!-- the money: what the program pays, and what it does not -->
  <LayoutStatSection eyebrow={`${program.prog} · ${tier.label}`} heading={copy.coverTitle} accentColor="blue" introClass="max-w-3xl">
    <Fragment slot="intro">{copy.coverBody}</Fragment>
      <div class="grid gap-4 md:grid-cols-3">
        <CardStat value={awardLabel} label="per child, per year" note={awardNote} accentColor="blue" valueSize="md" />
        <CardStat value={usd(school.tuitionYearly)} label="a full year at bina, on the yearly plan" accentColor="blue" valueSize="md">
          <Fragment slot="note">
            {usd(school.tuitionQuarterly)} on the quarterly plan ·
            <UiLink href={school.tuitionUrl} cardFill="accent">tuition page</UiLink>
          </Fragment>
        </CardStat>
        <CardStat value={monthLabel.replace('about ', '')} label={gapLabel} note={`before ${usd(school.siblingDiscount)} off per additional child`} accentColor="blue" valueSize="md" />
      </div>

      <div class="card_base bg-bina-blue mt-6 p-6">
        <h3 class="mb-2 font-display text-body-2 text-coal-black">Who can apply, and where the money sits</h3>
        <dl class="grid gap-4 sm:grid-cols-3">
          <div>
            <dt class="font-display text-body-3 font-bold uppercase text-coal-black">Who qualifies</dt>
            <dd class="mt-1 text-body-3 text-coal-black">{program.who}</dd>
          </div>
          <div>
            <dt class="font-display text-body-3 font-bold uppercase text-coal-black">How you spend it</dt>
            <dd class="mt-1 text-body-3 text-coal-black">Through {program.platform}.</dd>
          </div>
          <div>
            <dt class="font-display text-body-3 font-bold uppercase text-coal-black">Official program</dt>
            <dd class="mt-1 text-body-3 text-coal-black">
              <UiLink href={program.officialUrl} variant="standalone" cardFill="accent">{copy.state}'s own site</UiLink>
            </dd>
          </div>
        </dl>
        <p class="mt-4 text-body-3 text-coal-black">
          Amounts, deadlines and rules are set by {copy.state} and can change. Treat your state's
          official program site as the final word — and we will go through it with you on the call.
        </p>
      </div>

      {
        !live && (
          <div class="card_base bg-bina-blue mt-6 p-6">
            <p class="pill_solid mb-3 text-body-3">{tier.label}</p>
            <h3 class="mb-2 font-display text-body-2 text-coal-black">{tier.note}</h3>
            <p class="text-body-3 text-coal-black">
              We would rather lose the click here than have you find this out at the checkout. Families
              in {copy.state} do join bina in the meantime — {' '}
              <UiLink href={CTA} cardFill="accent">talk to us</UiLink> and we will tell you exactly where
              your state stands the day anything changes.
            </p>
          </div>
        )
      }
  </LayoutStatSection>

  <!-- the school itself -->
  <section class="bg-dark-bg">
    <div class="relative z-[1] mx-auto max-w-6xl px-8 py-[clamp(3rem,6vw,6rem)]">
      <h2 class="mb-3 text-section text-bina-orange">What the money actually buys your child</h2>
      <p class="mb-8 max-w-2xl text-body-2 text-bina-orange">
        Not a curriculum in a box and not a video library. A school: a class, a timetable, the same
        teachers every day.
      </p>
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {
          school.features.map((f) => (
            <div class="card_base bg-bina-orange p-6">
              <p class="mb-2 font-display text-body-3 font-bold uppercase text-coal-black">
                {f.eyebrow}
              </p>
              <h3 class="mb-2 font-display text-body-3 leading-snug text-coal-black">{f.title}</h3>
              <p class="text-body-3 text-coal-black">{f.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- projection: picture your own week -->
  <section class="bg-dark-bg">
    <div class="relative z-[1] mx-auto max-w-6xl px-8 py-[clamp(3rem,6vw,6rem)]">
      <h2 class="mb-3 text-section text-bina-pink">Your Tuesday, if your child were at bina</h2>
      <p class="mb-8 max-w-2xl text-body-2 text-bina-pink">
        The school day fits your time zone, so this shape holds whether you are in {copy.state} or
        three flights away from it.
      </p>
      <ol class="grid gap-4 sm:grid-cols-2">
        {
          school.dayInLife.map((d) => (
            <li class="card_base bg-bina-pink p-5">
              <p class="font-display text-body-3 font-bold uppercase text-coal-black">{d.time}</p>
              <p class="mt-1 text-body-3 font-medium text-coal-black">{d.what}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- steps -->
  <section class="bg-dark-bg">
    <div class="relative z-[1] mx-auto max-w-6xl px-8 py-[clamp(3rem,6vw,6rem)]">
      <h2 class="mb-3 text-section text-bina-red">Four steps, and we are on the call for all of them</h2>
      <p class="mb-10 max-w-2xl text-body-2 text-bina-red">
        Two happen with us, two happen on {copy.state}'s website — and you never have to work out
        which is which on your own.
      </p>
      <LayoutSequenceSteps steps={steps} accentColor="red" />

      <div class="card_base bg-bina-red mt-10 p-6 sm:p-8">
        <h3 class="mb-2 font-display text-body-2 text-coal-black">{copy.timingTitle}</h3>
        <p class="text-body-3 text-coal-black">{copy.timingBody}</p>
        <a href={CTA} class="ui_button mt-5">{CTA_LABEL}</a>
      </div>
    </div>
  </section>

  <!-- reviews -->
  <section class="bg-dark-bg">
    <div class="relative z-[1] mx-auto max-w-6xl px-8 py-[clamp(3rem,6vw,6rem)]">
      <h2 class="mb-3 text-section text-bina-grass">Families who made this exact decision</h2>
      <p class="mb-8 max-w-2xl text-body-2 text-bina-grass">
        Copied word for word, nothing trimmed. There are
        {' '}{reviewData.reviews.length - reviews.length} more on
        {' '}<UiLink href="/reviews" cardFill="dark" accentColor="grass">our reviews page</UiLink>, including the platforms
        where we do not control what gets published.
      </p>
      <div class="grid gap-4 md:grid-cols-3">
        {
          reviews.map((r) => (
            <figure class="card_base bg-bina-grass flex h-full flex-col p-6">
              <blockquote class="grow whitespace-pre-line text-body-3 text-coal-black">{r.body}</blockquote>
              <figcaption class="mt-4 font-display text-body-3 font-bold text-coal-black">
                {r.roleLabel} · {sourceLabel[r.source]}
                {reviewDate(r.date) ? ` · ${reviewDate(r.date)}` : ''}
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <!-- questions parents actually ask -->
  <section class="bg-dark-bg">
    <div class="relative z-[1] mx-auto max-w-6xl px-8 py-[clamp(3rem,6vw,6rem)]">
      <div class="max-w-3xl">
        <UiAccordion
          title="The questions everyone asks on the first call"
          items={faq.map((f) => ({ question: f.q, answer: f.a }))}
        />
      </div>
    </div>
  </section>

  <!-- close -->
  <section class="bg-dark-bg text-bina-grass">
    <div class="relative z-[1] mx-auto max-w-4xl px-5 py-16 text-center">
      <h2 class="mb-4 text-section text-bina-grass">
        One call tells you whether this works for your family
      </h2>
      <p class="mx-auto mb-8 max-w-2xl text-body-2 text-bina-grass">
        We will put your {copy.state} numbers next to bina's, in writing, and you can decide with the
        whole picture in front of you. No obligation, and no pretending the funding is simpler than it is.
      </p>
      <a href={CTA} class="ui_button">{CTA_LABEL}</a>
      <p class="mt-6 text-body-3 text-bina-grass">
        Prefer email? <UiLink href="mailto:admissions@thebinaschool.com" cardFill="dark" accentColor="grass">admissions@thebinaschool.com</UiLink>
      </p>
    </div>
  </section>

  <!-- where every number came from -->
  <section class="bg-dark-bg">
    <div class="relative z-[1] mx-auto max-w-6xl px-8 py-[clamp(3rem,6vw,6rem)]">
      <h2 class="mb-4 font-display text-body-2 text-bina-blue">Where these numbers come from</h2>
      <ul class="grid gap-2 text-body-3 text-bina-blue">
        <li>
          <strong>{copy.state} program details</strong> — the bina team's ESA database, current as of
          this page's last update. {copy.state} sets the rules and can change them;
          <UiLink href={program.officialUrl} cardFill="dark" accentColor="blue"> the official program site</UiLink> is the final word.
        </li>
        <li>
          <strong>Tuition</strong> — published on
          <UiLink href={school.tuitionUrl} cardFill="dark" accentColor="blue"> thebinaschool.com/tuition</UiLink>. The monthly figure
          on this page is simple arithmetic: yearly tuition minus the base award, divided by 12, before
          sibling discounts. Awards for children with special needs are higher in several states.
        </li>
        <li>
          <strong>{survey.headline.recommendAvg} out of 10</strong> — our own family survey,
          {' '}{survey.surveyA.n} families, {survey.surveyA.responseRatePct}% response rate. Families who
          answer a survey are more positive than those who do not; every score, including our weakest, is
          on <UiLink href="/family-survey" cardFill="dark" accentColor="blue">the survey page</UiLink>.
        </li>
        <li>
          <strong>+{results.headline.readGrowthAvg} reading points</strong> — STAR assessments,
          Oct '25 to May '26, the {results.headline.pairedN} students assessed at both points at the same
          level. Aggregates only, on <UiLink href="/student-results" cardFill="dark" accentColor="blue">the results page</UiLink>.
        </li>
        <li>
          <strong>Reviews</strong> — copied verbatim from Niche, where we cannot edit or remove anything.
          The full set is on <UiLink href="/reviews" cardFill="dark" accentColor="blue">our reviews page</UiLink>.
        </li>
      </ul>
    </div>
  </section>

  <p slot="footer-note" class="mx-auto max-w-2xl text-small text-bina-grass">
    {program.prog} is run by the state of {copy.state}, not by bina. Program amounts, eligibility and
    deadlines are subject to change — always confirm with
    <UiLink href={program.officialUrl} cardFill="dark" accentColor="grass">the official program site</UiLink> before
    you rely on a number here.
  </p>

  <style>
    /* page-wide dark background — this page only, not a site-wide toggle */
    :global(body) {
      background: var(--color-dark-bg);
    }
  </style>
</BaseLayout>
