---
/*
 * /esa/<state> — one page per state where bina can accept students. Five of them.
 *
 * Layout (Zeyu, 2026-11-04 — Arizona copy first, the same template for all five):
 * hero → the money → the full process → CTA → FAQ. Sections whose copy lives in the team's
 * Notion page (who qualifies, how the ESA works, paying in ClassWallet, getting to know bina)
 * render only for states whose esa-landing.json entry carries them.
 *
 * The 45 states we cannot serve are not pages — they redirect to /esa (astro.config.mjs).
 * Program facts come from esa-states.json only; sales copy from esa-landing.json.
 */
import CtaBlock from '../../components/CtaBlock.astro';
import Accordion from '../../components/Accordion.astro';
import BrandText from '../../components/BrandText.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EsaProcess from '../../components/EsaProcess.astro';
import landing from '../../data/esa-landing.json';
import { CTA, CTA_LABEL, statePage, usd } from '../../lib/esa-states.js';

export function getStaticPaths() {
  return landing.states.map((s) => ({ params: { state: s.slug }, props: { slug: s.slug } }));
}

const page = statePage(Astro.props.slug);
const { copy, program, reimbursed, tier, awardLabel, awardNote, monthLabel, gapLabel, questions, payRows, monthLow, monthHigh } = page;
const { school } = landing;
// Per-state copy with a neutral fallback, so a state without its new copy yet still reads right.
const moneyTitle = copy.moneyTitle ?? `What you pay with ${copy.state}'s funding`;
const ctaTitle = copy.ctaTitle ?? `See how ${copy.state}'s funding works at bina`;
---

<BaseLayout
  title={copy.seoTitle}
  description={copy.seoDesc}
  ctaHref={CTA}
  ctaLabel="Start your journey"
>
  <!-- HERO: the claim, the funding gate, and what this page is -->
  <header class="theme-lagoon">
    <div class="mx-auto max-w-5xl px-5 py-14 sm:py-20">
      <p class="eyebrow-line mb-5"><BrandText text={copy.pill} /></p>
      <div class="mb-10 flex flex-wrap items-end gap-x-6 gap-y-4">
        <h1 class="max-w-3xl text-title-3xl sm:text-display-sm">
          {/* The hero's one colored word: "bina" in deep ocean, as on every other page. */}
          {copy.h1.split('bina')[0]}<span class="text-deep-ocean">bina</span>{copy.h1.split('bina').slice(1).join('bina')}
        </h1>
        {
          copy.heroBadge && (
            <span class="mb-2 inline-flex flex-none items-center rounded-full bg-black px-4 py-2 font-display text-label uppercase text-lagoon">
              <BrandText text={copy.heroBadge} />
            </span>
          )
        }
      </div>

      <ul class="grid gap-3 sm:grid-cols-3">
        {
          copy.gate.map((g) => (
            <li class="flex items-start gap-3">
              <span
                class="mt-0.5 grid h-6 w-6 flex-none place-items-center rounded-full bg-black font-display text-body-md font-bold text-lagoon"
                aria-hidden="true"
              >
                ✓
              </span>
              <span class="font-display font-bold leading-snug">{g}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </header>

  <!-- THE MONEY: dark section, mint stat cards (the /student-results tiles): deep ocean number and claim, black detail -->
  <section class="theme-base">
    <div class="mx-auto max-w-5xl px-5 py-14">
      <p class="eyebrow-bina mb-2">
        {program.prog} · {tier.label}
      </p>
      <h2 class="mb-8 text-title-xl sm:text-title-3xl">{moneyTitle}</h2>

      <div class="grid gap-4 md:grid-cols-3">
        <div class="card-bina-mint p-6">
          <p class="font-display text-title-2xl font-bold text-hl">{awardLabel}</p>
          <p class="mt-2 font-display font-bold text-hl">per child, per year</p>
          <p class="mt-1 text-body-lg">{awardNote}</p>
        </div>
        <div class="card-bina-mint p-6">
          <p class="font-display text-title-2xl font-bold text-hl">{usd(school.tuitionYearly)}</p>
          <p class="mt-2 font-display font-bold text-hl">a full year at bina, on the yearly plan</p>
          <p class="mt-1 text-body-lg">
            {usd(school.tuitionQuarterly)} on the quarterly plan ·
            <a href={school.tuitionUrl} class="font-bold underline">tuition page</a>
          </p>
        </div>
        <div class="card-bina-mint p-6">
          <p class="font-display text-title-2xl font-bold text-hl">{monthLabel}<span class="text-body-xl">/mo</span></p>
          <p class="mt-2 font-display font-bold text-hl">{gapLabel}</p>
          <p class="mt-1 text-body-lg">
            before {usd(school.siblingDiscount)} off per additional child
          </p>
        </div>
      </div>

      <!-- What you pay, per plan (Arizona, from the Notion draft): one card per plan, worked out
           like a receipt — tuition, minus the award, then what is left. Numbers come from the data files. -->
      {
        copy.moneyTitle && (
          <div class="mt-10">
            <h3 class="mb-5 font-display text-title-lg font-bold">Your top-up, plan by plan</h3>
            <div class="grid gap-4 md:grid-cols-2">
              {payRows.map((r, i) => (
                <div class="card-bina-mint p-6 sm:p-8">
                  <p class="mb-5 font-display text-title-sm text-hl">{r.plan}</p>
                  <dl class="grid gap-2 text-body-lg">
                    <div class="flex items-baseline justify-between gap-4">
                      <dt><span class="normal-case">bina</span> tuition (per year)</dt>
                      <dd class="font-display font-bold">{usd(r.tuition)}</dd>
                    </div>
                    <div class="flex items-baseline justify-between gap-4 border-b border-black pb-3">
                      <dt>{copy.state} ESA gives you</dt>
                      <dd class="font-display font-bold">− {awardLabel}</dd>
                    </div>
                    <div class="pt-2">
                      <dt class="font-display font-bold">You pay</dt>
                      <dd>
                        <span class="block font-display text-title-xl font-bold text-hl">
                          {usd(r.payLow)}–{usd(r.payHigh)}<span class="text-body-xl"> a year</span>
                        </span>
                        {i === 0 && <span class="block">~{usd(monthLow)}–{usd(monthHigh)} a month</span>}
                        {i === 1 && (
                          <span class="block">~{usd(Math.round(r.payLow / 4))}–{usd(Math.round(r.payHigh / 4))} a quarter</span>
                        )}
                      </dd>
                    </div>
                  </dl>
                </div>
              ))}
            </div>
          </div>
        )
      }

      <!-- Who can apply: shown until a state has its own "Who qualifies" section. -->
      {!copy.qualifies && (
      <div class="mt-12">
        <h3 class="mb-5 font-display text-title-lg font-bold">Who can apply, and where the money sits</h3>
        <dl class="grid gap-4 sm:grid-cols-3">
          <div class="card-bina-mint p-6">
            <dt class="font-display text-title-sm text-hl">Who qualifies</dt>
            <dd class="mt-2">{program.who}</dd>
          </div>
          <div class="card-bina-mint p-6">
            <dt class="font-display text-title-sm text-hl">How you spend it</dt>
            <dd class="mt-2">
              {reimbursed ? tier.note : `Through ${program.platform} — the state pays bina directly.`}
            </dd>
          </div>
          <div class="card-bina-mint p-6">
            <dt class="font-display text-title-sm text-hl">Official program</dt>
            <dd class="mt-2">
              <a href={program.officialUrl} rel="noopener" class="font-bold underline">{copy.state}'s own site →</a>
            </dd>
          </div>
        </dl>
        <p class="mt-5">
          *Amounts, deadlines and rules are set by {copy.state} and can change. Treat your state's
          official program site as the final word — and we will go through it with you on the call.
        </p>
      </div>
      )}
    </div>
  </section>

  <!-- WHO QUALIFIES (states with Notion copy) -->
  {
    copy.qualifies && (
      <section class="theme-base">
        <div class="mx-auto max-w-5xl px-5 py-14">
          <p class="eyebrow-bina mb-2">Who qualifies</p>
          <h2 class="mb-8 text-title-xl sm:text-title-3xl">{copy.qualifies.title}</h2>
          <!-- A checklist, not cards: one row per condition, ✓ + label on the left, and the
               first sentence (the answer) in bold so a scanner gets it without reading on. -->
          <dl class="border-t border-line">
            {copy.qualifies.items.map((it) => {
              const cut = it.v.indexOf('. ');
              const lead = cut === -1 ? it.v : it.v.slice(0, cut + 1);
              const rest = cut === -1 ? '' : it.v.slice(cut + 2);
              return (
                <div class="grid gap-x-8 gap-y-2 border-b border-line py-6 sm:grid-cols-[15rem_1fr]">
                  <dt class="flex items-center gap-3 font-display text-title-sm">
                    <span class="grid h-8 w-8 flex-none place-items-center rounded-full bg-lagoon font-display text-body-md font-bold text-black" aria-hidden="true">✓</span>
                    {it.k}
                  </dt>
                  <dd class="text-body-lg sm:pt-1">
                    <strong class="block font-display text-body-xl font-bold"><BrandText text={lead} /></strong>
                    {rest && <span class="mt-1 block"><BrandText text={rest} /></span>}
                  </dd>
                </div>
              );
            })}
          </dl>
        </div>
      </section>
    )
  }

  <!-- HOW THE ESA WORKS (states with Notion copy) -->
  {
    copy.howEsa && (
      <!-- A clover card on the dark section, built like the closing CTA block (left-aligned: it is a paragraph to read). -->
      <section class="theme-base">
        <div class="mx-auto max-w-5xl px-5 py-14">
          <div class="theme-clover rounded-lg px-6 py-12 sm:px-12 sm:py-16">
            <p class="eyebrow-line mb-2">How the {copy.state} ESA works</p>
            <h2 class="mb-4 text-title-xl sm:text-title-3xl">{copy.howEsa.title}</h2>
            <p class="max-w-3xl text-body-xl"><BrandText text={copy.howEsa.body} /></p>
          </div>
        </div>
      </section>
    )
  }

  <!-- PROCESS -->
  <EsaProcess page={page} />

  <!-- PAYING BINA IN CLASSWALLET (states with Notion copy) -->
  {
    copy.classWallet && (
      <section class="theme-base">
        <div class="mx-auto max-w-5xl px-5 py-14">
          <p class="eyebrow-bina mb-2">Paying <span class="normal-case">bina</span> in ClassWallet</p>
          <h2 class="mb-8 text-title-xl sm:text-title-3xl"><BrandText text={copy.classWallet.title} /></h2>
          <!-- A plain numbered list (lagoon badges on dark), same pattern as "What you do". -->
          <ol class="m-0 grid list-none gap-4 p-0">
            {copy.classWallet.steps.map((t, i) => (
              <li class="flex items-start gap-4">
                <span class="grid h-8 w-8 flex-none place-items-center rounded-full bg-lagoon font-display text-body-md font-bold text-black" aria-hidden="true">
                  {i + 1}
                </span>
                <span class="pt-1 font-display font-bold leading-snug"><BrandText text={t} /></span>
              </li>
            ))}
          </ol>
          {copy.classWallet.videoUrl && (
            <p class="mt-6 text-body-lg">
              <a href={copy.classWallet.videoUrl} target="_blank" rel="noopener" class="font-bold underline">
                {copy.classWallet.videoLabel} ↗
              </a>
            </p>
          )}
        </div>
      </section>
    )
  }

  <!-- GETTING TO KNOW BINA (states with Notion copy): an editorial split so it reads apart from
       the checklists above — heading and link on the left, each fact as a large statement on the right
       (no rules — Zeyu, 2026-11-04). -->
  {
    copy.about && (
      <section class="theme-base">
        <div class="mx-auto grid max-w-5xl gap-10 px-5 py-16 md:grid-cols-[1fr_1.6fr] md:gap-16">
          <div>
            <h2 class="text-title-3xl text-lagoon sm:text-display-sm"><BrandText text={copy.about.title} /></h2>
          </div>
          <ul class="m-0 grid list-none gap-5 p-0 md:pt-2">
            {copy.about.bullets.map((b) => (
              <li class="font-display text-title-md font-bold sm:text-title-lg">{b}</li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <!-- close: before the FAQ, so the FAQ is the last section -->
  <CtaBlock>
    <h2 class="cta-title text-title-xl sm:text-title-3xl"><BrandText text={ctaTitle} /></h2>
    <p class="cta-copy">
      We will put your {copy.state} numbers next to bina's, in writing, and you can decide with the
      whole picture in front of you. No obligation, and no pretending the funding is simpler than it is.
    </p>
    <div class="cta-actions">
      <a href={copy.callUrl ?? '#'} class="btn-bina-secondary">Book an ESA call</a>
      <a href={CTA} class="btn-bina">{CTA_LABEL}</a>
    </div>
  </CtaBlock>

  <!-- FAQ: the last section before the footer -->
  <section class="theme-base">
    <div class="mx-auto max-w-5xl px-5 py-14">
      <h2 class="mb-8 text-title-xl sm:text-title-3xl">FAQ</h2>
      <Accordion items={questions} />
    </div>
  </section>


  <p slot="footer-note" class="max-w-2xl text-body-md">
    {program.prog} is run by the state of {copy.state}, not by bina. Program amounts, eligibility and
    deadlines are subject to change — always confirm with
    <a href={program.officialUrl} rel="noopener" class="font-bold underline">the official program site</a> before
    you rely on a number here.
  </p>
</BaseLayout>
