---
// Moved to thebinaschool.com/esa/<state> (2026-11-23). Redirect only, keeping query string and hash.
import MovedPage from '../../components/MovedPage.astro';
import landing from '../../data/esa-landing.json';

export function getStaticPaths() {
  return landing.states.map((s) => ({ params: { state: s.slug } }));
}

const { state } = Astro.params;
---

<MovedPage to={`https://thebinaschool.com/esa/${state}`} title="Use your ESA at bina" />
