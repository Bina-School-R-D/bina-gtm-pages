---
/*
 * /esa/<state> — one static page per state, all 50 of them.
 *
 * This is the same tool /esa always was; the state's answer is just server-rendered here
 * instead of injected into /esa?state=... at runtime. Every state the picker offers is a
 * real URL a family can be linked to and a crawler can read. Program facts come from
 * esa-states.json only — nothing on this page is written by hand.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import EsaHero from '../../components/EsaHero.astro';
import EsaPicker from '../../components/EsaPicker.astro';
import EsaStatePanel from '../../components/EsaStatePanel.astro';
import { stateNames, stateSlug } from '../../lib/esa-states.js';

export function getStaticPaths() {
  return stateNames.map((name) => ({ params: { state: stateSlug(name) }, props: { name } }));
}

const { name } = Astro.props;
---

<BaseLayout
  title="ESA Funding for bina — Parent Guide"
  description="See if your state's Education Savings Account (ESA) can help pay for bina — and the exact steps, from your first call with bina to tuition paid."
>
  <EsaHero>
    <h1 slot="heading" class="mb-5 max-w-3xl text-4xl font-black sm:text-6xl">
      Can an ESA help pay for <span class="underline decoration-bina-yellow decoration-8 underline-offset-4">bina</span>?
    </h1>
  </EsaHero>

  <EsaPicker selected={name}>
    <div class="mt-6">
      <EsaStatePanel state={name} />
    </div>
  </EsaPicker>

  <p slot="footer-note" class="text-xs text-white/60">
    Program details reflect the latest information available to the bina team and are subject to change — your state's official program site is the final word.
  </p>
</BaseLayout>
