---
/*
 * Paid-search ESA landing pages — one static URL per state we can actually serve.
 *
 * Different job from /esa: that page is the process tool a family uses once they have
 * already chosen bina. This one has to sell the school AND clear the funding gate in the
 * same breath, because the search behind it ("esa online school", "online school that
 * accepts esa") is a parent shopping for a school with a hard go/no-go attached.
 *
 * Program facts come from esa-states.json only. Proof numbers are imported from the other
 * pages' data files, never re-typed. Sales copy lives in esa-landing.json.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import landing from '../../data/esa-landing.json';
import esaData from '../../data/esa-states.json';
import survey from '../../data/family-survey.json';
import results from '../../data/student-results.json';
import reviewData from '../../data/reviews.json';

export function getStaticPaths() {
  return landing.states.map((s) => ({ params: { state: s.slug }, props: { copy: s } }));
}

const { copy } = Astro.props;
const { school, faq, reviewIds, tierCopy } = landing;

// Program facts: esa-states.json is the only source. Fail loudly rather than ship a page
// with invented numbers if the state ever disappears from the database.
const program = esaData.programs.find((p) => p.s === copy.state);
if (!program) throw new Error(`No esa-states.json entry for ${copy.state} — sync the ESA database first.`);

const tier = tierCopy[copy.tier];
const live = copy.tier === 'funded' || copy.tier === 'reimbursed';

// Money math, computed rather than written down, so a tuition change flows through.
const usd = (n) => '$' + n.toLocaleString('en-US');
const gapHigh = school.tuitionYearly - copy.esaMin;
const gapLow = school.tuitionYearly - copy.esaMax;
const perMonth = (gap) => Math.round(gap / 12);
const awardLabel =
  copy.esaMin === copy.esaMax ? usd(copy.esaMax) : `${usd(copy.esaMin)}–${usd(copy.esaMax)}`;
// Fail the build if the ESA database moves and this page's award drifts out of step with it.
for (const n of new Set([copy.esaMin, copy.esaMax])) {
  if (!program.howMuch.includes(usd(n)))
    throw new Error(
      `${copy.state}: esa-landing.json says ${usd(n)} but esa-states.json says "${program.howMuch}" — reconcile them.`
    );
}
// The base award is what we quote; several states pay more for children with special needs.
const awardNote = /special needs/i.test(program.howMuch)
  ? 'The base award. Several states pay more for a child with special needs.'
  : `Paid through ${program.platform}.`;
const gapLabel = {
  funded: 'is what you cover yourself',
  reimbursed: 'your net cost after the refund',
  'vendor-pending': "is what you'd cover once the funding is live",
  'application-pending': "is what you'd cover once the funding is live",
}[copy.tier];
const monthLabel =
  gapLow === gapHigh
    ? `about ${usd(perMonth(gapHigh))} a month`
    : `about ${usd(perMonth(gapLow))}–${usd(perMonth(gapHigh))} a month`;

const reviews = reviewIds.map((id) => reviewData.reviews.find((r) => r.id === id)).filter(Boolean);
const sourceLabel = { niche: 'Niche', trustpilot: 'Trustpilot', site: 'thebinaschool.com' };
const reviewDate = (d) =>
  d ? new Date(d + 'T00:00:00Z').toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' }) : null;

const CTA = 'https://form.thebinaschool.com/new';
const CTA_LABEL = 'Start your bina journey →';

const steps = [
  {
    who: 'bina',
    t: 'Talk to us first',
    d: `One call. We tell you what bina costs, what ${program.prog} covers in ${copy.state}, and what is left for you — before you fill in anything.`,
  },
  { who: 'state', t: `Apply on ${copy.state}'s own portal`, d: program.applyWindow, url: program.applyUrl },
  { who: 'state', t: 'Get approved and funded', d: program.approval },
  {
    who: 'both',
    t: 'Start at bina',
    d: live
      ? `We time your start around your funding date, and handle the ${program.platform} side with you.`
      : 'You can start before the funding is settled — families do it every month — and we keep your paperwork ready for the day it lands.',
  },
];

const dot = { bina: 'bg-bina-yellow', state: 'bg-bina-blue', both: 'bg-bina-grass' };
---

<BaseLayout
  title={copy.seoTitle}
  description={copy.seoDesc}
  ctaHref={CTA}
  ctaLabel="Start your journey"
>
  <!-- hero: the school claim and the funding gate in one screen -->
  <header class="bg-bina-purple">
    <div class="mx-auto max-w-5xl px-5 py-14 sm:py-20">
      <p class="pill-bina mb-6 text-sm tracking-wide">{copy.pill}</p>
      <h1 class="mb-5 max-w-3xl text-4xl font-black sm:text-6xl">{copy.h1}</h1>
      <p class="mb-8 max-w-2xl text-lg text-coal-1000 sm:text-xl">{copy.lead}</p>

      <div class="mb-10 flex flex-wrap items-center gap-3">
        <a href={CTA} class="btn-bina text-lg">{CTA_LABEL}</a>
        <a href={`/esa?state=${encodeURIComponent(copy.state)}`} class="btn-bina-ghost text-lg">
          See every step for {copy.state}
        </a>
      </div>

      <ul class="grid gap-3 border-t-2 border-coal-black/20 pt-8 sm:grid-cols-3">
        {
          copy.gate.map((g) => (
            <li class="flex items-start gap-3">
              <span
                class="mt-0.5 grid h-6 w-6 flex-none place-items-center rounded-full border-2 border-coal-black bg-white font-display text-xs font-black"
                aria-hidden="true"
              >
                ✓
              </span>
              <span class="font-display font-bold leading-snug">{g}</span>
            </li>
          ))
        }
      </ul>
      <p class="mt-6 text-sm font-medium text-coal-1000">
        Ages {school.ages} · {school.day} · {school.accreditations.join(' · ')}
      </p>
    </div>
  </header>

  <!-- proof: is this actually a good school? -->
  <section class="border-t-2 border-coal-black">
    <div class="mx-auto max-w-5xl px-5 py-14">
      <h2 class="mb-3 text-3xl sm:text-4xl">
        The school, before the money: our families score us {survey.headline.recommendAvg} out of 10
      </h2>
      <p class="mb-8 max-w-2xl text-coal-900">
        The funding only matters if the school is worth it. So here is our own survey data, our own
        assessment results, and every review we have — including the platforms we cannot edit.
      </p>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="card-bina p-6">
          <p class="font-display text-5xl font-black text-coal-black">{survey.headline.recommendAvg}</p>
          <p class="mt-2 font-display font-bold">Parents would send their friends here</p>
          <p class="mt-1 text-sm text-coal-900">
            out of 10, from {survey.surveyA.n} families · <a href="/family-survey" class="underline">all seven scores</a>
          </p>
        </div>
        <div class="card-bina p-6">
          <p class="font-display text-5xl font-black text-coal-black">{reviewData.headline.nicheAvg.toFixed(1)} ★</p>
          <p class="mt-2 font-display font-bold">Every review on Niche is five stars</p>
          <p class="mt-1 text-sm text-coal-900">
            {reviewData.headline.nicheCount} reviews · <a href="/reviews" class="underline">read all of them</a>
          </p>
        </div>
        <div class="card-bina p-6">
          <p class="font-display text-5xl font-black text-coal-black">+{results.headline.readGrowthAvg}</p>
          <p class="mt-2 font-display font-bold">Points of reading growth in one school year</p>
          <p class="mt-1 text-sm text-coal-900">
            STAR, {results.headline.pairedN} students · <a href="/student-results" class="underline">the full results</a>
          </p>
        </div>
        <div class="card-bina p-6">
          <p class="font-display text-5xl font-black text-coal-black">{school.classCap}</p>
          <p class="mt-2 font-display font-bold">The most children your child's class can hold</p>
          <p class="mt-1 text-sm text-coal-900">a cap, not an average</p>
        </div>
      </div>
    </div>
  </section>

  <!-- the money: what the program pays, and what it does not -->
  <section class="border-t-2 border-coal-black bg-bina-yellow/20">
    <div class="mx-auto max-w-5xl px-5 py-14">
      <p class="mb-2 font-display text-sm font-bold uppercase tracking-widest text-bina-pink">
        {program.prog} · {tier.label}
      </p>
      <h2 class="mb-3 text-3xl sm:text-4xl">{copy.coverTitle}</h2>
      <p class="mb-8 max-w-3xl text-lg text-coal-1000">{copy.coverBody}</p>

      <div class="grid gap-4 md:grid-cols-3">
        <div class="card-bina p-6">
          <p class="font-display text-3xl font-black">{awardLabel}</p>
          <p class="mt-2 font-display font-bold">per child, per year</p>
          <p class="mt-1 text-sm text-coal-900">{awardNote}</p>
        </div>
        <div class="card-bina p-6">
          <p class="font-display text-3xl font-black">{usd(school.tuitionYearly)}</p>
          <p class="mt-2 font-display font-bold">a full year at bina, on the yearly plan</p>
          <p class="mt-1 text-sm text-coal-900">
            {usd(school.tuitionQuarterly)} on the quarterly plan ·
            <a href={school.tuitionUrl} class="underline">tuition page</a>
          </p>
        </div>
        <div class="card-bina p-6">
          <p class="font-display text-3xl font-black">{monthLabel.replace('about ', '')}</p>
          <p class="mt-2 font-display font-bold">{gapLabel}</p>
          <p class="mt-1 text-sm text-coal-900">
            before {usd(school.siblingDiscount)} off per additional child
          </p>
        </div>
      </div>

      <div class="card-bina mt-6 p-6">
        <h3 class="mb-2 font-display text-xl">Who can apply, and where the money sits</h3>
        <dl class="grid gap-4 sm:grid-cols-3">
          <div>
            <dt class="font-display text-sm font-bold uppercase tracking-wide text-coal-900">Who qualifies</dt>
            <dd class="mt-1">{program.who}</dd>
          </div>
          <div>
            <dt class="font-display text-sm font-bold uppercase tracking-wide text-coal-900">How you spend it</dt>
            <dd class="mt-1">Through {program.platform}.</dd>
          </div>
          <div>
            <dt class="font-display text-sm font-bold uppercase tracking-wide text-coal-900">Official program</dt>
            <dd class="mt-1">
              <a href={program.officialUrl} rel="noopener" class="font-bold underline">{copy.state}'s own site →</a>
            </dd>
          </div>
        </dl>
        <p class="mt-4 text-sm text-coal-900">
          Amounts, deadlines and rules are set by {copy.state} and can change. Treat your state's
          official program site as the final word — and we will go through it with you on the call.
        </p>
      </div>

      {
        !live && (
          <div class="card-bina mt-6 border-4 bg-white p-6">
            <p class="pill-bina mb-3 text-xs tracking-wide">{tier.label}</p>
            <h3 class="mb-2 font-display text-xl">{tier.note}</h3>
            <p class="text-coal-1000">
              We would rather lose the click here than have you find this out at the checkout. Families
              in {copy.state} do join bina in the meantime — {' '}
              <a href={CTA} class="font-bold underline">talk to us</a> and we will tell you exactly where
              your state stands the day anything changes.
            </p>
          </div>
        )
      }
    </div>
  </section>

  <!-- the school itself -->
  <section class="border-t-2 border-coal-black">
    <div class="mx-auto max-w-5xl px-5 py-14">
      <h2 class="mb-3 text-3xl sm:text-4xl">What the money actually buys your child</h2>
      <p class="mb-8 max-w-2xl text-coal-900">
        Not a curriculum in a box and not a video library. A school: a class, a timetable, the same
        teachers every day.
      </p>
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {
          school.features.map((f) => (
            <div class="card-bina p-6">
              <p class="mb-2 font-display text-xs font-bold uppercase tracking-widest text-bina-pink">
                {f.eyebrow}
              </p>
              <h3 class="mb-2 font-display text-lg leading-snug">{f.title}</h3>
              <p class="text-sm text-coal-900">{f.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- projection: picture your own week -->
  <section class="border-t-2 border-coal-black bg-bina-grass/20">
    <div class="mx-auto max-w-4xl px-5 py-14">
      <h2 class="mb-3 text-3xl sm:text-4xl">Your Tuesday, if your child were at bina</h2>
      <p class="mb-8 max-w-2xl text-coal-900">
        The school day fits your time zone, so this shape holds whether you are in {copy.state} or
        three flights away from it.
      </p>
      <ol class="grid gap-4 sm:grid-cols-2">
        {
          school.dayInLife.map((d) => (
            <li class="card-bina p-5">
              <p class="font-display text-sm font-bold uppercase tracking-wide text-bina-pink">{d.time}</p>
              <p class="mt-1 font-medium text-coal-1000">{d.what}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- steps -->
  <section class="border-t-2 border-coal-black">
    <div class="mx-auto max-w-5xl px-5 py-14">
      <h2 class="mb-3 text-3xl sm:text-4xl">Four steps, and we are on the call for all of them</h2>
      <p class="mb-10 max-w-2xl text-coal-900">
        Two happen with us, two happen on {copy.state}'s website — and you never have to work out
        which is which on your own.
      </p>
      <ol class="grid gap-6 md:grid-cols-4">
        {
          steps.map((s, i) => (
            <li>
              <span class="mb-3 grid h-10 w-10 place-items-center rounded-full border-2 border-coal-black bg-white font-display text-base font-black">
                {i + 1}
              </span>
              <h3 class="mb-1.5 font-display text-base font-bold leading-snug">{s.t}</h3>
              <span class="mb-2 inline-flex items-center gap-1.5 font-display text-xs font-bold text-coal-900">
                <span class={`h-2.5 w-2.5 rounded-full border border-coal-black ${dot[s.who]}`} />
                {s.who === 'bina' ? 'with bina' : s.who === 'state' ? `on ${copy.state}'s site` : 'together'}
              </span>
              <p class="text-sm text-coal-900">{s.d}</p>
              {s.url && (
                <a href={s.url} rel="noopener" class="mt-2 inline-block text-sm font-bold underline">
                  {copy.state}'s portal →
                </a>
              )}
            </li>
          ))
        }
      </ol>

      <div class="card-bina mt-10 p-6 sm:p-8">
        <h3 class="mb-2 font-display text-xl">{copy.timingTitle}</h3>
        <p class="text-coal-1000">{copy.timingBody}</p>
        <a href={CTA} class="btn-bina mt-5">{CTA_LABEL}</a>
      </div>
    </div>
  </section>

  <!-- reviews -->
  <section class="border-t-2 border-coal-black bg-bina-blue/15">
    <div class="mx-auto max-w-5xl px-5 py-14">
      <h2 class="mb-3 text-3xl sm:text-4xl">Families who made this exact decision</h2>
      <p class="mb-8 max-w-2xl text-coal-900">
        Copied word for word, nothing trimmed. There are
        {' '}{reviewData.reviews.length - reviews.length} more on
        {' '}<a href="/reviews" class="font-bold underline">our reviews page</a>, including the platforms
        where we do not control what gets published.
      </p>
      <div class="grid gap-4 md:grid-cols-3">
        {
          reviews.map((r) => (
            <figure class="card-bina flex h-full flex-col p-6">
              <blockquote class="grow whitespace-pre-line text-sm text-coal-1000">{r.body}</blockquote>
              <figcaption class="mt-4 border-t-2 border-coal-black/10 pt-3 font-display text-xs font-bold text-coal-900">
                {r.roleLabel} · {sourceLabel[r.source]}
                {reviewDate(r.date) ? ` · ${reviewDate(r.date)}` : ''}
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <!-- questions parents actually ask -->
  <section class="border-t-2 border-coal-black">
    <div class="mx-auto max-w-4xl px-5 py-14">
      <h2 class="mb-8 text-3xl sm:text-4xl">The questions everyone asks on the first call</h2>
      <div class="divide-y-2 divide-coal-black/10">
        {
          faq.map((f) => (
            <details class="group py-4">
              <summary class="cursor-pointer list-none font-display text-lg font-bold marker:hidden">
                <span class="inline-flex items-start gap-3">
                  <span class="mt-1 font-black text-bina-pink transition-transform group-open:rotate-90">›</span>
                  {f.q}
                </span>
              </summary>
              <p class="mt-3 pl-7 text-coal-1000">{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- close -->
  <section class="border-t-2 border-coal-black bg-coal-black text-white">
    <div class="mx-auto max-w-4xl px-5 py-16 text-center">
      <h2 class="mb-4 text-3xl text-white sm:text-4xl">
        One call tells you whether this works for your family
      </h2>
      <p class="mx-auto mb-8 max-w-2xl text-white/80">
        We will put your {copy.state} numbers next to bina's, in writing, and you can decide with the
        whole picture in front of you. No obligation, and no pretending the funding is simpler than it is.
      </p>
      <a href={CTA} class="btn-bina text-lg">{CTA_LABEL}</a>
      <p class="mt-6 text-sm text-white/60">
        Prefer email? <a href="mailto:admissions@thebinaschool.com" class="font-bold text-bina-grass underline">admissions@thebinaschool.com</a>
      </p>
    </div>
  </section>

  <!-- where every number came from -->
  <section class="border-t-2 border-coal-black">
    <div class="mx-auto max-w-4xl px-5 py-12">
      <h2 class="mb-4 font-display text-xl">Where these numbers come from</h2>
      <ul class="grid gap-2 text-sm text-coal-900">
        <li>
          <strong>{copy.state} program details</strong> — the bina team's ESA database, current as of
          this page's last update. {copy.state} sets the rules and can change them;
          <a href={program.officialUrl} rel="noopener" class="underline"> the official program site</a> is the final word.
        </li>
        <li>
          <strong>Tuition</strong> — published on
          <a href={school.tuitionUrl} class="underline"> thebinaschool.com/tuition</a>. The monthly figure
          on this page is simple arithmetic: yearly tuition minus the base award, divided by 12, before
          sibling discounts. Awards for children with special needs are higher in several states.
        </li>
        <li>
          <strong>{survey.headline.recommendAvg} out of 10</strong> — our own family survey,
          {' '}{survey.surveyA.n} families, {survey.surveyA.responseRatePct}% response rate. Families who
          answer a survey are more positive than those who do not; every score, including our weakest, is
          on <a href="/family-survey" class="underline">the survey page</a>.
        </li>
        <li>
          <strong>+{results.headline.readGrowthAvg} reading points</strong> — STAR assessments,
          Oct '25 to May '26, the {results.headline.pairedN} students assessed at both points at the same
          level. Aggregates only, on <a href="/student-results" class="underline">the results page</a>.
        </li>
        <li>
          <strong>Reviews</strong> — copied verbatim from Niche, where we cannot edit or remove anything.
          The full set is on <a href="/reviews" class="underline">our reviews page</a>.
        </li>
      </ul>
    </div>
  </section>

  <p slot="footer-note" class="mx-auto max-w-2xl text-xs text-white/60">
    {program.prog} is run by the state of {copy.state}, not by bina. Program amounts, eligibility and
    deadlines are subject to change — always confirm with
    <a href={program.officialUrl} rel="noopener" class="underline">the official program site</a> before
    you rely on a number here.
  </p>
</BaseLayout>
