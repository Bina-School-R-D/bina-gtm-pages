---
import BaseLayout from '../layouts/BaseLayout.astro';
import survey from '../data/family-survey.json';

const {
  surveyA,
  surveyB,
  headline,
  npsBenchmark,
  fit,
  dimensions,
  involvement,
  wishlist,
  exams,
  examNotes,
  future,
  asyncWork,
} = survey;

const SITE = 'https://thebinaschool.com';

/*
  This page is built for three readers at once:
   - Scanners read the hero, the four tile headings and the section H2s only. Every one of
     those is written as a complete claim that stands alone, so a scanner leaves with
     sentences rather than orphaned numbers, and never feels they missed the point.
   - Focused readers get 2–3 lines under each H2. Nothing essential sits below that.
   - Detail readers get the <details> expanders, figure captions, the methodology section
     and the outbound sources. Everything there must be exactly right.
*/

// ---- dimension bars: honest full 0–10 axis, no truncation ----
const DW = 640;
const DROW = 44;
const DLABEL = 250;
const DH = dimensions.length * DROW + 26;
const dBars = dimensions.map((d, i) => ({
  ...d,
  y: i * DROW + 4,
  w: (d.score / 10) * (DW - DLABEL - 58),
}));

// ---- involvement bars: share of parents, 0–100 axis ----
const IW = 640;
const IROW = 40;
const ILABEL = 262;
const IH = involvement.length * IROW + 8;
const iBars = involvement.map((v, i) => ({
  ...v,
  y: i * IROW + 4,
  w: (v.pct / 100) * (IW - ILABEL - 52),
}));

// ---- "what matters for my child's future" — stacked single bar, sums to 100 ----
const FW = 640;
let fAcc = 0;
const fSegs = future.map((f) => {
  const x = (fAcc / 100) * FW;
  fAcc += f.pct;
  return { ...f, x, w: (f.pct / 100) * FW };
});

// Scanner layer: each tile heading is a claim that makes sense with nothing else read.
const tiles = [
  {
    value: headline.recommendAvg,
    decimals: 2,
    claim: 'Parents would send their friends here',
    note: "average answer to “would you recommend bina to another family”, out of 10",
  },
  {
    value: headline.heard,
    decimals: 2,
    claim: 'Parents feel heard, not handed a login',
    note: 'our highest-scoring area of the seven we asked about, out of 10',
  },
  {
    value: headline.joy,
    decimals: 2,
    claim: 'Children are happy to log on',
    note: "how families rate their child’s experience for joy, out of 10",
  },
  {
    value: headline.satisfaction,
    decimals: 2,
    claim: 'Families are satisfied, all in',
    note: 'overall satisfaction with bina, out of 10',
  },
];

const explainers = [
  {
    q: 'Who did you ask, and when?',
    a: `We invited every bina family. ${surveyA.n} answered — a ${surveyA.responseRatePct}% response rate, which is high for a school survey. A separate survey of our middle-school parents drew ${surveyB.n} responses. The two are never mixed together on this page: every figure says which survey it came from.`,
    accent: 'bg-bina-grass',
  },
  {
    q: 'What is a Net Promoter Score?',
    a: `It comes from one question: how likely are you to recommend us? It takes the share of enthusiastic families and subtracts the share of unhappy ones, so it runs from −100 to +100. On the widely used cross-industry scale, ${npsBenchmark.excellentFrom}–${npsBenchmark.worldClassFrom} is excellent and ${npsBenchmark.worldClassFrom}+ is world class. bina scores ${headline.nps}, and very few of our families fall into the unhappy group at all.`,
    accent: 'bg-bina-yellow',
  },
  {
    q: 'Is 80 actually good for a school, though?',
    a: `Fairly, yes — but here's the caveat we'd rather give you ourselves. Independent School Management, who have benchmarked ${npsBenchmark.parentResponses.toLocaleString('en-US')} parent responses across ${npsBenchmark.schools} private schools and more than ${npsBenchmark.students.toLocaleString('en-US')} students in grades ${npsBenchmark.studentGrades}, argue that schools need their own grade-by-grade ranges rather than one universal pass mark. So read 80 as a strong signal, not a league position, and check their research yourself.`,
    accent: 'bg-bina-blue',
  },
  {
    q: 'What should I be sceptical about?',
    a: 'Families who answer surveys tend to be the more engaged ones, so read these scores knowing that. These are averages across a whole school — no single family is average, and your experience would be your own. Every figure here is a school-wide aggregate; no individual family or child appears anywhere on this page.',
    accent: 'bg-bina-purple',
  },
];
---

<BaseLayout
  title="What bina Families Say — Our Family Survey Results"
  description={`bina families rate us ${headline.recommendAvg} out of 10 on whether they'd recommend us. We published all seven of our scores, including the one we're worst at.`}
  flushFooter={true}
>
  <!-- hero: the quality claim, in three seconds -->
  <header class="bg-bina-grass">
    <div class="mx-auto max-w-5xl px-5 py-16 sm:py-20">
      <p class="pill-bina mb-6 text-sm tracking-wide">
        family survey · {surveyA.n} families · every score published
      </p>
      <h1 class="mb-5 max-w-3xl text-4xl font-black sm:text-6xl">
        bina families rate us
        <span class="underline decoration-bina-yellow decoration-8 underline-offset-4"
          >{headline.recommendAvg} out of 10</span
        >
        on whether they'd recommend us
      </h1>
      <p class="mb-8 max-w-2xl text-lg text-coal-1000 sm:text-xl">
        We asked every family what they really think, then published all of it — the scores we're
        proud of and the one we're not. Here's the whole thing.
      </p>
      <div class="inline-flex flex-wrap items-center gap-4 rounded-2xl border-2 border-coal-black bg-white px-5 py-4">
        <span class="font-display text-4xl font-black">{headline.nps}</span>
        <span class="font-display font-bold leading-tight">
          Net Promoter Score<br />
          <span class="text-sm font-medium text-coal-900"
            >{npsBenchmark.worldClassFrom}+ is considered world class</span
          >
        </span>
      </div>
    </div>
  </header>

  <!-- scanner layer: four claims that stand alone -->
  <section class="border-t-2 border-coal-black">
    <div class="mx-auto max-w-5xl px-5 py-14">
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          tiles.map((t) => (
            <div class="card-bina stat-tile p-6">
              <p class="font-display text-5xl font-black text-coal-black">
                <span data-count={t.value} data-decimals={t.decimals}>
                  0
                </span>
              </p>
              <p class="mt-2 font-display text-lg font-bold leading-snug">{t.claim}</p>
              <p class="mt-2 text-sm text-coal-900">{t.note}</p>
            </div>
          ))
        }
      </div>
      <p class="mt-4 text-sm text-coal-900">
        Whole-school family survey — {surveyA.n} families, a {surveyA.responseRatePct}% response
        rate.
      </p>
    </div>
  </section>

  <!-- full scorecard: the honesty proof -->
  <section class="border-t-2 border-coal-black bg-bina-purple/15">
    <div class="mx-auto max-w-5xl px-5 py-14">
      <h2 class="mb-3 text-3xl sm:text-4xl">
        Here is every score we asked about, including the one we're worst at
      </h2>
      <p class="mb-8 max-w-2xl text-coal-900">
        Seven areas, each rated out of 10 by families already here. The bars run the full width of the
        scale, so nothing is flattered by a cropped axis, and our weakest score sits in the same chart
        as our best.
      </p>

      <figure class="card-bina p-6 sm:p-8">
        <svg
          viewBox={`0 0 ${DW} ${DH}`}
          role="img"
          aria-label={`Family ratings out of 10: ${dimensions.map((d) => `${d.label} ${d.score}`).join('; ')}`}
          class="w-full"
        >
          {
            dBars.map((d) => (
              <g class="dim-bar">
                <text x="0" y={d.y + DROW / 2 - 6} class="chart-label-sm">
                  {d.label}
                </text>
                <rect
                  x={DLABEL}
                  y={d.y + 4}
                  width={DW - DLABEL - 58}
                  height={DROW - 20}
                  rx="6"
                  fill="#000"
                  fill-opacity="0.06"
                />
                <rect
                  class="dim-fill"
                  x={DLABEL}
                  y={d.y + 4}
                  width={d.w}
                  height={DROW - 20}
                  rx="6"
                  fill={d.color}
                  stroke="#000"
                  stroke-width="2"
                />
                <text x={DW - 50} y={d.y + DROW / 2 - 5} class="chart-label">
                  {d.score}
                </text>
              </g>
            ))
          }
          <line
            x1={DLABEL}
            y1={dimensions.length * DROW + 2}
            x2={DW - 58}
            y2={dimensions.length * DROW + 2}
            stroke="#000"
            stroke-width="2"
          />
          <text x={DLABEL} y={DH - 4} class="chart-label-sm">0</text>
          <text x={DW - 58} y={DH - 4} text-anchor="end" class="chart-label-sm">10</text>
        </svg>
        <figcaption class="mt-4 text-sm text-coal-900">
          Whole-school family survey, {surveyA.n} families. "Would recommend bina" is the average
          answer to the recommendation question; the {headline.nps} Net Promoter Score is calculated
          from that same question.
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- the two scores we'd stake it on -->
  <section class="border-t-2 border-coal-black">
    <div class="mx-auto max-w-5xl px-5 py-14">
      <h2 class="mb-3 text-3xl sm:text-4xl">The two scores we'd stake the school on</h2>
      <p class="mb-8 max-w-2xl text-coal-900">
        One is about you, one is about your child. They're the two things families rate us highest on,
        and they're the two we'd most want you to test on a call.
      </p>

      <div class="grid gap-4 md:grid-cols-2">
        <div class="card-bina bg-bina-grass/40 p-8">
          <p class="font-display text-6xl font-black">{headline.heard}</p>
          <p class="mt-3 font-display text-xl font-bold">You won't be handed a login and left</p>
          <p class="mt-3 text-coal-900">
            The honest fear about online school is that nobody will know your child's name. Of the
            seven things we asked about, communication and feeling heard is the one families score
            <strong class="text-coal-black">highest of all</strong> — above the learning, above
            satisfaction overall.
          </p>
        </div>
        <div class="card-bina bg-bina-yellow/40 p-8">
          <p class="font-display text-6xl font-black">{headline.joy}</p>
          <p class="mt-3 font-display text-xl font-bold">Your child will want to log on</p>
          <p class="mt-3 text-coal-900">
            When we looked at what actually makes a family recommend us, joy beat everything —
            including how academically strong they think we are. Parents don't tell their friends
            about a curriculum. They tell them their kid is <strong class="text-coal-black"
              >happy</strong
            >.
          </p>
        </div>
      </div>

      <details class="card-bina group mt-4 overflow-hidden p-0">
        <summary class="flex cursor-pointer items-center gap-3 p-5 font-display font-bold">
          <span class="h-8 w-2 flex-none rounded-full border-2 border-coal-black bg-bina-pink"></span>
          <span class="flex-1">And what do bina parents say matters most for their child's future?</span>
          <span
            class="flex-none font-display text-xl transition-transform duration-200 group-open:rotate-45"
            aria-hidden="true">+</span
          >
        </summary>
        <div class="border-t-2 border-coal-black/10 p-5">
          <p class="mb-4 text-sm text-coal-900">
            Asked to pick the single thing that matters most, families split like this — and nearly 7
            in 10 chose something other than academic foundations.
          </p>
          <svg
            viewBox={`0 0 ${FW} 44`}
            role="img"
            aria-label={future.map((f) => `${f.label} ${f.pct}%`).join('; ')}
            class="w-full"
          >
            {
              fSegs.map((f) => (
                <rect
                  x={f.x}
                  y="0"
                  width={f.w}
                  height="40"
                  fill={f.color}
                  stroke="#000"
                  stroke-width="2"
                />
              ))
            }
          </svg>
          <ul class="mt-4 grid gap-2 sm:grid-cols-2">
            {
              future.map((f) => (
                <li class="flex items-center gap-2 text-sm">
                  <span
                    class="h-3.5 w-3.5 flex-none rounded-full border-2 border-coal-black"
                    style={`background:${f.color}`}
                  />
                  <span class="font-display font-bold">{f.pct}%</span>
                  <span class="text-coal-900">{f.label}</span>
                </li>
              ))
            }
          </ul>
          <p class="mt-4 text-sm text-coal-900">
            Whole-school family survey, {surveyA.n} families, one choice each.
          </p>
        </div>
      </details>
    </div>
  </section>

  <!-- projection: families like yours -->
  <section class="border-t-2 border-coal-black bg-bina-blue/15">
    <div class="mx-auto max-w-5xl px-5 py-14">
      <h2 class="mb-3 text-3xl sm:text-4xl">You wouldn't be the odd one out here</h2>
      <div class="grid gap-8 lg:grid-cols-[auto_1fr] lg:items-center">
        <div>
          <p class="font-display text-7xl font-black leading-none text-coal-black sm:text-8xl">
            <span data-count={fit.roundedPct} class="stat-tile-inline">0</span>%
          </p>
          <p class="mt-2 max-w-xs text-xs text-coal-900">
            {fit.exactPct}% — {fit.informalPct}% said "some differences, nothing formal" and {
              fit.formalPct
            }% said their child needs support beyond standard education.
          </p>
        </div>
        <div>
          <p class="mb-4 text-lg text-coal-900">
            of bina families say their child doesn't always learn the way a standard classroom
            expects. Most arrive here having already tried to make a room of thirty desks work for a
            child it was never built for.
          </p>
          <p class="text-lg text-coal-900">
            That's the part worth holding onto: these are the families rating us <strong
              class="text-coal-black">{headline.satisfaction} out of 10</strong
            >. Not families for whom school was always easy — families who'd run out of other options
            first.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- projection: your week -->
  <section class="border-t-2 border-coal-black">
    <div class="mx-auto max-w-5xl px-5 py-14">
      <h2 class="mb-3 text-3xl sm:text-4xl">Your week as a bina parent</h2>
      <p class="mb-8 max-w-3xl text-coal-900">
        Every parent's real question is "does online school mean I have to teach?" Here's what our
        parents actually do, so you can picture your own week. <strong class="text-coal-black"
          >{involvement[0].pct}% check their child's progress every week</strong
        > — because they can, any day they like, where a traditional school gives you a report card twice
        a year. But only {involvement[6].pct}% sit in on lessons. You'd be coaching, not teaching.
      </p>

      <div class="mb-6 grid gap-4 sm:grid-cols-3">
        <div class="card-bina p-6">
          <p class="font-display text-4xl font-black">{involvement[2].pct}%</p>
          <p class="mt-2 font-display font-bold">talk to their child about learning every day</p>
          <p class="mt-2 text-sm text-coal-900">
            The conversation over dinner, not the lesson plan.
          </p>
        </div>
        <div class="card-bina p-6">
          <p class="font-display text-4xl font-black">{asyncWork.underFourHoursPct}%</p>
          <p class="mt-2 font-display font-bold">want four hours of homework a week or less</p>
          <p class="mt-2 text-sm text-coal-900">
            The commonest answer was {asyncWork.commonest} — involved, but not buried.
          </p>
        </div>
        <div class="card-bina p-6">
          <p class="font-display text-4xl font-black">{involvement[7].pct}%</p>
          <p class="mt-2 font-display font-bold">would stay hands-off</p>
          <p class="mt-2 text-sm text-coal-900">
            Which tells you about the families your child would learn alongside. Almost everyone here
            is paying attention.
          </p>
        </div>
      </div>

      <details class="card-bina group overflow-hidden p-0">
        <summary class="flex cursor-pointer items-center gap-3 p-5 font-display font-bold">
          <span class="h-8 w-2 flex-none rounded-full border-2 border-coal-black bg-bina-blue"></span>
          <span class="flex-1">See how every parent answered</span>
          <span
            class="flex-none font-display text-xl transition-transform duration-200 group-open:rotate-45"
            aria-hidden="true">+</span
          >
        </summary>
        <figure class="border-t-2 border-coal-black/10 p-5">
          <figcaption class="mb-4 font-display font-bold">
            "How do you picture your involvement in your child's education?"
          </figcaption>
          <svg
            viewBox={`0 0 ${IW} ${IH}`}
            role="img"
            aria-label={involvement.map((v) => `${v.label} ${v.pct}%`).join('; ')}
            class="w-full"
          >
            {
              iBars.map((v) => (
                <g class="dim-bar">
                  <text x="0" y={v.y + IROW / 2 - 4} class="chart-label-sm">
                    {v.label}
                  </text>
                  <rect
                    class="dim-fill"
                    x={ILABEL}
                    y={v.y + 2}
                    width={v.w}
                    height={IROW - 18}
                    rx="6"
                    fill="#33afff"
                    stroke="#000"
                    stroke-width="2"
                  />
                  <text x={v.w + ILABEL + 8} y={v.y + IROW / 2 - 3} class="chart-label">
                    {v.pct}%
                  </text>
                </g>
              ))
            }
          </svg>
          <figcaption class="mt-4 text-sm text-coal-900">
            Middle-school parent survey, {surveyB.n} responses. Parents could pick more than one, so
            these don't add up to 100%.
          </figcaption>
        </figure>
      </details>
    </div>
  </section>

  <!-- the honest gap -->
  <section class="border-t-2 border-coal-black bg-coal-black">
    <div class="mx-auto max-w-5xl px-5 py-16">
      <h2 class="mb-6 text-3xl text-white sm:text-4xl">
        Our lowest score is <span class="text-bina-yellow">{dimensions[6].score}</span> — a sense of
        belonging
      </h2>
      <div class="grid gap-8 lg:grid-cols-2">
        <div>
          <p class="mb-4 text-white/80">
            It's the weakest number in the survey, and honestly, we're not surprised. A school with no
            school gate is a hard place to build a community: no pickup line to stand in, no coffee
            after assembly, no other parent you end up talking to every Tuesday.
          </p>
          <p class="mb-4 text-white/80">
            It's the one thing a building gives you for free and the one thing we have to actually
            design. {dimensions[6].score} out of 10 says we're not finished.
          </p>
          <p class="text-white/80">
            So we asked families what they wanted rather than guessing — and that list is now what
            we're building. We'd rather show you this number than have you find it in your second
            term.
          </p>
        </div>
        <div>
          <p class="mb-4 font-display font-bold text-white">What families asked us for next</p>
          <ul class="space-y-3">
            {
              wishlist.map((w) => (
                <li class="flex items-baseline gap-4 border-b border-white/15 pb-3">
                  <span class="font-display text-2xl font-black text-bina-grass">{w.pct}%</span>
                  <span class="text-white/80">{w.label}</span>
                </li>
              ))
            }
          </ul>
          <p class="mt-4 text-sm text-white/60">
            Middle-school parent survey, {surveyB.n} responses, open-ended — these are themes
            families raised unprompted, not options we offered. 27% left it blank.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- pathways -->
  <section class="border-t-2 border-coal-black">
    <div class="mx-auto max-w-5xl px-5 py-14">
      <h2 class="mb-3 text-3xl sm:text-4xl">One school, and no single track out of it</h2>
      <p class="mb-8 max-w-3xl text-coal-900">
        We asked which exams parents want their child prepared for, and the answers came back from all
        over the world at once — SATs and APs alongside GCSEs, the IB and A-Levels. If you're moving
        countries, or simply don't know yet where your child will finish school, that mix is the
        point. {examNotes.unsurePct}% told us it's too early to say, and we think that's a perfectly
        good answer.
      </p>

      <div class="card-bina overflow-x-auto p-6 sm:p-8">
        <table class="w-full min-w-[26rem] text-left">
          <thead>
            <tr class="border-b-2 border-coal-black font-display">
              <th class="py-2 pr-4">Exam</th>
              <th class="py-2 pr-4">Where it's used</th>
              <th class="py-2">Families who named it</th>
            </tr>
          </thead>
          <tbody>
            {
              exams.map((e) => (
                <tr class="border-b border-coal-black/15">
                  <td class="py-2 pr-4 font-display font-bold">{e.label}</td>
                  <td class="py-2 pr-4 text-sm text-coal-900">{e.region}</td>
                  <td class="py-2 font-display font-bold">{e.pct}%</td>
                </tr>
              ))
            }
          </tbody>
        </table>
        <p class="mt-4 text-sm text-coal-900">
          Middle-school parent survey, {surveyB.n} responses. {examNotes.note} A further {
            examNotes.anyPct
          }% said "whatever opens the most doors" and {examNotes.nonePct}% would rather we didn't
          focus on standardised tests at all.
        </p>
      </div>
    </div>
  </section>

  <!-- methodology: the detail layer -->
  <section class="border-t-2 border-coal-black bg-bina-yellow/20">
    <div class="mx-auto max-w-5xl px-5 py-14">
      <h2 class="mb-3 text-3xl sm:text-4xl">Where these numbers came from</h2>
      <p class="mb-8 max-w-2xl text-coal-900">
        This is our own survey of our own families, so you should know exactly how it was run before
        deciding what it's worth.
      </p>
      <div class="grid gap-3 sm:grid-cols-2">
        {
          explainers.map((e) => (
            <details class="card-bina group overflow-hidden p-0">
              <summary class="flex cursor-pointer items-center gap-3 p-5 font-display font-bold">
                <span class={`h-8 w-2 flex-none rounded-full border-2 border-coal-black ${e.accent}`} />
                <span class="flex-1">{e.q}</span>
                <span
                  class="flex-none font-display text-xl transition-transform duration-200 group-open:rotate-45"
                  aria-hidden="true"
                >
                  +
                </span>
              </summary>
              <p class="border-t-2 border-coal-black/10 px-5 pb-5 pt-4 text-sm text-coal-900">{e.a}</p>
            </details>
          ))
        }
      </div>
      <p class="mt-8 max-w-2xl text-coal-900">
        Want the harder numbers instead — how much our students actually learn, marked by someone
        other than us?
        <a href="/student-results" class="font-bold underline underline-offset-4"
          >See our independently measured student results</a
        >.
      </p>
    </div>
  </section>

  <!-- CTA -->
  <section class="border-t-2 border-coal-black bg-coal-black">
    <div class="mx-auto max-w-4xl px-5 py-16 text-center">
      <h2 class="mb-4 text-3xl text-white sm:text-4xl">
        Come and be one of the families we ask <span class="text-bina-grass">next year</span>
      </h2>
      <p class="mx-auto mb-8 max-w-xl text-white/80">
        See how bina teaches, meet the team, and find out whether we're right for your child — all on
        our main site.
      </p>
      <div class="flex justify-center">
        <a href={SITE} class="btn-bina text-lg">Visit bina</a>
      </div>
    </div>
  </section>

  <p slot="footer-note" class="text-xs text-white/60">
    Figures come from bina's own family surveys — a whole-school survey of {surveyA.n} families ({
      surveyA.responseRatePct
    }% response rate) and a separate middle-school parent survey of {surveyB.n} responses. The two are
    reported separately throughout and never combined. All figures are school-wide aggregates; no
    individual family or student data is shown. Survey respondents are self-selecting and tend to be
    more engaged than average, and individual experiences vary. Net Promoter Score bands and the
    school benchmarking cited above come from {npsBenchmark.source} — verify them at
    <a href={npsBenchmark.sourceUrl} rel="noopener" class="underline">isminc.com</a>. NPS® is a
    registered trademark of Bain &amp; Company, Fred Reichheld and Satmetrix Systems.
  </p>

  <style>
    .chart-label {
      font-family: 'Rund Display', Arial, sans-serif;
      font-weight: 700;
      font-size: 17px;
      fill: #000;
    }
    .chart-label-sm {
      font-family: 'Rund Text', Arial, sans-serif;
      font-size: 13px;
      fill: #313131;
    }
    .dim-fill {
      transform-origin: left center;
      transition: opacity 0.2s ease-out;
    }
    .dim-bar:hover .dim-fill {
      opacity: 0.75;
    }
    /* bars grow from the left when scrolled into view */
    figure .dim-fill {
      transform: scaleX(0);
      transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
    }
    figure.in .dim-fill {
      transform: scaleX(1);
    }
    /* charts inside a collapsed <details> never fire the observer, so show them at once */
    details .dim-fill {
      transform: scaleX(1);
    }
    @media (prefers-reduced-motion: reduce) {
      figure .dim-fill {
        transform: scaleX(1);
        transition: none;
      }
    }
  </style>

  <script>
    // ---- count-up stat tiles (supports decimal scores like 9.42) ----
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const runCount = (el: HTMLElement) => {
      const target = Number(el.dataset.count);
      const decimals = Number(el.dataset.decimals ?? 0);
      const show = (v: number) => (el.textContent = v.toFixed(decimals));
      if (reduceMotion) {
        show(target);
        return;
      }
      const start = performance.now();
      const dur = 1100;
      const tick = (now: number) => {
        const t = Math.min(1, (now - start) / dur);
        show(target * (1 - Math.pow(1 - t, 3)));
        if (t < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };

    const animated = document.querySelectorAll<HTMLElement>('.stat-tile, .stat-tile-inline, figure');

    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (!e.isIntersecting) return;
            io.unobserve(e.target);
            e.target.classList.add('in');
            if (e.target.matches('[data-count]')) {
              runCount(e.target as HTMLElement);
            }
            e.target.querySelectorAll<HTMLElement>('[data-count]').forEach(runCount);
          });
        },
        { threshold: 0.3 }
      );
      animated.forEach((el) => io.observe(el));
    } else {
      animated.forEach((el) => el.classList.add('in'));
      document.querySelectorAll<HTMLElement>('[data-count]').forEach(runCount);
    }
  </script>
</BaseLayout>
