---
import BaseLayout from '../layouts/BaseLayout.astro';
import PillLabel from '../components/sections/pill_label.astro';
import UiAccordion from '../components/sections/ui_accordion.astro';
import LayoutStatSection from '../components/sections/layout_stat_section.astro';
import ChartDonut from '../components/sections/chart_donut.astro';
import ChartBarList from '../components/sections/chart_bar_list.astro';
import ChartSegmentedBar from '../components/sections/chart_segmented_bar.astro';
import ChartTable from '../components/sections/chart_table.astro';
import CardText from '../components/sections/card_text.astro';
import UiLink from '../components/sections/ui_link.astro';
import survey from '../data/family-survey.json';

const {
  surveyA,
  surveyB,
  headline,
  npsBenchmark,
  fit,
  dimensions,
  involvement,
  wishlist,
  exams,
  examNotes,
  future,
} = survey;

const SITE = 'https://thebinaschool.com';

/*
  Narrative order — each section answers the question the previous one raises:
    hero (what families think) -> what they say (recommendation)
    -> how it feels (all seven scores) -> who's here (the 70%)
    -> what matters to them (priorities + involvement) -> where we excel (top two)
    -> the one area not there yet (+ plan) -> what comes after bina -> methodology -> CTA

  Three readers at once (CLAUDE.md audience rule): scanners get the hero and the H2s,
  which are complete claims on their own; focused readers get 2-3 lines under each;
  detail readers get the methodology expanders, captions and sources. Sample size,
  response rate and survey scope appear only in the methodology section and the footer.
*/


const explainers = [
  {
    question: 'Who did you ask, and when?',
    answer: `We invited every bina family — the whole school. ${surveyA.n} answered, a ${surveyA.responseRatePct}% response rate, which is high for a school survey. A separate survey of our middle-school parents drew ${surveyB.n} responses. The two are never mixed together on this page: every figure says which survey it came from.`,
  },
  {
    question: 'What is that Net Promoter Score of 80?',
    answer: `It's the standard way of scoring the "would you recommend us" question. Answers of 9–10 count as promoters, 7–8 as passives, 0–6 as detractors, and the score is the share of promoters minus the share of detractors — so it can run anywhere from −100 to +100. bina's is ${headline.nps}.`,
  },
  {
    question: 'Is 80 a good score for a school?',
    answer: `Yes — on the scale built for school parents specifically. Independent School Management benchmarked ${npsBenchmark.parentResponses.toLocaleString('en-US')} parent responses across ${npsBenchmark.schools} private schools and set the parent ranges: below 15 critical, 15–39 needs improvement, 40–54 good, 55–69 great, ${npsBenchmark.worldClassFrom} and above excellent. They also found each group needs its own ranges — students rate everything lower as they get older — which is why we quote the parent figures and not a general business benchmark. Their research is linked in the footer.`,
  },
  {
    question: 'What should I be sceptical about?',
    answer: 'Families who answer surveys tend to be the more engaged ones, so read these scores knowing that. These are averages across a whole school — no single family is average, and your experience would be your own. Every figure here is a school-wide aggregate; no individual family or child appears anywhere on this page.',
  },
];
---

<BaseLayout
  title="What bina Families Think About bina — Our Family Survey"
  description="Once a year we ask every bina family what they really think. Here is all of it — every score, including the one we're still working on."
  flushFooter={true}
  decorationSet="deco_leaves"
>
  <!-- hero: sets the contract, no numbers -->
  <header class="bg-dark-bg">
    <div class="relative z-[1] mx-auto max-w-6xl px-8 py-[clamp(3rem,6vw,6rem)]">
      <PillLabel text="family survey" accentColor="pink" class="mb-6" />
      <h1 class="mb-5 max-w-3xl text-hero text-bina-pink">
        What bina families think about
        bina
      </h1>
      <p class="max-w-2xl text-body-2 text-bina-pink">
        Every year we ask every family what they really think — how their child is doing, how we're
        doing, and what we should fix. Then we publish all of it, including the one score we're not
        happy with yet. If you're weighing us up, this is the most honest thing we can hand you.
      </p>
    </div>
  </header>

  <!-- what they say about us -->
  <LayoutStatSection heading="How many parents recommend bina to others?" accentColor="green">
    <div class="card_base bg-coal-black grid gap-10 p-6 sm:p-8 lg:grid-cols-[auto_1fr] lg:items-center">
      <ChartDonut
        value={headline.recommendAvg}
        max={10}
        unit="out of 10"
        fillColor="#03cb5b"
        cardFill="dark"
        accentColor="green"
        ariaLabel={`bina families rate us ${headline.recommendAvg} out of 10 on whether they would recommend bina`}
      />
      <div>
        <p class="mb-4 text-body-2 text-bina-green">
          We asked every family the simplest question there is: would you recommend bina to another
          family? Answering from 0 to 10, the average came out at
          <strong>{headline.recommendAvg}</strong>. More than eight in ten
          families gave us a 9 or a 10, and hardly anyone answered low.
        </p>
        <p class="text-body-2 text-bina-green">
          That works out to a Net Promoter Score of {headline.nps} — the standard measure schools use
          for this question.
        </p>
      </div>
    </div>
  </LayoutStatSection>

  <!-- how it feels to be here -->
  <LayoutStatSection heading="And this is how it feels to be here — all seven scores above 8 out of 10" accentColor="purple">
    <figure class="card_base bg-coal-black p-6 sm:p-8">
      <p class="mb-8 max-w-2xl text-body-2 text-bina-purple">
        A recommendation is the easy part to quote, so here's the harder part. We ask families to rate
        seven separate things out of 10, and we publish every one of them. Each score below is the
        average of all their answers.
      </p>
      <ChartBarList
        items={dimensions.map((d) => ({ label: d.label, value: d.score }))}
        max={10}
        unit="/10"
        fillColor="#b38cff"
        cardFill="dark"
        accentColor="purple"
        referenceLine={{ value: 8, label: '8/10' }}
        ariaLabel={`Family ratings out of 10, all above 8: ${dimensions.map((d) => `${d.label} ${d.score}`).join('; ')}`}
      />
    </figure>
  </LayoutStatSection>

  <!-- who's here -->
  <LayoutStatSection heading="You wouldn't be the odd one out here" accentColor="blue">
    <div class="card_base bg-bina-blue grid gap-8 p-6 sm:p-8 lg:grid-cols-[auto_1fr] lg:items-center">
      <div class="text-center">
        <ChartDonut variant="number" value={fit.roundedPct} unit="%" countUp class="text-coal-black" />
      </div>
      <div>
        <p class="mb-4 text-body-2 text-coal-black">
          of bina families say their child doesn't always learn the way a standard classroom
          expects. Most came from the same place you might be in now: a bright kid, and a classroom
          that didn't quite fit.
        </p>
        <p class="text-body-2 text-coal-black">
          Here, that's the norm — and these are the families giving the scores above.
        </p>
      </div>
    </div>
  </LayoutStatSection>

  <!-- what matters to them -->
  <LayoutStatSection heading="The families here want what you want for your kid" accentColor="orange">
    <figure class="card_base bg-coal-black p-6 sm:p-8">
      <p class="mb-8 max-w-2xl text-body-2 text-bina-orange">
        Asked to pick the single thing that matters most for their child's future, bina parents split
        four ways. Whichever one is yours, you'll find plenty of parents here who chose the same.
      </p>
      <ChartSegmentedBar segments={future} caption="One choice per family." cardFill="dark" accentColor="orange" />
    </figure>
  </LayoutStatSection>

  <!-- how involved they are -->
  <LayoutStatSection heading="How involved are bina parents?" accentColor="pink" introClass="max-w-3xl">
    <Fragment slot="intro">
      All sorts, and it changes week to week. Some families follow every lesson; others are holding
      down a job, a house and three other things, and check in when there's a moment. bina is built
      to work either way.
    </Fragment>
      <div class="grid gap-4 md:grid-cols-2">
        <CardText title="Want to see everything?" accentColor="pink">
          You'll be in good company. <strong
            >{involvement[0].pct}% of bina parents look at their child's progress every week</strong
          >, and {involvement[2].pct}% talk about learning every day. Lessons, work and progress are
          all there to see, any day you like — not twice a year in a report card.
        </CardText>
        <CardText title="Not every week? That's alright." accentColor="pink">
          Some weeks there simply isn't a spare hour, and your child is looked after exactly the
          same. Teaching is our job, not yours — only <strong
            >{involvement[6].pct}% of parents ever sit in on a lesson</strong
          >. Whenever you do get a moment, everything is waiting for you, and nothing was missed
          while you were busy.
        </CardText>
      </div>
  </LayoutStatSection>

  <!-- where we excel -->
  <LayoutStatSection heading="Our two strongest scores are the two that carry the rest" accentColor="red" introClass="max-w-3xl">
    <Fragment slot="intro">
      Confidence, creativity, real learning — none of it arrives in a child who dreads logging on,
      or in a family who can't get a straight answer from the school. Those two things are exactly
      where bina families score us highest.
    </Fragment>
      <div class="grid gap-4 md:grid-cols-2">
        <CardText title="You'll be heard" score={dimensions[0].score} scoreUnit="/10" accentColor="red">
          The fair worry about any online school is that nobody will really know your child, and
          nobody will pick up when you ask. Communication is the single thing our families rate
          highest of all seven — above the learning, above their overall satisfaction.
        </CardText>
        <CardText title="Your child will want to log on" score={dimensions[1].score} scoreUnit="/10" accentColor="red">
          Joy is the one families rate second highest, and it's the one that makes everything else
          possible. A child who's happy at school learns more than one who's enduring it — and
          parents tell their friends about a happy kid, not a curriculum.
        </CardText>
      </div>
  </LayoutStatSection>

  <!-- the one area not there yet -->
  <LayoutStatSection heading="One score isn't where we want it yet — and here's the 12-month plan" accentColor="grass">
      <div class="grid gap-8 lg:grid-cols-2">
        <div>
          <p class="mb-4 text-body-2 text-bina-grass">
            A sense of belonging scores <strong>{dimensions[6].score}/10</strong> —
            above 8, like everything else, and still the one we're working hardest on. A school
            without a school gate doesn't get community for free: there's no pickup line, no coffee
            after assembly. It has to be built on purpose.
          </p>
          <p class="mb-4 text-body-2 text-bina-grass">
            So rather than guess, we asked families what they wanted next and made their answers the
            plan.
          </p>
          <p class="text-body-2 text-bina-grass">
            The target: <strong
              >every one of our seven scores above 9 out of 10 within the next 12 months</strong
            >.
          </p>
        </div>
        <div class="card_base bg-bina-grass p-6">
          <p class="mb-4 font-display text-body-2 font-bold text-coal-black">
            The plan, ranked by what families asked for
          </p>
          <ul class="space-y-3">
            {
              wishlist.map((w) => (
                <li class="flex items-baseline gap-4 border-b border-coal-black/15 pb-3 text-body-2">
                  <span class="font-display text-body-1 font-black text-coal-black">{w.pct}%</span>
                  <span class="text-coal-black">{w.label}</span>
                </li>
              ))
            }
          </ul>
          <p class="mt-4 text-body-3 text-coal-black">
            Middle-school parent survey, {surveyB.n} responses, open-ended — themes families raised
            unprompted, not options we offered. 27% left it blank.
          </p>
        </div>
      </div>
  </LayoutStatSection>

  <!-- what comes after bina -->
  <LayoutStatSection heading="Whatever comes after bina, the door stays open" accentColor="blue">
      <div class="card_base bg-bina-blue overflow-x-auto p-6 sm:p-8">
        <p class="mb-8 max-w-3xl text-body-2 text-coal-black">
          bina families are preparing their kids for every major route — the SAT and AP track in the US,
          GCSEs and A-Levels in the UK, the IB, and regional programmes. If one of those is your plan,
          you'd be far from the only family here on that path. And {examNotes.unsurePct}% say it's too
          early to decide, which we think is a perfectly good answer.
        </p>
        <ChartTable
          columns={['Exam', "Where it's used", 'Families preparing for it']}
          rows={exams.map((e) => [e.label, e.region, `${e.pct}%`])}
        />
        <p class="mt-4 text-body-3 text-coal-black">
          Middle-school parent survey, {surveyB.n} responses. {examNotes.note} A further {
            examNotes.anyPct
          }% said "whatever opens the most doors" and {examNotes.nonePct}% would rather we didn't
          focus on standardised tests at all.
        </p>
      </div>
  </LayoutStatSection>

  <!-- methodology: the detail layer -->
  <LayoutStatSection id="methodology" heading="Where these numbers came from" accentColor="purple">
    <Fragment slot="intro">
      This is our own survey of our own families, so you should know exactly how it was run before
      deciding what it's worth.
    </Fragment>
      <div class="max-w-3xl">
        <UiAccordion items={explainers} />
      </div>
      <p class="mt-8 max-w-2xl text-body-2 text-bina-purple">
        Want the harder numbers instead — how much our students actually learn, marked by someone
        other than us?
        <UiLink href="/student-results" cardFill="dark" accentColor="purple"
          >See our independently measured student results</UiLink
        >.
      </p>
  </LayoutStatSection>

  <!-- CTA -->
  <section class="bg-dark-bg">
    <div class="relative z-[1] mx-auto max-w-4xl px-5 py-16 text-center">
      <h2 class="mb-4 text-section text-bina-grass">
        Join the world of bina — and give your kid all of this
      </h2>
      <p class="mx-auto mb-8 max-w-xl text-body-2 text-bina-grass">
        See how bina teaches, meet the team, and find out whether we're right for your child — all on
        our main site.
      </p>
      <div class="flex justify-center">
        <a href={SITE} class="ui_button">Visit bina</a>
      </div>
    </div>
  </section>

  <p slot="footer-note" class="text-small text-bina-grass">
    Figures come from bina's own family surveys — a whole-school survey of {surveyA.n} families ({
      surveyA.responseRatePct
    }% response rate) and a separate middle-school parent survey of {surveyB.n} responses. The two
    are reported separately throughout and never combined. All figures are school-wide aggregates; no
    individual family or student data is shown. Survey respondents are self-selecting and tend to be
    more engaged than average, and individual experiences vary. Parent Net Promoter Score ranges come
    from {npsBenchmark.source} — verify them at
    <UiLink href={npsBenchmark.sourceUrl} cardFill="dark" accentColor="grass">isminc.com</UiLink>. NPS® is a
    registered trademark of Bain &amp; Company, Fred Reichheld and Satmetrix Systems.
  </p>

  <style>
    /* page-wide dark background — this page only, not a site-wide toggle */
    :global(body) {
      background: var(--color-dark-bg);
    }
  </style>
</BaseLayout>
